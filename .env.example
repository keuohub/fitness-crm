# 徕舞成长系统 · 环境变量配置

# ===========================================
# 端口
# ===========================================
PORT=3001

# ===========================================
# DeepSeek API (AI 报告生成)
# ===========================================
DEEPSEEK_API_KEY=sk-your-key-here

# ===========================================
# 飞书多维表格同步
# ===========================================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BASE_TOKEN=RnlqbnTcBaGIW0skLLWclgHbnzb
FEISHU_TABLE_ID=tblg1rCqMOOjksj5

# ===========================================
# 管理员密码 (必填)
# ===========================================
# 用于 CRM 后台登录。不设置则无法使用。
ADMIN_PASSWORD=your-strong-password-here

# ===========================================
# 管理员邮箱 (可选)
# ===========================================
# 默认: admin@laiwu.fitness
# ADMIN_EMAIL=admin@laiwu.fitness

# ===========================================
# Cookie 签名密钥 (可选)
# ===========================================
# 默认使用 ADMIN_PASSWORD。
# 生产环境建议单独设置。
# COOKIE_SIGN_KEY=your-random-key-here

# ===========================================
# 腾讯云对象存储 COS（上传的图片永久保存；不配则降级到本地 public/media）
# COS_BUCKET 必须是完整桶名，带 appid 后缀，例如 laiwu-1250000000
# COS_REGION 是桶所在地域，例如 ap-shanghai（必须与实际一致）
# 密钥建议用子账号，仅授权该桶的 PutObject / GetObject
# ===========================================
COS_BUCKET=
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=
# 可选：绑定到桶的 CDN/自定义域名（只填域名，不要带 https://）
COS_CUSTOM_DOMAIN=
