/* components/next-class/next-class.wxss
   下一节课组件 · 粉白渐变主题
   完整模式（「我的账户」hero 下缘）：白玻璃圆角卡 + 绛红点缀
   紧凑模式（约课页顶部）：白条 + 腮粉分隔
   ============================================================ */

.next-class-wrapper {
  width: 100%;
  box-sizing: border-box;
}

/* 骨架屏：腮粉浅底，不再是旧砂色直角块 */
.next-skeleton-box {
  border-radius: 28rpx;
  background-color: #F7ECEA;
}

.next-skeleton-compact {
  height: 72rpx;
  margin: 12rpx 0;
}

.next-skeleton-full {
  height: 200rpx;
  margin-bottom: 24rpx;
}

/* ── 紧凑模式（约课页顶部） ── */
.next-compact-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-bottom: 1px solid rgba(227, 181, 175, 0.25);
  box-sizing: border-box;
}

.compact-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.compact-tag {
  font-size: 22rpx;
  color: #C03438;
  background: #F7ECEA;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.compact-time {
  font-family: var(--font-num);
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.compact-course {
  font-size: 26rpx;
  color: #6B6B6B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.compact-link {
  font-size: 24rpx;
  color: #C03438;
  font-weight: 500;
}

/* ── 完整模式（「我的账户」页顶部）：白玻璃卡，叠住 hero 下缘 ── */
.next-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  padding: 30rpx 34rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(150, 45, 48, 0.10);
  box-sizing: border-box;
}

.nc-main-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.nc-left-col {
  display: flex;
  flex-direction: column;
}

.nc-label {
  font-size: 22rpx;
  color: #B98A87;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.nc-time-main {
  font-family: var(--font-num);
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1A1A1A;
}

.nc-course-line {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #1A1A1A;
}

.nc-course-name {
  font-weight: 500;
}

.nc-coach-name {
  color: #6B6B6B;
}

.nc-right-col {
  flex-shrink: 0;
  text-align: right;
  padding-top: 8rpx;
}

.nc-card-text {
  font-size: 24rpx;
  color: #C03438;
  font-family: var(--font-num);
  font-weight: 600;
}

/* 7天点列：本周 7 点绛红实心/腮粉描边 */
.nc-week-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1px solid rgba(227, 181, 175, 0.28);
}

.nc-day-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.nc-day-name {
  font-size: 22rpx;
  color: #9A9A9A;
  margin-bottom: 8rpx;
}

.nc-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.nc-dot-active {
  background: #C03438;
  border: none;
}

.nc-dot-idle {
  background: transparent;
  border: 2rpx solid #E3B5AF;
}

.nc-today-bar {
  margin-top: 8rpx;
  width: 18rpx;
  height: 3rpx;
  background: transparent;
  border-radius: 2rpx;
}

.nc-today-bar-show {
  background: #C03438;
}

/* 暂无课空状态卡：白玻璃 + 绛红小胶囊 */
.next-empty-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  padding: 30rpx 34rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 30rpx rgba(150, 45, 48, 0.10);
  box-sizing: border-box;
}

.nc-empty-text-wrap {
  display: flex;
  flex-direction: column;
}

.nc-empty-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.nc-empty-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  background: #C03438;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(192, 52, 56, 0.28);
  margin: 0;
}
