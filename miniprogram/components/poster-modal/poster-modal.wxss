/* components/poster-modal/poster-modal.wxss · 体态分享卡组件样式 */

.share-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: rgba(0, 0, 0, 0.75);
}

/* 右上角常驻悬浮关闭按钮 */
.modal-float-close {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 24rpx);
  right: 32rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.4);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100001;
}

.modal-float-close:active {
  background: rgba(0, 0, 0, 0.7);
}

.share-modal-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

.share-modal-container {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 100rpx) 44rpx calc(env(safe-area-inset-bottom) + 90rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-card {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  padding: 48rpx 36rpx 40rpx;
  border-radius: 0;
  background: #ffffff;
  border: 1px solid #ece7df;
  box-shadow: none;
  display: flex;
  flex-direction: column;
}

.poster-brand {
  text-align: center;
  margin-bottom: 24rpx;
}

.poster-brand-en {
  display: block;
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0;
  color: #000000;
}

.poster-brand-cn {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-sans);
  font-size: 20rpx;
  color: #666666;
  letter-spacing: 0;
}

.poster-member-info {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #ece7df;
  margin-bottom: 24rpx;
}

.poster-member-title {
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 600;
  color: #000000;
  letter-spacing: 0;
}

.poster-member-days {
  font-family: var(--font-num);
  font-size: 22rpx;
  font-weight: 600;
  color: #000000;
}

.poster-compare-pair {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.poster-img-box {
  flex: 1;
  position: relative;
  border-radius: 0;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  background: #eeeeee;
}

.poster-img {
  width: 100%;
  height: 100%;
}

.poster-tag {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  background: #000000;
  color: #ffffff;
  font-family: var(--font-sans);
  font-size: 18rpx;
  letter-spacing: 0;
}

.poster-no-photo-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 0;
  background: #F7ECEA;
  border: 1px solid #ece7df;
  text-align: center;
}

.poster-badge-icon {
  font-size: 36rpx;
  color: #000000;
  margin-bottom: 12rpx;
}

.poster-badge-title {
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: 0;
  margin-bottom: 8rpx;
}

.poster-badge-sub {
  font-family: var(--font-sans);
  font-size: 20rpx;
  color: #666666;
  letter-spacing: 0;
}

.poster-analysis-box {
  position: relative;
  background: #F7ECEA;
  border-radius: 0;
  padding: 20rpx 24rpx 20rpx 44rpx;
  margin-bottom: 28rpx;
  border: none;
}

.poster-quote {
  position: absolute;
  top: 10rpx;
  left: 16rpx;
  font-family: var(--font-sans);
  font-size: 32rpx;
  font-weight: 700;
  color: #000000;
}

.poster-analysis {
  font-family: var(--font-sans);
  font-size: 24rpx;
  line-height: 1.6;
  color: #222222;
  font-style: normal;
}

.poster-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #ece7df;
}

.poster-footer-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.poster-sign {
  font-family: var(--font-sans);
  font-size: 22rpx;
  font-weight: 600;
  color: #000000;
}

.poster-slogan {
  font-family: var(--font-sans);
  font-size: 18rpx;
  color: #666666;
  letter-spacing: 0;
}

.poster-stamp {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 1.5rpx dashed #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-12deg);
}

.poster-stamp-inner {
  font-size: 14rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #000000;
  text-align: center;
  letter-spacing: 0;
}

.poster-scroll-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 260rpx);
  width: 100%;
  flex-shrink: 0;
}

.poster-fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 44rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(0, 0, 0, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 100002;
  box-sizing: border-box;
}

.poster-btn-primary {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: #000000;
  color: #ffffff;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.poster-btn-primary:active {
  opacity: 0.85;
}

.poster-bottom-subrow {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.poster-btn-secondary {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: transparent;
  color: #ffffff;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0;
  text-align: center;
  border: 1rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.poster-btn-secondary:active {
  opacity: 0.8;
}

.poster-btn-close-pill {
  padding: 0 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 9999rpx;
  background: transparent;
  color: #ffffff;
  font-size: 24rpx;
  letter-spacing: 0;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-btn-close-pill:active {
  opacity: 0.8;
}

/* 隐藏离屏画布 */
.poster-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1260px;
  z-index: -1;
  pointer-events: none;
}
