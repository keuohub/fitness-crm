/* components/poster-modal/poster-modal.wxss · 画报级体态美学分享卡组件样式 */

.share-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: rgba(8, 7, 10, 0.78);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  animation: fadeIn 0.25s ease both;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 右上角常驻高奢悬浮关闭按钮 */
.modal-float-close {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 24rpx);
  right: 32rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1.5rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100001;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
  transition: transform 140ms ease, background 140ms ease;
}
.modal-float-close:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.4);
}

.share-modal-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

.share-modal-container {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 110rpx) 44rpx calc(env(safe-area-inset-bottom) + 90rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-card {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  padding: 48rpx 36rpx 40rpx;
  border-radius: 36rpx;
  background: #FCF8F5;
  border: 1.5rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.38);
  display: flex;
  flex-direction: column;
}

.poster-brand {
  text-align: center;
  margin-bottom: 24rpx;
}
.poster-brand-en {
  display: block;
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 22rpx;
  letter-spacing: 0.25em;
  color: #120E0F;
}
.poster-brand-cn {
  display: block;
  margin-top: 6rpx;
  font-family: "Songti SC", Georgia, serif;
  font-size: 18rpx;
  color: #8C6A6B;
  letter-spacing: 0.12em;
}

.poster-member-info {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(28, 20, 21, 0.08);
  margin-bottom: 24rpx;
}
.poster-member-title {
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 1rpx;
}
.poster-member-days {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 20rpx;
  color: #8C6A6B;
}

.poster-compare-pair {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.poster-img-box {
  flex: 1;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  background: #EAE3DE;
}
.poster-img {
  width: 100%;
  height: 100%;
}
.poster-tag {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(8, 7, 10, 0.7);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  color: #FFFFFF;
  font-family: "Songti SC", Georgia, serif;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.poster-no-photo-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(234, 226, 220, 0.45) 0%, rgba(245, 237, 232, 0.9) 100%);
  border: 1rpx dashed rgba(186, 36, 40, 0.25);
  text-align: center;
}
.poster-badge-icon {
  font-size: 40rpx;
  color: #BA2428;
  margin-bottom: 12rpx;
}
.poster-badge-title {
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.poster-badge-sub {
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  color: #8C6A6B;
  letter-spacing: 1rpx;
}

.poster-analysis-box {
  position: relative;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 20rpx;
  padding: 20rpx 24rpx 20rpx 44rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(28, 20, 21, 0.04);
}
.poster-quote {
  position: absolute;
  top: 10rpx;
  left: 16rpx;
  font-family: Georgia, serif;
  font-size: 32rpx;
  color: #BA2428;
  opacity: 0.6;
}
.poster-analysis {
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  line-height: 1.6;
  color: #381617;
  font-style: italic;
}

.poster-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(28, 20, 21, 0.08);
}
.poster-footer-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.poster-sign {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 500;
  color: #1C1415;
}
.poster-slogan {
  font-family: "Songti SC", Georgia, serif;
  font-size: 18rpx;
  color: #8C6A6B;
  letter-spacing: 1rpx;
}
.poster-stamp {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 1.5rpx dashed #BA2428;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-12deg);
}
.poster-stamp-inner {
  font-size: 14rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #BA2428;
  text-align: center;
  letter-spacing: 1rpx;
}

.poster-scroll-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 260rpx);
  width: 100%;
  flex-shrink: 0;
}

.poster-fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 44rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: linear-gradient(180deg, rgba(8, 7, 10, 0) 0%, rgba(8, 7, 10, 0.88) 35%, rgba(8, 7, 10, 0.98) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 100002;
  box-sizing: border-box;
}

.poster-btn-primary {
  width: 100% !important;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #BA2428 0%, #8C161A 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 10rpx 32rpx rgba(186, 36, 40, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  transition: transform 140ms ease;
}
.poster-btn-primary:active {
  transform: scale(0.98);
}
.poster-btn-spark {
  font-size: 22rpx;
  margin-right: 8rpx;
  color: inherit;
  display: inline-block;
  vertical-align: middle;
}

.poster-bottom-subrow {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.poster-btn-secondary {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1.5rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  transition: transform 140ms ease;
}
.poster-btn-secondary:active {
  transform: scale(0.98);
}

.poster-btn-close-pill {
  padding: 0 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  letter-spacing: 1.5rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 140ms ease;
}
.poster-btn-close-pill:active {
  transform: scale(0.98);
}

/* 隐藏离屏画布 */
.poster-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1200px;
  z-index: -1;
  pointer-events: none;
}
