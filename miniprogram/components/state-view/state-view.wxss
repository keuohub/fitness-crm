.sv {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 40rpx;
  text-align: center;
}
.sv--compact { padding: 48rpx 24rpx; }
.sv-icon { width: 96rpx; height: 96rpx; margin-bottom: 24rpx; }
.sv-title { font-size: 30rpx; font-weight: 600; color: #111111; line-height: 1.4; }
.sv-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8b90;
  line-height: 1.5;
  max-width: 520rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.sv-btn {
  margin-top: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  min-width: 240rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #000000;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.sv-btn:active { opacity: 0.8; }
.sv--dark .sv-title { color: #ffffff; }
.sv--dark .sv-desc { color: rgba(255, 255, 255, 0.72); }
.sv--dark .sv-btn { background: #ffffff; color: #000000; }

.sv-sk { width: 100%; height: 160rpx; border-radius: 24rpx; background: #efeae2; margin-bottom: 20rpx; animation: svPulse 1.4s ease-in-out infinite; }
.sv-sk-2 { height: 120rpx; }
.sv-sk-3 { height: 120rpx; width: 70%; align-self: flex-start; }
.sv--dark .sv-sk { background: #1f1f1f; }
@keyframes svPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
