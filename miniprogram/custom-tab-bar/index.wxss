/* custom-tab-bar/index.wxss
   悬浮磨砂胶囊底栏（对标 Apple HIG 浮动胶囊 / lululemon 悬浮交互栏）
   圆角 52rpx · 半透暖砂磨砂底 · 选中项曜黑微光圆角药丸
   ============================================================ */

.tab-bar-capsule {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  left: 20rpx;
  right: 20rpx;
  z-index: 999;
  height: 104rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx;
  background: rgba(246, 228, 221, 0.94);
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 53rpx;
  box-shadow: 
    0 18rpx 46rpx -8rpx rgba(130, 22, 25, 0.22),
    0 4rpx 14rpx rgba(0, 0, 0, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
}

.tab-item {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 45rpx;
  transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1), background-color 220ms ease;
  position: relative;
  padding: 0 4rpx;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item-active {
  background: #08070A;
  box-shadow: 
    0 8rpx 24rpx -4rpx rgba(8, 7, 10, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
  animation: tabPillIn 0.26s cubic-bezier(0.2, 0.9, 0.3, 1) both;
}

@keyframes tabPillIn {
  0% {
    transform: scale(0.92);
    opacity: 0.85;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.tab-text {
  font-size: 21rpx;
  font-weight: 500;
  color: #2D2727;
  letter-spacing: 0.01em;
  white-space: nowrap;
  font-family: "Songti SC", -apple-system, "PingFang SC", sans-serif;
  transition: color 200ms ease, font-weight 200ms ease, letter-spacing 200ms ease;
}

.tab-item-active .tab-text {
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 0.05em;
}
