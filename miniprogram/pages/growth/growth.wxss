/* ==========================================================================
   pages/growth/growth.wxss - 徕舞 · 私人身体美学手札 (Editorial Magazine Edition)
   彻底推倒 AI 模板塑料盒子，重塑大牌杂志画报感、纵深呼吸感与女子静奢情调
   ========================================================================== */

/* 全局手札画卷容器 */
.growth-page {
  min-height: 100vh;
  padding-top: calc(env(safe-area-inset-top) + 96rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 260rpx);
  box-sizing: border-box;
  animation: pageTransitIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* 高奢光影呼吸骨架屏 (Luster Shimmer Skeleton) */
.luxury-skeleton {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 60rpx) 36rpx calc(env(safe-area-inset-bottom) + 120rpx);
  box-sizing: border-box;
}
.sk-brand-watermark {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 24rpx;
  letter-spacing: 0.28em;
  color: rgba(186, 36, 40, 0.45);
  text-align: center;
  margin-bottom: 44rpx;
}
.sk-shimmer {
  background: linear-gradient(90deg, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0.78) 50%, rgba(255,255,255,0.35) 100%);
  background-size: 200% 100%;
  animation: skPulse 1.6s infinite ease-in-out;
  border-radius: 12rpx;
}
@keyframes skPulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.sk-header-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}
.sk-badge {
  width: 44rpx;
  height: 24rpx;
}
.sk-title {
  width: 160rpx;
  height: 34rpx;
}
.sk-gallery-hero {
  width: 100%;
  height: 380rpx;
  border-radius: 18rpx;
  margin-bottom: 44rpx;
}
.sk-portraits-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 44rpx;
}
.sk-portrait-card {
  flex: 1;
  height: 240rpx;
  border-radius: 14rpx;
}
.sk-metrics-row {
  display: flex;
  gap: 20rpx;
}
.sk-metric-box {
  flex: 1;
  height: 120rpx;
  border-radius: 14rpx;
}

/* ================= 章节公共排印规范 (The Editorial Standards) ================= */
.editorial-section {
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* 章节头部引子 */
.editorial-header {
  margin-bottom: 28rpx;
}
.editorial-chapter-tag {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 6rpx;
}
.chapter-code {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 20rpx;
  font-weight: 600;
  color: #F7EBE4;
  letter-spacing: 0.12em;
}
.chapter-dot {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.35);
  margin: 0 2rpx;
}
.chapter-label {
  font-size: 19rpx;
  font-weight: 500;
  color: rgba(255, 245, 240, 0.65);
  letter-spacing: 0.15em;
  text-transform: uppercase;
}
.editorial-title {
  display: block;
  font-family: "Songti SC", Georgia, "PingFang SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.05em;
  line-height: 1.25;
}
.editorial-subtitle {
  display: block;
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 18rpx;
  letter-spacing: 0.28em;
  color: rgba(28, 20, 21, 0.42);
  margin-top: 4rpx;
  text-transform: uppercase;
}

/* 极细发丝分隔律动线 (Hairline Rhythm Divider) */
.editorial-hairline {
  height: 1rpx;
  margin: 52rpx 40rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.25) 50%, rgba(255, 255, 255, 0.04) 100%);
}

/* ================= 章节一：光影场馆 · 空间策展 (Chapter 01: The Sanctuary) ================= */
.venue-gallery-scroll {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
  overflow-x: scroll;
  padding: 8rpx 0 16rpx;
}
.venue-gallery-item {
  display: inline-block;
  width: 540rpx;
  height: 338rpx; /* 16:10 电影宽屏构图 */
  margin-right: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(18, 14, 15, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: #2A181A;
  vertical-align: top;
  transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
}
.venue-gallery-item:last-child {
  margin-right: 0;
}
.venue-gallery-item:active {
  transform: scale(0.98);
}
.venue-gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ================= 章节二：同行导师 · 真实陪伴 (Chapter 02: Mentors) ================= */
.team-portrait-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.team-portrait-col {
  display: flex;
  flex-direction: column;
  transition: transform 180ms ease;
}
.team-portrait-col:active {
  transform: scale(0.97);
}
.portrait-frame {
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(28, 20, 21, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: #EAE3DE;
  margin-bottom: 16rpx;
}
.portrait-photo {
  width: 100%;
  height: 100%;
  display: block;
}
.portrait-meta {
  padding: 0 4rpx;
}
.portrait-name {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.05em;
  line-height: 1.3;
}
.portrait-role {
  display: block;
  font-size: 20rpx;
  color: #BA2428;
  font-weight: 500;
  letter-spacing: 0.06em;
  margin-top: 4rpx;
}
.portrait-bio {
  display: block;
  font-size: 19rpx;
  line-height: 1.45;
  color: rgba(28, 20, 21, 0.58);
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ================= 章节三：问候与沉淀岁月 (Chapter 03: Greeting & Bond) ================= */
.greeting-header-row {
  margin-bottom: 36rpx;
}
.greeting-headline-group {
  display: flex;
  flex-direction: column;
}
.greeting-lead {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(28, 20, 21, 0.55);
  letter-spacing: 0.08em;
  margin-bottom: 6rpx;
}
.greeting-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}
.greeting-hero-name {
  font-family: "Songti SC", Georgia, serif;
  font-size: 52rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.03em;
  line-height: 1.2;
}
.stars-chic-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(28, 20, 21, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 4rpx 16rpx rgba(28, 20, 21, 0.2);
  transition: transform 140ms ease;
}
.stars-chic-trigger:active {
  transform: scale(0.94);
}
.stars-chic-spark {
  font-size: 16rpx;
  color: #F7EBE4;
}
.stars-chic-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 1.5rpx;
}

/* 进阶经纬：微米级卡地亚建筑经纬仪刻度 (Minimal Horizon Caliber) */
.caliber-horizon {
  margin-bottom: 44rpx;
  padding: 12rpx 8rpx 20rpx;
}
.caliber-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.caliber-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.caliber-roman-badge {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.16em;
  color: #BA2428;
}
.caliber-dot {
  font-size: 18rpx;
  color: rgba(186, 36, 40, 0.4);
}
.caliber-stage-tag {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.06em;
}
.caliber-metric-num {
  font-family: "Songti SC", Georgia, serif;
  font-size: 21rpx;
  color: rgba(28, 20, 21, 0.55);
}
.caliber-scale-wrap {
  position: relative;
  padding: 8rpx 0 20rpx;
}
.caliber-track-line {
  position: absolute;
  top: 50rpx;
  left: 24rpx;
  right: 24rpx;
  height: 1rpx;
  background: rgba(28, 20, 21, 0.14);
  z-index: 1;
}
.caliber-stages {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
}
.caliber-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.38;
  transition: opacity 220ms ease;
}
.caliber-step.is-reached {
  opacity: 1;
}
.caliber-roman {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 19rpx;
  color: rgba(28, 20, 21, 0.5);
  margin-bottom: 6rpx;
}
.caliber-step.is-reached .caliber-roman {
  color: #BA2428;
  font-weight: 600;
}
.caliber-name {
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #1C1415;
  margin-bottom: 12rpx;
}
.caliber-hairline-pip {
  width: 2rpx;
  height: 14rpx;
  background: rgba(28, 20, 21, 0.25);
  transition: all 220ms ease;
}
.caliber-step.is-reached .caliber-hairline-pip {
  height: 22rpx;
  background: #BA2428;
  box-shadow: 0 0 10rpx rgba(186, 36, 40, 0.45);
}
.caliber-quote-row {
  margin-top: 14rpx;
}
.caliber-quote-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(28, 20, 21, 0.62);
  font-style: italic;
}

/* 身体自律资产：大牌杂志开放式排印尺度 */
.metrics-editorial-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 0 12rpx;
}
.metric-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.metric-num-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.metric-big-num {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1;
  color: #1C1415;
  letter-spacing: -0.02em;
}
.metric-unit {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 19rpx;
  font-weight: 600;
  color: #BA2428;
  letter-spacing: 0.18em;
}
.metric-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
  margin-bottom: 4rpx;
}
.metric-caption {
  font-size: 19rpx;
  color: rgba(28, 20, 21, 0.52);
  letter-spacing: 0.02em;
}
.metric-vertical-divider {
  width: 1rpx;
  height: 72rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(28, 20, 21, 0.18) 50%, transparent 100%);
}

/* ================= 章节四：小桥私语 · 亲笔手札 (Chapter 04: The Whisper) ================= */
.stationery-note-card {
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(186, 36, 40, 0.06);
  position: relative;
}
.stationery-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.stationery-title-wrap {
  display: flex;
  flex-direction: column;
}
.stationery-tag {
  font-size: 19rpx;
  font-weight: 600;
  color: #BA2428;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 6rpx;
}
.stationery-heading {
  font-family: "Songti SC", Georgia, serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
}
.stationery-seal {
  width: 52rpx;
  height: 52rpx;
  border-radius: 8rpx;
  background: rgba(186, 36, 40, 0.88);
  color: #FFFFFF;
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(186, 36, 40, 0.25);
  transform: rotate(-6deg);
}
.stationery-body {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  line-height: 1.8;
  color: #2B2426;
  letter-spacing: 0.04em;
  margin-bottom: 24rpx;
}
.stationery-sign-row {
  display: flex;
  justify-content: flex-end;
}
.stationery-sign {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  font-style: italic;
  color: rgba(28, 20, 21, 0.65);
  letter-spacing: 0.06em;
}

/* ================= 章节五：身形蜕变定格 (Chapter 05: Metamorphosis) ================= */
.editorial-header-split {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.editorial-share-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  transition: transform 140ms ease;
}
.editorial-share-btn:active {
  transform: scale(0.95);
}
.share-btn-spark {
  font-size: 16rpx;
  color: #BA2428;
}
.share-btn-txt {
  font-size: 20rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.08em;
}

/* 占位态 */
.editorial-empty-state {
  padding: 44rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.4);
  border: 1rpx dashed rgba(186, 36, 40, 0.22);
  text-align: center;
}
.editorial-empty-lead {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
  margin-bottom: 8rpx;
}
.editorial-empty-sub {
  display: block;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(28, 20, 21, 0.58);
  margin-bottom: 24rpx;
}
.editorial-poster-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #BA2428 0%, #8C161A 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(186, 36, 40, 0.28);
}
.poster-trigger-spark {
  font-size: 18rpx;
  color: #F7EBE4;
}
.poster-trigger-text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 置顶对比：双联画艺术展签 (Exhibition Diptych Dossier) */
.dossier-frame {
  margin-bottom: 32rpx;
  padding: 24rpx 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 24rpx rgba(28, 20, 21, 0.04);
}
.dossier-curation-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.dossier-label-pair {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.dossier-col {
  display: flex;
  flex-direction: column;
}
.dossier-roman {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.16em;
  color: #1C1415;
}
.dossier-sublabel {
  font-family: "Songti SC", Georgia, serif;
  font-size: 19rpx;
  color: rgba(28, 20, 21, 0.52);
  letter-spacing: 0.04em;
  margin-top: 2rpx;
}
.dossier-divider-dash {
  width: 24rpx;
  height: 1rpx;
  background: rgba(28, 20, 21, 0.2);
}
.dossier-action-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(186, 36, 40, 0.08);
  border: 1rpx solid rgba(186, 36, 40, 0.2);
  transition: transform 140ms ease;
}
.dossier-action-pill:active {
  transform: scale(0.95);
}
.dossier-pill-spark {
  font-size: 16rpx;
  color: #BA2428;
}
.dossier-pill-txt {
  font-size: 19rpx;
  font-weight: 600;
  color: #BA2428;
  letter-spacing: 0.06em;
}
.dossier-diptych {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.dossier-pane {
  position: relative;
  aspect-ratio: 3 / 4;
  border-radius: 14rpx;
  overflow: hidden;
  background: #EAE3DE;
  box-shadow: 0 4rpx 16rpx rgba(28, 20, 21, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.dossier-image {
  width: 100%;
  height: 100%;
  display: block;
}
.dossier-caption {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  right: 12rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #FFFFFF;
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 16rpx;
  letter-spacing: 0.14em;
  text-align: center;
}
.compare-editorial-analysis {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  line-height: 1.65;
  color: rgba(28, 20, 21, 0.72);
  font-style: italic;
  padding: 14rpx 8rpx 0;
  border-top: 1rpx dashed rgba(28, 20, 21, 0.1);
}

/* 极简下划线视角切换 (Minimal Underline Tabs) */
.editorial-angle-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin: 20rpx 0 28rpx;
}
.angle-tab-item {
  position: relative;
  padding: 12rpx 8rpx;
  transition: opacity 140ms ease;
}
.angle-tab-text {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  color: rgba(28, 20, 21, 0.45);
  letter-spacing: 0.08em;
  transition: color 180ms ease;
}
.angle-tab-active .angle-tab-text {
  color: #1C1415;
  font-weight: 600;
}
.angle-tab-underline {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #BA2428;
}

/* ================= 章节六：雕塑印记 · 训练足迹 (Chapter 06: Footprints) ================= */
.practice-timeline {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.practice-entry {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 6rpx 18rpx rgba(186, 36, 40, 0.03);
}
.practice-date-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 110rpx;
}
.practice-date {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
}
.practice-duration {
  font-size: 19rpx;
  color: rgba(28, 20, 21, 0.45);
  margin-top: 2rpx;
}
.practice-body-col {
  flex: 1;
}
.practice-top-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.practice-course-name {
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
}
.practice-cat-tag {
  font-size: 18rpx;
  color: #BA2428;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(186, 36, 40, 0.08);
}
.practice-focus-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.focus-dot {
  font-size: 20rpx;
  color: #BA2428;
}
.focus-text {
  font-size: 21rpx;
  color: rgba(28, 20, 21, 0.65);
}

/* ================= 章节七：双向倾听 · 私享便签 (Chapter 07: Intimate Note) ================= */
.note-stationery-box {
  padding: 32rpx 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 32rpx rgba(186, 36, 40, 0.05);
}
.note-textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(28, 20, 21, 0.12);
  font-family: "Songti SC", Georgia, serif;
  font-size: 25rpx;
  line-height: 1.65;
  color: #1C1415;
  margin-bottom: 22rpx;
}
.note-textarea-placeholder {
  font-family: "Songti SC", Georgia, serif;
  font-size: 23rpx;
  color: rgba(28, 20, 21, 0.45);
}
.note-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.note-privacy-hint {
  font-family: "Songti SC", Georgia, serif;
  font-size: 21rpx;
  color: rgba(28, 20, 21, 0.72);
  line-height: 1.5;
  flex: 1;
}

/* 发给小桥 按钮状态 · 彻底告别发灰模糊，字字清晰高质感 */
.btn-note-submit {
  height: 68rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  box-sizing: border-box;
}
.btn-note-submit:active {
  transform: scale(0.96);
}

/* 激活态：深邃曜黑底配典雅象牙微光字，字字清晰可见 */
.btn-note-submit.btn-note-active {
  background: #1C1415;
  border: 1.5rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 6rpx 20rpx rgba(28, 20, 21, 0.28);
}
.btn-note-submit.btn-note-active .btn-note-txt {
  color: #FFFFFF;
  font-weight: 600;
}

/* 待输入态：浅白温润质感底，深色字体清晰高对比，绝不模糊发暗 */
.btn-note-submit.btn-note-idle {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(28, 20, 21, 0.18);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.btn-note-submit.btn-note-idle .btn-note-txt {
  color: rgba(28, 20, 21, 0.65);
  font-weight: 500;
}

.btn-note-txt {
  font-family: "Songti SC", Georgia, serif;
  font-size: 23rpx;
  letter-spacing: 0.06em;
  transition: color 160ms ease;
}
.note-reply-box {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(28, 20, 21, 0.12);
}
/* 提交后的回执：不是回音，只是一张"我收到了"的凭条 */
.note-receipt {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-left: 3rpx solid rgba(28, 20, 21, 0.18);
  background: rgba(28, 20, 21, 0.025);
  border-radius: 0 8rpx 8rpx 0;
}
.note-receipt-txt {
  font-size: 23rpx;
  line-height: 1.85;
  color: rgba(28, 20, 21, 0.56);
  letter-spacing: 0.2rpx;
}
.note-reply-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.note-reply-tag {
  font-family: "Songti SC", Georgia, serif;
  font-size: 21rpx;
  font-weight: 600;
  color: #BA2428;
}
.note-reply-date {
  font-size: 18rpx;
  color: rgba(28, 20, 21, 0.45);
}
.note-reply-content {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(28, 20, 21, 0.85);
}



/* ================= 极简高奢开屏海报 ================= */
.splash-screen {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background-color: #CE3834;
  background-image:
    radial-gradient(circle at 85% 12%, rgba(255, 248, 242, 0.78) 0%, transparent 50%),
    linear-gradient(168deg, #F5E5D9 0%, #E58572 30%, #D4423C 62%, #BA2428 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: env(safe-area-inset-top) 48rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  transition: opacity 550ms cubic-bezier(0.16, 1, 0.3, 1), transform 550ms cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  touch-action: none;
}

.splash-fade-out {
  opacity: 0;
  transform: scale(1.05);
  pointer-events: none;
}

.splash-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transform: translateY(-20rpx);
}

/* 奢侈品高定感品牌拼音：置于「到徕舞」上方 */
.splash-brand-luxury {
  font-family: "Didot", "Bodoni MT", Georgia, "Times New Roman", serif;
  font-size: 46rpx;
  font-weight: 400;
  color: #FFFFFF;
  letter-spacing: 0.40em;
  margin-right: -0.40em;
  line-height: 1;
  text-shadow: 0 4rpx 20rpx rgba(140, 20, 20, 0.18);
}

/* 品牌标下方的极细微光隔线 */
.splash-brand-line {
  width: 48rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.65);
  margin: 28rpx 0 44rpx;
}

/* 到徕舞 */
.splash-sub {
  font-size: 60rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.16em;
  margin-right: -0.16em;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 24rpx rgba(140, 20, 20, 0.2);
}

/* 一起 / 好状态 */
.splash-main {
  font-size: 136rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.08;
  letter-spacing: 0.08em;
  margin-right: -0.08em;
  text-shadow: 0 8rpx 32rpx rgba(140, 20, 20, 0.25);
}

/* 即刻开启胶囊按钮 */
.splash-cta {
  margin-top: 96rpx;
  width: 310rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: rgba(82, 22, 20, 0.68);
  border: 1.5rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
  padding-left: 0.14em;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 12rpx 32rpx rgba(90, 15, 15, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), background-color 180ms;
}

.splash-cta:active {
  transform: scale(0.95);
  background: rgba(60, 14, 12, 0.85);
}

/* ================= 头部右侧：月度之星胶囊入口 ================= */
.stars-open-pill {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(28, 20, 21, 0.92) 0%, rgba(56, 22, 23, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 4rpx 16rpx rgba(186, 36, 40, 0.22);
  transition: transform 140ms ease, box-shadow 140ms ease;
  flex-shrink: 0;
}
.stars-open-pill:active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 8rpx rgba(186, 36, 40, 0.35);
}
.stars-spark {
  font-size: 18rpx;
  color: #F7EBE4;
}
.stars-pill-txt {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1.5rpx;
}

/* ================= 开屏「✦ 徕舞 · 月度之星 ✦」沉浸式全屏大片 (1:1 对标 Lululemon 经典画幅) ================= */
.stars-lulu-container {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999999;
  background: #000000;
  overflow: hidden;
  transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1), transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
}
.stars-lulu-container.lulu-visible {
  opacity: 1;
  transform: scale(1);
}
.stars-lulu-container.lulu-closing {
  opacity: 0;
  transform: scale(1.03);
  pointer-events: none;
}

/* 顶部常驻悬浮栏：左上角 LAIWU 品牌标 */
.stars-lulu-top-nav {
  position: fixed;
  top: 104rpx;
  left: 0;
  right: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  z-index: 1000002;
  box-sizing: border-box;
  pointer-events: none;
}

/* 左上角大牌排印：LAIWU */
.stars-lulu-brand {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Didot", "Bodoni MT", Georgia, sans-serif;
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 0.18em;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.7);
  pointer-events: auto;
}

/* 右上角独立高奢毛玻璃关闭/跳过胶囊（避让胶囊与刘海，置于胶囊正下方，一眼即见） */
.stars-lulu-close-pill {
  position: fixed;
  top: 180rpx;
  right: 32rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.4);
  transition: transform 140ms ease, background 140ms ease;
  z-index: 1000003;
  pointer-events: auto;
}
.stars-lulu-close-pill:active {
  transform: scale(0.92);
  background: rgba(0, 0, 0, 0.7);
}
.stars-lulu-close-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}
.stars-lulu-close-x {
  font-size: 24rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.9);
}

/* Lululemon 级全屏沉浸画报横滑 Swiper (铺满 100vw × 100vh) */
.stars-lulu-swiper {
  width: 100vw;
  height: 100vh;
}
.stars-lulu-item {
  width: 100vw;
  height: 100vh;
}
.stars-lulu-slide {
  position: relative;
  width: 100%;
  height: 100%;
}
.stars-lulu-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 顶部与底部柔和电影级暗角微光，保护白字与按钮极致辨识度 */
.stars-lulu-top-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.18) 55%, transparent 100%);
  pointer-events: none;
}
.stars-lulu-bottom-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 480rpx;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.35) 45%, transparent 100%);
  pointer-events: none;
}

/* 下半部核心信息区：白字「徕舞月度之星 —— 名字」，绝无“立即选购” */
.stars-lulu-content-box {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom) + 220rpx);
  left: 0;
  right: 0;
  padding: 0 44rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  pointer-events: none;
}

.stars-lulu-headline {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 44rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 2.5rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.65);
  line-height: 1.35;
}

.stars-lulu-quote {
  font-family: Georgia, -apple-system, "Songti SC", serif;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 14rpx;
  font-style: italic;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.7);
  max-width: 580rpx;
  line-height: 1.5;
}

/* Lululemon 同款经典细条分页指示器 (细胶囊当前页 + 微透圆点) */
.stars-lulu-pagination {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom) + 170rpx);
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 10;
  pointer-events: none;
}
.lulu-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  transition: all 260ms cubic-bezier(0.2, 0.8, 0.25, 1);
}
.lulu-dot.lulu-dot-active {
  width: 44rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #FFFFFF;
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.7);
}

/* 底部毛玻璃操作栏：与小程序原生磨砂质感深度呼应，一触即入 */
.stars-lulu-bottom-bar {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom) + 50rpx);
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 44rpx;
  z-index: 1000003;
  box-sizing: border-box;
  pointer-events: auto;
}

.stars-lulu-frosted-pill {
  width: 100%;
  max-width: 620rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  transition: transform 140ms ease, background 140ms ease;
}
.stars-lulu-frosted-pill:active {
  transform: scale(0.97);
  background: rgba(255, 255, 255, 0.36);
}
.stars-lulu-spark {
  font-size: 20rpx;
  color: #F7EBE4;
}
.stars-lulu-enter-txt {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}
.stars-lulu-enter-arrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 4rpx;
}
