  height: 92rpx;
  border-radius: 46rpx;
  background: rgba(82, 22, 20, 0.68);
  border: 1.5rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
  padding-left: 0.14em;
