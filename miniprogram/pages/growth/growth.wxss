  -webkit-backdrop-filter: blur(20px);
  animation: fadeIn 0.25s ease both;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 右上角常驻高奢悬浮关闭按钮 */
.modal-float-close {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 24rpx);
  right: 32rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1.5rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100001;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
  transition: transform 140ms ease, background 140ms ease;
}
.modal-float-close:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.4);
}

/* 纵向滚动容器：无论文字多长都可以上下丝滑滑动 */
