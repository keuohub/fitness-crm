.g-page { min-height: 100vh; background: #F6E6DA; padding: 32rpx 32rpx 80rpx; color: #1C1415; }
.g-hero { margin-bottom: 24rpx; }
.g-kicker { display: block; font-size: 20rpx; letter-spacing: 4rpx; color: #8B5E3C; }
.g-title { display: block; font-size: 44rpx; margin-top: 8rpx; }
.g-stats { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.g-stat { flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx 12rpx; text-align: center; }
.g-num { display: block; font-size: 40rpx; font-weight: 600; }
.g-label { display: block; font-size: 20rpx; color: #8C827B; margin-top: 6rpx; }
.g-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.g-card-title { display: block; font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.g-muted { font-size: 24rpx; color: #8C827B; line-height: 1.6; }
.g-error { color: #8A1F17; font-size: 26rpx; }
.g-bars { display: flex; align-items: flex-end; gap: 12rpx; height: 180rpx; }
.g-bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.g-bar { width: 100%; background: #5E1914; border-radius: 8rpx 8rpx 0 0; }
.g-bar-label { font-size: 18rpx; color: #8C827B; margin-top: 6rpx; }
.g-input { background: #F6E6DA; border-radius: 12rpx; padding: 16rpx; margin-bottom: 12rpx; }
.g-btn { background: #0D0C0F; color: #F6E6DA; border-radius: 12rpx; font-size: 28rpx; margin-bottom: 12rpx; }
.g-btn-ghost { background: #fff; color: #0D0C0F; border: 1rpx solid #D1C7C1; }
.g-row { font-size: 24rpx; padding: 10rpx 0; border-top: 1rpx solid #F1E6DE; }
