/* ==========================================================================
   pages/growth/growth.wxss - 徕舞 · 私人身体美学手札 (Editorial Magazine Edition)
   彻底推倒 AI 模板塑料盒子，重塑大牌杂志画报感、纵深呼吸感与女子静奢情调
   ========================================================================== */

/* 全局手札画卷容器 */
.growth-page {
  min-height: 100vh;
  padding-top: calc(env(safe-area-inset-top) + 96rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 260rpx);
  box-sizing: border-box;
  animation: pageTransitIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* 加载态 */
.loading-view {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 3rpx;
}

/* ================= 章节公共排印规范 (The Editorial Standards) ================= */
.editorial-section {
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* 章节头部引子 */
.editorial-header {
  margin-bottom: 28rpx;
}
.editorial-chapter-tag {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 6rpx;
}
.chapter-code {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 20rpx;
  font-weight: 600;
  color: #FFE5A3;
  letter-spacing: 0.12em;
}
.chapter-dot {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.35);
  margin: 0 2rpx;
}
.chapter-label {
  font-size: 19rpx;
  font-weight: 500;
  color: rgba(255, 245, 240, 0.65);
  letter-spacing: 0.15em;
  text-transform: uppercase;
}
.editorial-title {
  display: block;
  font-family: "Songti SC", Georgia, "PingFang SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.05em;
  line-height: 1.25;
}
.editorial-subtitle {
  display: block;
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 18rpx;
  letter-spacing: 0.28em;
  color: rgba(28, 20, 21, 0.42);
  margin-top: 4rpx;
  text-transform: uppercase;
}

/* 极细发丝分隔律动线 (Hairline Rhythm Divider) */
.editorial-hairline {
  height: 1rpx;
  margin: 52rpx 40rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.25) 50%, rgba(255, 255, 255, 0.04) 100%);
}

/* ================= 章节一：光影场馆 · 空间策展 (Chapter 01: The Sanctuary) ================= */
.venue-gallery-scroll {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
  overflow-x: scroll;
  padding: 8rpx 0 16rpx;
}
.venue-gallery-item {
  display: inline-block;
  width: 540rpx;
  height: 338rpx; /* 16:10 电影宽屏构图 */
  margin-right: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(18, 14, 15, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: #2A181A;
  vertical-align: top;
  transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
}
.venue-gallery-item:last-child {
  margin-right: 0;
}
.venue-gallery-item:active {
  transform: scale(0.98);
}
.venue-gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ================= 章节二：同行导师 · 真实陪伴 (Chapter 02: Mentors) ================= */
.team-portrait-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.team-portrait-col {
  display: flex;
  flex-direction: column;
  transition: transform 180ms ease;
}
.team-portrait-col:active {
  transform: scale(0.97);
}
.portrait-frame {
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(28, 20, 21, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: #EAE3DE;
  margin-bottom: 16rpx;
}
.portrait-photo {
  width: 100%;
  height: 100%;
  display: block;
}
.portrait-meta {
  padding: 0 4rpx;
}
.portrait-name {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.05em;
  line-height: 1.3;
}
.portrait-role {
  display: block;
  font-size: 20rpx;
  color: #BA2428;
  font-weight: 500;
  letter-spacing: 0.06em;
  margin-top: 4rpx;
}
.portrait-bio {
  display: block;
  font-size: 19rpx;
  line-height: 1.45;
  color: rgba(28, 20, 21, 0.58);
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ================= 章节三：问候与沉淀岁月 (Chapter 03: Greeting & Bond) ================= */
.greeting-header-row {
  margin-bottom: 36rpx;
}
.greeting-headline-group {
  display: flex;
  flex-direction: column;
}
.greeting-lead {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(28, 20, 21, 0.55);
  letter-spacing: 0.08em;
  margin-bottom: 6rpx;
}
.greeting-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}
.greeting-hero-name {
  font-family: "Songti SC", Georgia, serif;
  font-size: 52rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.03em;
  line-height: 1.2;
}
.stars-chic-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(28, 20, 21, 0.88);
  border: 1rpx solid rgba(255, 215, 0, 0.45);
  box-shadow: 0 4rpx 16rpx rgba(28, 20, 21, 0.2);
  transition: transform 140ms ease;
}
.stars-chic-trigger:active {
  transform: scale(0.94);
}
.stars-chic-spark {
  font-size: 16rpx;
  color: #FFE5A3;
}
.stars-chic-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #FFF6E5;
  letter-spacing: 1.5rpx;
}

/* 进阶经纬：线性水平刻度，告别粗暴药丸盒子 */
.progression-horizon {
  margin-bottom: 40rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 8rpx 24rpx rgba(186, 36, 40, 0.04);
}
.horizon-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.horizon-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.08em;
}
.horizon-badge {
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  font-weight: 500;
  color: #BA2428;
  letter-spacing: 0.06em;
}
.horizon-track {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
  margin-bottom: 20rpx;
}
.horizon-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.node-bullet {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(28, 20, 21, 0.22);
  border: 2rpx solid transparent;
  transition: all 200ms ease;
}
.node-name {
  font-size: 20rpx;
  color: rgba(28, 20, 21, 0.45);
  letter-spacing: 0.06em;
}
.horizon-node.node-reached .node-bullet {
  background: #BA2428;
  box-shadow: 0 0 10rpx rgba(186, 36, 40, 0.4);
  transform: scale(1.15);
}
.horizon-node.node-reached .node-name {
  color: #1C1415;
  font-weight: 600;
}
.horizon-line {
  flex: 1;
  height: 2rpx;
  background: rgba(28, 20, 21, 0.15);
  margin: 0 10rpx;
  margin-bottom: 28rpx;
}
.horizon-line.line-reached {
  background: #BA2428;
}
.horizon-target-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 21rpx;
  line-height: 1.6;
  color: rgba(28, 20, 21, 0.65);
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(28, 20, 21, 0.12);
}

/* 身体自律资产：大牌杂志开放式排印尺度 */
.metrics-editorial-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 0 12rpx;
}
.metric-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.metric-num-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.metric-big-num {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1;
  color: #1C1415;
  letter-spacing: -0.02em;
}
.metric-unit {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 19rpx;
  font-weight: 600;
  color: #BA2428;
  letter-spacing: 0.18em;
}
.metric-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
  margin-bottom: 4rpx;
}
.metric-caption {
  font-size: 19rpx;
  color: rgba(28, 20, 21, 0.52);
  letter-spacing: 0.02em;
}
.metric-vertical-divider {
  width: 1rpx;
  height: 72rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(28, 20, 21, 0.18) 50%, transparent 100%);
}

/* ================= 章节四：小桥私语 · 亲笔手札 (Chapter 04: The Whisper) ================= */
.stationery-note-card {
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(186, 36, 40, 0.06);
  position: relative;
}
.stationery-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.stationery-title-wrap {
  display: flex;
  flex-direction: column;
}
.stationery-tag {
  font-size: 19rpx;
  font-weight: 600;
  color: #BA2428;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 6rpx;
}
.stationery-heading {
  font-family: "Songti SC", Georgia, serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
}
.stationery-seal {
  width: 52rpx;
  height: 52rpx;
  border-radius: 8rpx;
  background: rgba(186, 36, 40, 0.88);
  color: #FFE5A3;
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(186, 36, 40, 0.25);
  transform: rotate(-6deg);
}
.stationery-body {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  line-height: 1.8;
  color: #2B2426;
  letter-spacing: 0.04em;
  margin-bottom: 24rpx;
}
.stationery-sign-row {
  display: flex;
  justify-content: flex-end;
}
.stationery-sign {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  font-style: italic;
  color: rgba(28, 20, 21, 0.65);
  letter-spacing: 0.06em;
}

/* ================= 章节五：身形蜕变定格 (Chapter 05: Metamorphosis) ================= */
.editorial-header-split {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.editorial-share-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  transition: transform 140ms ease;
}
.editorial-share-btn:active {
  transform: scale(0.95);
}
.share-btn-spark {
  font-size: 16rpx;
  color: #BA2428;
}
.share-btn-txt {
  font-size: 20rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.08em;
}

/* 占位态 */
.editorial-empty-state {
  padding: 44rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.4);
  border: 1rpx dashed rgba(186, 36, 40, 0.22);
  text-align: center;
}
.editorial-empty-lead {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
  margin-bottom: 8rpx;
}
.editorial-empty-sub {
  display: block;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(28, 20, 21, 0.58);
  margin-bottom: 24rpx;
}
.editorial-poster-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #BA2428 0%, #8C161A 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(186, 36, 40, 0.28);
}
.poster-trigger-spark {
  font-size: 18rpx;
  color: #FFE5A3;
}
.poster-trigger-text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 对比画框 */
.editorial-compare-frame {
  margin-bottom: 32rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 28rpx rgba(28, 20, 21, 0.05);
}
.compare-frame-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.compare-labels {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.compare-label-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
}
.compare-label-arrow {
  font-size: 20rpx;
  color: #BA2428;
}
.compare-inline-share {
  font-size: 20rpx;
  color: #BA2428;
  letter-spacing: 0.04em;
}
.compare-diptych {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.diptych-pane {
  position: relative;
  aspect-ratio: 3 / 4;
  border-radius: 18rpx;
  overflow: hidden;
  background: #EAE3DE;
  box-shadow: 0 6rpx 18rpx rgba(28, 20, 21, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.diptych-img {
  width: 100%;
  height: 100%;
  display: block;
}
.diptych-caption {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  right: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #FFFFFF;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  text-align: center;
}
.compare-editorial-analysis {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 23rpx;
  line-height: 1.65;
  color: rgba(28, 20, 21, 0.75);
  font-style: italic;
  padding: 12rpx 8rpx 0;
  border-top: 1rpx dashed rgba(28, 20, 21, 0.1);
}

/* 极简下划线视角切换 (Minimal Underline Tabs) */
.editorial-angle-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin: 20rpx 0 28rpx;
}
.angle-tab-item {
  position: relative;
  padding: 12rpx 8rpx;
  transition: opacity 140ms ease;
}
.angle-tab-text {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 24rpx;
  color: rgba(28, 20, 21, 0.45);
  letter-spacing: 0.08em;
  transition: color 180ms ease;
}
.angle-tab-active .angle-tab-text {
  color: #1C1415;
  font-weight: 600;
}
.angle-tab-underline {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #BA2428;
}

/* ================= 章节六：雕塑印记 · 训练足迹 (Chapter 06: Footprints) ================= */
.practice-timeline {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.practice-entry {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 6rpx 18rpx rgba(186, 36, 40, 0.03);
}
.practice-date-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 110rpx;
}
.practice-date {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
}
.practice-duration {
  font-size: 19rpx;
  color: rgba(28, 20, 21, 0.45);
  margin-top: 2rpx;
}
.practice-body-col {
  flex: 1;
}
.practice-top-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.practice-course-name {
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
}
.practice-cat-tag {
  font-size: 18rpx;
  color: #BA2428;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(186, 36, 40, 0.08);
}
.practice-focus-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.focus-dot {
  font-size: 20rpx;
  color: #BA2428;
}
.focus-text {
  font-size: 21rpx;
  color: rgba(28, 20, 21, 0.65);
}

/* ================= 章节七：双向倾听 · 私享便签 (Chapter 07: Intimate Note) ================= */
.note-stationery-box {
  padding: 32rpx 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 32rpx rgba(186, 36, 40, 0.05);
}
.note-tags-flow {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.note-tag-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(28, 20, 21, 0.65);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(28, 20, 21, 0.08);
  transition: all 140ms ease;
}
.note-tag-chip.note-tag-active {
  background: #1C1415;
  color: #FFE5A3;
  border-color: #1C1415;
}
.note-textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(28, 20, 21, 0.08);
  font-size: 25rpx;
  line-height: 1.6;
  color: #1C1415;
  margin-bottom: 20rpx;
}
.note-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.note-privacy-hint {
  font-size: 19rpx;
  color: rgba(28, 20, 21, 0.45);
  line-height: 1.4;
  flex: 1;
}
.btn-note-submit {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #BA2428 0%, #8C161A 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 14rpx rgba(186, 36, 40, 0.28);
  border: none;
  flex-shrink: 0;
  margin: 0 !important;
  transition: transform 140ms ease;
}
.btn-note-submit:active {
  transform: scale(0.95);
}
.btn-note-submit[disabled] {
  opacity: 0.45;
}
.note-reply-box {
  margin-top: 24rpx;
