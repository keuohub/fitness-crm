  font-weight: 400;
  color: #FFFFFF;
  letter-spacing: 0.40em;
  margin-right: -0.40em;
  line-height: 1;
  text-shadow: 0 4rpx 20rpx rgba(140, 20, 20, 0.18);
}

/* 品牌标下方的极细微光隔线 */
