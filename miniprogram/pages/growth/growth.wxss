  align-items: center;
  gap: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.4);
  transition: transform 140ms ease, background 140ms ease;
  z-index: 1000003;
  pointer-events: auto;
}
.stars-lulu-close-pill:active {
  transform: scale(0.92);
  background: rgba(0, 0, 0, 0.7);
}
.stars-lulu-close-text {
  font-size: 24rpx;
  font-weight: 500;
