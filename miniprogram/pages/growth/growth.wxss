  letter-spacing: 1.5rpx;
}

/* ================= 开屏「✦ 徕舞 · 月度之星 ✦」沉浸式全屏大片 (1:1 对标 Lululemon 经典画幅) ================= */
.stars-lulu-container {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999999;
  background: #000000;
  overflow: hidden;
  transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1), transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
}
.stars-lulu-container.lulu-visible {
  opacity: 1;
  transform: scale(1);
}
.stars-lulu-container.lulu-closing {
  opacity: 0;
  transform: scale(1.03);
  pointer-events: none;
}

/* 顶部常驻悬浮栏：左上角 LAIWU 品牌标 */
.stars-lulu-top-nav {
  position: fixed;
  top: 104rpx;
  left: 0;
  right: 0;
