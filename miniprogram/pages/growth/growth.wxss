/* 顶部与底部柔和电影级暗角微光，保护白字与按钮极致辨识度 */
.stars-lulu-top-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.18) 55%, transparent 100%);
