/* pages/growth/growth.wxss - 成长首页 · 朱红流光 + 磨砂微光卡片体系 */

.growth-page {
  min-height: 100vh;
  padding-top: calc(env(safe-area-inset-top) + 124rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 300rpx);
  box-sizing: border-box;
  animation: pageTransitIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* ================= 加载态 ================= */
.loading-view {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

/* ================= 通用板块 ================= */
.section-block {
  margin: 0 32rpx 32rpx;
}
.section-title {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #381617;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin: 40rpx 0 20rpx 12rpx;
  text-shadow: 0 1rpx 12rpx rgba(255, 245, 240, 0.45);
}


/* ================= 模块一：问候区（严格避让右上角微信胶囊，对标 lululemon 高奢呼吸感排印） ================= */
.greeting-area {
  padding: 12rpx 220rpx 32rpx 36rpx;
  box-sizing: border-box;
}
.greeting-top-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}
.greeting-salute {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Songti SC", serif;
  font-size: 46rpx;
  font-weight: 500;
  color: #1C1415;
  line-height: 1.25;
}
.greeting-name {
  font-family: Georgia, "Songti SC", -apple-system, BlinkMacSystemFont, "PingFang SC", serif;
  font-size: 52rpx;
  font-weight: 600;
  color: #1C1415;
  line-height: 1.25;
  letter-spacing: 0.03em;
  word-break: break-all;
}
.greeting-companion-lockup {
  margin-top: 18rpx;
  display: inline-flex;
  align-items: center;
  max-width: 100%;
}
.companion-tier-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 14rpx rgba(186, 36, 40, 0.06);
  flex-shrink: 0;
  transition: transform 140ms ease;
}
.companion-tier-pill:active {
  transform: scale(0.96);
}
.companion-spark {
  font-size: 16rpx;
  color: var(--brand-crimson);
}
.companion-tier-title {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.06em;
}
.companion-tier-pill.tier-pill-gold {
  background: linear-gradient(135deg, rgba(28, 20, 21, 0.92) 0%, rgba(68, 24, 26, 0.92) 100%) !important;
  border: 1rpx solid rgba(255, 215, 0, 0.45) !important;
  box-shadow: 0 4rpx 16rpx rgba(60, 20, 20, 0.35) !important;
}
.companion-tier-pill.tier-pill-gold .companion-spark,
.companion-tier-pill.tier-pill-gold .companion-tier-title {
  color: #FFE5A3 !important;
}
.companion-divider {
  width: 2rpx;
  height: 24rpx;
  background: rgba(28, 20, 21, 0.18);
  margin: 0 18rpx;
  flex-shrink: 0;
}
.companion-days-box {
  display: inline-flex;
  align-items: baseline;
  gap: 4rpx;
  flex-shrink: 0;
}
.companion-days-label {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(28, 20, 21, 0.65);
  letter-spacing: 0.04em;
}
.companion-days-number {
  font-family: "Didot", "Bodoni MT", "Times New Roman", -apple-system, "PingFang SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #120E0F;
  line-height: 1;
  font-variant-numeric: lining-nums tabular-nums;
  letter-spacing: 0.02em;
  margin: 0 2rpx;
}
.companion-days-unit {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
  font-weight: 500;
  color: rgba(28, 20, 21, 0.65);
}

/* ================= 统一磨砂微光卡片 ================= */
.coach-message-card,
.milestone-card,
.whisper-card,
.feedback-card,
.photo-compare-card,
.reply-card,
.training-item {
  background: var(--card-glass);
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  border-radius: 36rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow);
  box-sizing: border-box;
}

/* ================= 小桥的最新鼓励 ================= */
.coach-message-card {
  margin: 0 32rpx 32rpx;
  padding: 36rpx 32rpx;
}
.coach-message-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.coach-message-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text-body);
}
.coach-message-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.coach-tag-item {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(186, 36, 40, 0.08);
  border: 1rpx solid rgba(186, 36, 40, 0.12);
  color: var(--brand-crimson);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  transition: transform 140ms ease;
}
.coach-tag-item:active {
  transform: scale(0.95);
}
.coach-message-date {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ================= 模块二：里程碑成就 ================= */
.milestone-card {
  margin: 0 32rpx 32rpx;
  padding: 36rpx 32rpx;
}
.milestone-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title-inline {
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #381617;
  letter-spacing: 0.14em;
}
.milestone-level-badge {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--brand-crimson);
  background: rgba(186, 36, 40, 0.08);
  border: 1rpx solid rgba(186, 36, 40, 0.16);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
/* 高定水平进阶轨：细轨 + 节点，已达成实心、未达成半透香槟银 */
.milestone-tags {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0 0;
}
.milestone-tag {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 32rpx 0 0;
  font-family: Georgia, "Songti SC", serif;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  transition: color 0.25s ease;
}
/* 轨道线：每节点各画左右两半，首尾各收一半 */
.milestone-tag::before {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(196, 182, 164, 0.5);
}
.milestone-tag:first-child::before {
  left: 50%;
}
.milestone-tag:last-child::before {
  right: 50%;
}
/* 节点圆点 */
.milestone-tag::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  margin-left: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: rgba(196, 182, 164, 0.55);
}
.tag-achieved {
  color: #120E0F;
  font-weight: 600;
}
.tag-achieved::before {
  background: rgba(18, 14, 15, 0.35);
}
.tag-achieved::after {
  background: #120E0F;
  box-shadow: 0 0 0 4rpx rgba(18, 14, 15, 0.12);
}
.tag-locked {
  color: rgba(196, 182, 164, 0.9);
}
.next-goal {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(28, 20, 21, 0.06);
}
.next-goal-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
.next-goal-value {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(28, 22, 23, 0.55);
  line-height: 1.6;
}

/* ================= 模块三：核心自律资产双拼大卡 ================= */
.stats-grid-dual {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 0 32rpx 32rpx;
  box-sizing: border-box;
}
.stat-card-dual {
  padding: 36rpx 28rpx;
  border-radius: 36rpx;
  background: var(--card-glass);
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  border: var(--card-border);
  box-shadow: var(--card-shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  transition: transform 140ms cubic-bezier(0.2, 0.8, 0.25, 1);
}
.stat-card-dual:active {
  transform: scale(0.97);
}
.stat-number-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
}
.stat-card-dual .stat-number {
  font-family: "Didot", "Bodoni MT", "Times New Roman", "PingFang SC", serif;
  font-size: 64rpx;
  font-weight: 600;
  color: #120E0F;
  line-height: 1;
  font-variant-numeric: lining-nums tabular-nums;
}
.stat-card-dual .stat-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #5A3A3A;
  margin-left: 2rpx;
}
.stat-card-dual .stat-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(28, 20, 21, 0.65);
  letter-spacing: 1.5rpx;
}
.stat-card-dual .stat-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 0.5rpx;
}

/* ================= 模块四：训练寄语 ================= */
.whisper-card {
  display: flex;
  gap: 24rpx;
  margin: 0 32rpx 32rpx;
  padding: 36rpx 32rpx 36rpx 34rpx;
}
.whisper-bar {
  width: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #E5534C 0%, #BA2428 100%);
  box-shadow: 0 0 10rpx rgba(206, 56, 52, 0.35);
  flex-shrink: 0;
}
.whisper-content {
  flex: 1;
}
.whisper-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.whisper-title {
  display: block;
  font-family: "Songti SC", Georgia, -apple-system, BlinkMacSystemFont, "PingFang SC", serif;
  font-size: 32rpx;
  font-weight: 600;
  font-style: normal;
  color: #1C1213;
  letter-spacing: 0.04em;
  line-height: 1.45;
}
.whisper-body {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: rgba(28, 20, 21, 0.72);
}
.whisper-sign {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 1rpx;
}

/* ================= 模块五：最近训练 ================= */
.training-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.training-card-luxury {
  background: var(--card-glass);
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  border-radius: 32rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow);
  padding: 30rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  transition: transform 140ms cubic-bezier(0.2, 0.8, 0.25, 1);
}
.training-card-luxury:active {
  transform: scale(0.985);
}
.training-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.training-date {
  font-family: "Didot", "Bodoni MT", Georgia, "PingFang SC", serif;
  font-size: 24rpx;
  color: var(--text-muted);
  letter-spacing: 1rpx;
}
.course-category-badge {
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
.badge-pilates {
  background: rgba(186, 36, 40, 0.08);
  color: var(--brand-crimson);
  border: 1rpx solid rgba(186, 36, 40, 0.16);
}
.badge-private {
  background: rgba(28, 20, 21, 0.06);
  color: #1C1415;
  border: 1rpx solid rgba(28, 20, 21, 0.12);
}
.badge-sculpt {
  background: rgba(198, 122, 59, 0.10);
  color: #9E5616;
  border: 1rpx solid rgba(198, 122, 59, 0.20);
}
.badge-group {
  background: rgba(60, 110, 180, 0.08);
  color: #245A96;
  border: 1rpx solid rgba(60, 110, 180, 0.18);
}
.training-duration {
  font-size: 22rpx;
  color: var(--text-muted);
  font-family: "Didot", "Bodoni MT", "Times New Roman", serif;
}
.training-course-name {
  font-family: Georgia, "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1415;
  line-height: 1.35;
  letter-spacing: 0.02em;
}
.training-focus-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(28, 20, 21, 0.06);
}
.focus-icon {
  font-size: 18rpx;
  color: var(--brand-crimson);
}
.focus-label {
  font-size: 22rpx;
  color: var(--text-muted);
}
.focus-val {
  font-size: 22rpx;
  color: #5A3A3A;
  font-weight: 500;
}

/* ================= 模块六：最近来信 ================= */
.feedback-card {
  padding: 32rpx 28rpx;
}
.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.feedback-type-label {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: var(--noir-btn);
  color: #FFFFFF;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.feedback-date {
  font-size: 24rpx;
  color: var(--text-muted);
}
.feedback-summary {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-body);
}

/* ================= 体态照片对比 ================= */
.photo-compare-card {
  padding: 32rpx 28rpx;
  margin-bottom: 16rpx;
}
.photo-compare-dates {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.compare-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(186, 36, 40, 0.08);
  border: 1rpx solid rgba(186, 36, 40, 0.16);
  font-size: 20rpx;
  font-weight: 500;
  color: var(--brand-crimson);
  letter-spacing: 1rpx;
}
.share-trigger-btn {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(8, 7, 10, 0.06);
  border: 1rpx solid rgba(8, 7, 10, 0.12);
  font-size: 20rpx;
  font-weight: 500;
  color: #120E0F;
  letter-spacing: 1rpx;
  transition: transform 140ms ease, background 140ms ease;
}
.share-trigger-btn:active {
  transform: scale(0.95);
  background: rgba(8, 7, 10, 0.12);
}
.share-trigger-icon {
  font-size: 18rpx;
  color: var(--brand-crimson);
}
.pinned-compare-card {
  border-color: rgba(255, 255, 255, 0.95);
  box-shadow: 0 22rpx 52rpx -6rpx rgba(120, 20, 20, 0.18), inset 0 1.5rpx 0 rgba(255, 255, 255, 0.95);
}

/* 角度切换胶囊栏：正面 · 侧面 · 背面 */
.angle-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 20rpx 0 24rpx;
}
.angle-tab-item {
  padding: 10rpx 36rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: #381617;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 4rpx 12rpx rgba(120, 20, 20, 0.04);
  transition: transform 160ms cubic-bezier(0.2, 0.8, 0.25, 1), background-color 200ms ease, color 200ms ease;
}
.angle-tab-item:active {
  transform: scale(0.95);
}
.angle-tab-active {
  background: #08070A;
  color: #FFFFFF;
  border-color: #08070A;
  box-shadow: 0 6rpx 20rpx rgba(8, 7, 10, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
}
.photo-date-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}
.photo-arrow {
  font-size: 26rpx;
  color: var(--brand-crimson);
}
.photo-analysis {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-body);
}

/* 对比图：左右两张，等宽 3:4 */
.photo-compare-pair {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.photo-compare-img {
  flex: 1;
  width: 0;
  aspect-ratio: 3 / 4;
  border-radius: 24rpx;
  background: rgba(28, 22, 23, 0.06);
  border: 1.5rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 20rpx rgba(120, 20, 20, 0.08);
  transition: transform 160ms cubic-bezier(0.2, 0.8, 0.25, 1);
}
.photo-compare-img:active {
  transform: scale(0.97);
}

/* 体态定格：可滑动的照片墙 */
.photo-strip {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 8rpx;
}
.photo-strip-img {
  flex-shrink: 0;
  width: 200rpx;
  height: 266rpx;
  border-radius: 24rpx;
  background: rgba(28, 22, 23, 0.06);
  border: 1.5rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 20rpx rgba(120, 20, 20, 0.08);
  transition: transform 160ms cubic-bezier(0.2, 0.8, 0.25, 1);
}
.photo-strip-img:active {
  transform: scale(0.96);
}

/* ================= 空状态与身形变化标题栏 ================= */
.section-head-flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-head-flex .section-title {
  margin: 0 0 0 12rpx;
}
.share-pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(186, 36, 40, 0.08);
  border: 1rpx solid rgba(186, 36, 40, 0.2);
  transition: transform 140ms ease, background 140ms ease;
}
.share-pill-btn:active {
  transform: scale(0.95);
  background: rgba(186, 36, 40, 0.16);
}
.share-pill-icon {
  font-size: 20rpx;
  color: var(--brand-crimson);
}
.share-pill-text {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--brand-crimson);
  letter-spacing: 1rpx;
}

.empty-state {
  padding: 60rpx 24rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.training-empty-state {
  padding: 56rpx 40rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  border: 1rpx solid rgba(220, 195, 185, 0.45);
  box-shadow: 0 12rpx 36rpx rgba(186, 36, 40, 0.05);
}
.empty-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(186, 36, 40, 0.07);
  border: 1.5rpx solid rgba(186, 36, 40, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}
.empty-icon {
  color: #BA2428;
  font-size: 26rpx;
}
.training-empty-state .empty-title {
  font-family: "Songti SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1415;
  margin-bottom: 10rpx;
}
.empty-desc {
  display: block;
  font-size: 23rpx;
  line-height: 1.65;
  color: rgba(28, 20, 21, 0.62);
  text-align: center;
  max-width: 520rpx;
}
.empty-poster-btn {
  margin-top: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #BA2428 0%, #8C161A 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(186, 36, 40, 0.35);
  transition: transform 140ms ease;
}
.empty-poster-btn:active {
  transform: scale(0.96);
}
.empty-poster-icon {
  font-size: 26rpx;
}
.empty-poster-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1.5rpx;
}

/* ================= 模块七：体态觉察 · 私密便签 ================= */
.feeling-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.feeling-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
  margin-right: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(138, 22, 26, 0.35);
}

/* 快捷体感便签胶囊 */
.feeling-tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 24rpx;
}
.feeling-tag-pill {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  color: #381617;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 10rpx rgba(120, 20, 20, 0.04);
  transition: transform 140ms ease, background 140ms ease, color 140ms ease;
}
.feeling-tag-pill:active {
  transform: scale(0.95);
}
.feeling-tag-active {
  background: #08070A;
  color: #FFFFFF;
  border-color: #08070A;
  box-shadow: 0 4rpx 16rpx rgba(8, 7, 10, 0.25);
}

.textarea-field {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  padding: 28rpx;
  background: var(--card-glass);
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  border-radius: 32rpx;
  border: var(--card-border);
  box-shadow: var(--card-shadow);
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-main);
  transition: border-color 200ms ease, box-shadow 200ms ease;
}

.feeling-footer {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.feeling-privacy-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
}
.feeling-privacy-badge .privacy-lock {
  font-size: 20rpx;
}
.feeling-privacy-badge .privacy-text {
  font-size: 23rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.25);
}
.feeling-privacy-note {
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.25);
}
.btn-submit-feeling {
  width: 100% !important;
}

.btn-primary {
  background: #08070A;
  color: #FFFFFF;
  border-radius: 999rpx;
  border: none;
  padding: 26rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-align: center;
  box-shadow: 
    0 12rpx 28rpx rgba(8, 7, 10, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
  transition: transform 140ms cubic-bezier(0.2, 0.8, 0.25, 1), opacity 140ms ease;
}
.btn-primary:active {
  transform: scale(0.965);
  opacity: 0.9;
}
/* 未输入时的禁用态：半透曜黑微光胶囊 + 清晰暖白字 */
button.btn-primary[disabled],
button.btn-primary[disabled]:not([type]) {
  background: rgba(28, 16, 17, 0.42);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: rgba(255, 255, 255, 0.88);
  opacity: 1;
  box-shadow: none;
}

.reply-card {
  margin-top: 26rpx;
  padding: 32rpx 28rpx;
}
.reply-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.reply-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1213;
  letter-spacing: 2rpx;
}
.reply-badge {
  font-size: 18rpx;
  color: var(--brand-crimson);
  background: rgba(186, 36, 40, 0.08);
  border: 1rpx solid rgba(186, 36, 40, 0.16);
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}
.reply-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-body);
}

/* ================= 画报级体态美学分享卡 弹窗 ================= */
.share-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: rgba(8, 7, 10, 0.78);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  animation: fadeIn 0.25s ease both;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 右上角常驻高奢悬浮关闭按钮 */
.modal-float-close {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 24rpx);
  right: 32rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1.5rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100001;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
  transition: transform 140ms ease, background 140ms ease;
}
.modal-float-close:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.4);
}

/* 纵向滚动容器：无论文字多长都可以上下丝滑滑动 */
.share-modal-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

.share-modal-container {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 110rpx) 44rpx calc(env(safe-area-inset-bottom) + 90rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-card {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  padding: 48rpx 36rpx 40rpx;
  border-radius: 36rpx;
  background: #FCF8F5;
  border: 1.5rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.38);
  display: flex;
  flex-direction: column;
}

.poster-brand {
  text-align: center;
  margin-bottom: 24rpx;
}
.poster-brand-en {
  display: block;
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 22rpx;
  letter-spacing: 0.25em;
  color: #120E0F;
}
.poster-brand-cn {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #8C6A6B;
  letter-spacing: 0.12em;
}

.poster-member-info {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(28, 20, 21, 0.08);
  margin-bottom: 24rpx;
}
.poster-member-title {
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 1rpx;
}
.poster-member-days {
  font-size: 20rpx;
  color: #8C6A6B;
}

.poster-compare-pair {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.poster-img-box {
  flex: 1;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  background: #EAE3DE;
}
.poster-img {
  width: 100%;
  height: 100%;
}
.poster-tag {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(8, 7, 10, 0.7);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  color: #FFFFFF;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

/* 无对比图时的高奢自律徽章（纯净真实） */
.poster-no-photo-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(234, 226, 220, 0.45) 0%, rgba(245, 237, 232, 0.9) 100%);
  border: 1rpx dashed rgba(186, 36, 40, 0.25);
  text-align: center;
}
.poster-badge-icon {
  font-size: 40rpx;
  color: var(--brand-crimson);
  margin-bottom: 12rpx;
}
.poster-badge-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.poster-badge-sub {
  font-size: 20rpx;
  color: #8C6A6B;
  letter-spacing: 1rpx;
}

.poster-analysis-box {
  position: relative;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 20rpx;
  padding: 20rpx 24rpx 20rpx 44rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(28, 20, 21, 0.04);
}
.poster-quote {
  position: absolute;
  top: 10rpx;
  left: 16rpx;
  font-family: Georgia, serif;
  font-size: 32rpx;
  color: var(--brand-crimson);
  opacity: 0.6;
}
.poster-analysis {
  font-size: 24rpx;
  line-height: 1.6;
  color: #381617;
  font-style: italic;
}

.poster-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(28, 20, 21, 0.08);
}
.poster-footer-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.poster-sign {
  font-size: 22rpx;
  font-weight: 500;
  color: #1C1415;
}
.poster-slogan {
  font-size: 18rpx;
  color: #8C6A6B;
  letter-spacing: 1rpx;
}
.poster-stamp {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 1.5rpx dashed var(--brand-crimson);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-12deg);
}
.poster-stamp-inner {
  font-size: 14rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--brand-crimson);
  text-align: center;
  letter-spacing: 1rpx;
}

.poster-scroll-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 260rpx);
  width: 100%;
  flex-shrink: 0;
}

/* 底部固定吸底操作栏：无论何时何地，保存按钮永远悬浮在屏幕最底端，一眼可见！ */
.poster-fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 44rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: linear-gradient(180deg, rgba(8, 7, 10, 0) 0%, rgba(8, 7, 10, 0.88) 35%, rgba(8, 7, 10, 0.98) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 100002;
  box-sizing: border-box;
}

.poster-btn-primary {
  width: 100% !important;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #BA2428 0%, #8C161A 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 10rpx 32rpx rgba(186, 36, 40, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  transition: transform 140ms ease;
}
.poster-btn-primary:active {
  transform: scale(0.98);
}

.poster-bottom-subrow {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.poster-btn-secondary {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1.5rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  transition: transform 140ms ease;
}
.poster-btn-secondary:active {
  transform: scale(0.98);
}

.poster-btn-close-pill {
  padding: 0 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 140ms ease;
}
.poster-btn-close-pill:active {
  opacity: 0.6;
}

.poster-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1260px;
  opacity: 0;
  pointer-events: none;
  z-index: -999;
}

/* ================= 极简高奢开屏海报 ================= */
.splash-screen {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background-color: #CE3834;
  background-image:
    radial-gradient(circle at 85% 12%, rgba(255, 248, 242, 0.78) 0%, transparent 50%),
    linear-gradient(168deg, #F5E5D9 0%, #E58572 30%, #D4423C 62%, #BA2428 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: env(safe-area-inset-top) 48rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  transition: opacity 550ms cubic-bezier(0.16, 1, 0.3, 1), transform 550ms cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  touch-action: none;
}

.splash-fade-out {
  opacity: 0;
  transform: scale(1.05);
  pointer-events: none;
}

.splash-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transform: translateY(-20rpx);
}

/* 奢侈品高定感品牌拼音：置于「到徕舞」上方 */
.splash-brand-luxury {
  font-family: "Didot", "Bodoni MT", Georgia, "Times New Roman", serif;
  font-size: 46rpx;
  font-weight: 400;
  color: #FFFFFF;
  letter-spacing: 0.40em;
  margin-right: -0.40em;
  line-height: 1;
  text-shadow: 0 4rpx 20rpx rgba(140, 20, 20, 0.18);
}

/* 品牌标下方的极细微光隔线 */
.splash-brand-line {
  width: 48rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.65);
  margin: 28rpx 0 44rpx;
}

/* 到徕舞 */
.splash-sub {
  font-size: 60rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.16em;
  margin-right: -0.16em;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 24rpx rgba(140, 20, 20, 0.2);
}

/* 一起 / 好状态 */
.splash-main {
  font-size: 136rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.08;
  letter-spacing: 0.08em;
  margin-right: -0.08em;
  text-shadow: 0 8rpx 32rpx rgba(140, 20, 20, 0.25);
}

/* 即刻开启胶囊按钮 */
.splash-cta {
  margin-top: 96rpx;
  width: 310rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: rgba(82, 22, 20, 0.68);
  border: 1.5rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
  padding-left: 0.14em;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 12rpx 32rpx rgba(90, 15, 15, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), background-color 180ms;
}

.splash-cta:active {
  transform: scale(0.95);
  background: rgba(60, 14, 12, 0.85);
}
