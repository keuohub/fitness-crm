/* ================= 极简高奢开屏海报 ================= */
.splash-screen {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background-color: #CE3834;
  background-image:
    radial-gradient(circle at 85% 12%, rgba(255, 248, 242, 0.78) 0%, transparent 50%),
    linear-gradient(168deg, #F5E5D9 0%, #E58572 30%, #D4423C 62%, #BA2428 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: env(safe-area-inset-top) 48rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  transition: opacity 550ms cubic-bezier(0.16, 1, 0.3, 1), transform 550ms cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  touch-action: none;
}

.splash-fade-out {
  opacity: 0;
  transform: scale(1.05);
  pointer-events: none;
}

.splash-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transform: translateY(-20rpx);
}

/* 奢侈品高定感品牌拼音：置于「到徕舞」上方 */
