  align-items: center;
  justify-content: center;
  box-shadow: 
    0 12rpx 32rpx rgba(90, 15, 15, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), background-color 180ms;
}

.splash-cta:active {
  transform: scale(0.95);
  background: rgba(60, 14, 12, 0.85);
}

/* ================= 头部右侧：月度之星胶囊入口 ================= */
.stars-open-pill {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
