  width: 48rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.65);
  margin: 28rpx 0 44rpx;
}

/* 到徕舞 */
.splash-sub {
  font-size: 60rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.16em;
  margin-right: -0.16em;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 24rpx rgba(140, 20, 20, 0.2);
}

/* 一起 / 好状态 */
.splash-main {
  font-size: 136rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.08;
