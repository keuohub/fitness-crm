<wxs module="tools">
module.exports = {
  includes: function(arr, val) {
    if (!arr) return false;
    return arr.indexOf(val) !== -1;
  }
};
</wxs>

<view class="growth-page">

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading-view">
    <text class="loading-text">正在加载你的成长足迹...</text>
  </view>

  <block wx:else>

    <!-- ====== 章节一：光影场馆 · 空间策展 (Chapter 01: The Sanctuary) ====== -->
    <!-- 去除白盒容器，以无界画廊横滑画报破格呈现，营造呼吸感与大牌感 -->
    <view class="editorial-section venue-editorial stagger-1" wx:if="{{venueList && venueList.length > 0}}">
      <view class="editorial-header">
        <view class="editorial-chapter-tag">
          <text class="chapter-code">01</text>
          <text class="chapter-dot">/</text>
          <text class="chapter-label">空间策展</text>
        </view>
        <text class="editorial-title">场馆光影</text>
        <text class="editorial-subtitle">THE SANCTUARY</text>
      </view>
      <scroll-view class="venue-gallery-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="venue-gallery-item" wx:for="{{venueList}}" wx:key="id" bindtap="previewVenueImage" data-src="{{item.imageUrl}}">
          <image class="venue-gallery-img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="true"></image>
        </view>
      </scroll-view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- ====== 章节二：同行导师 · 真实陪伴 (Chapter 02: Mentors & Companions) ====== -->
    <!-- 告别僵硬三等分卡片，采用温润肖像画幅与纯净排印留白 -->
    <view class="editorial-section team-editorial stagger-2" wx:if="{{teamList && teamList.length > 0}}">
      <view class="editorial-header">
        <view class="editorial-chapter-tag">
          <text class="chapter-code">02</text>
          <text class="chapter-dot">/</text>
          <text class="chapter-label">同行导师</text>
        </view>
        <text class="editorial-title">徕舞团队</text>
        <text class="editorial-subtitle">THE MENTORS</text>
      </view>
      <view class="team-portrait-row">
        <view class="team-portrait-col" wx:for="{{teamList}}" wx:key="id" bindtap="previewTeamImage" data-src="{{item.avatarUrl}}">
          <view class="portrait-frame">
            <image class="portrait-photo" src="{{item.avatarUrl}}" mode="aspectFill" lazy-load="true"></image>
          </view>
          <view class="portrait-meta">
            <text class="portrait-name">{{item.name}}</text>
            <text class="portrait-role">{{item.roleTitle}}</text>
            <text class="portrait-bio" wx:if="{{item.bio}}">“{{item.bio}}”</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- ====== 章节三：问候与沉淀岁月 (Chapter 03: The Greeting & Bond) ====== -->
    <view class="editorial-section greeting-editorial stagger-3">
      <view class="greeting-header-row">
        <view class="greeting-headline-group">
          <text class="greeting-lead">早安，与身体对话的</text>
          <view class="greeting-name-row">
            <text class="greeting-hero-name">{{memberName || '身体掌权者'}}</text>
            <view class="stars-chic-trigger" bindtap="openStarsModal">
              <text class="stars-chic-spark">✦</text>
              <text class="stars-chic-text">月度之星</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 进阶经纬：线性水平刻度，取代粗暴药丸盒子 -->
      <view class="progression-horizon">
        <view class="horizon-header">
          <text class="horizon-title">进阶经纬 · 身体觉知</text>
          <text class="horizon-badge">{{stageName}}</text>
        </view>
        <view class="horizon-track">
          <view class="horizon-node {{trainCount >= 1 ? 'node-reached' : ''}}">
            <view class="node-bullet"></view>
            <text class="node-name">觉知</text>
          </view>
          <view class="horizon-line {{trainCount >= 6 ? 'line-reached' : ''}}"></view>
          <view class="horizon-node {{trainCount >= 6 ? 'node-reached' : ''}}">
            <view class="node-bullet"></view>
            <text class="node-name">掌控</text>
          </view>
          <view class="horizon-line {{trainCount >= 21 ? 'line-reached' : ''}}"></view>
          <view class="horizon-node {{trainCount >= 21 ? 'node-reached' : ''}}">
            <view class="node-bullet"></view>
            <text class="node-name">掌权</text>
          </view>
          <view class="horizon-line {{trainCount >= 51 ? 'line-reached' : ''}}"></view>
          <view class="horizon-node {{trainCount >= 51 ? 'node-reached' : ''}}">
            <view class="node-bullet"></view>
            <text class="node-name">优雅</text>
          </view>
        </view>
        <view class="horizon-target-text">
          <block wx:if="{{trainCount < 6}}">坚持不易。再完成 {{6 - trainCount}} 次私教训练，迈入「身体掌控」进阶阶段</block>
          <block wx:elif="{{trainCount < 21}}">渐入佳境。仅余 {{21 - trainCount}} 次私教训练，迈入「身体掌权」深层蜕变期</block>
          <block wx:elif="{{trainCount < 51}}">自律已成习惯。仅余 {{51 - trainCount}} 次训练，晋升「终生优雅」卓越境界</block>
          <block wx:else>自律已成骨骼，挺拔从容是你呼吸自带的底气</block>
        </view>
      </view>

      <!-- 身体自律资产：大牌杂志开放式排印尺度 (Open Editorial Metric) -->
      <view class="metrics-editorial-row">
        <view class="metric-block">
          <view class="metric-num-wrap">
            <text class="metric-big-num">{{formattedDays}}</text>
            <text class="metric-unit">DAYS</text>
          </view>
          <text class="metric-label">相伴自律时光</text>
          <text class="metric-caption">深层体态觉察与呼吸沉淀</text>
        </view>
        <view class="metric-vertical-divider"></view>
        <view class="metric-block">
          <view class="metric-num-wrap">
            <text class="metric-big-num">{{trainCount || 0}}</text>
            <text class="metric-unit">SESSIONS</text>
          </view>
          <text class="metric-label">核心私教蜕变</text>
          <text class="metric-caption">普拉提大器械与体态精雕</text>
        </view>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- ====== 章节四：小桥私语 · 亲笔手札 (Chapter 04: The Whisper Note) ====== -->
    <view class="editorial-section whisper-editorial stagger-4">
      <view class="stationery-note-card">
        <view class="stationery-header">
          <view class="stationery-title-wrap">
            <text class="stationery-tag">主理人私语</text>
            <text class="stationery-heading">{{whisperTitle}}</text>
          </view>
          <view class="stationery-seal">印</view>
        </view>
        <text class="stationery-body">{{whisperBody}}</text>
        <view class="stationery-sign-row">
          <text class="stationery-sign">— 小桥 · 亲笔于徕舞</text>
        </view>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- ====== 章节五：身形蜕变定格 (Chapter 05: Posture Metamorphosis) ====== -->
    <view class="editorial-section compare-editorial stagger-5">
      <view class="editorial-header">
        <view class="editorial-header-split">
          <view>
            <view class="editorial-chapter-tag">
              <text class="chapter-code">05</text>
              <text class="chapter-dot">/</text>
              <text class="chapter-label">视觉定格</text>
            </view>
            <text class="editorial-title">身形蜕变</text>
            <text class="editorial-subtitle">METAMORPHOSIS</text>
          </view>
          <view class="editorial-share-btn" bindtap="openShareModal">
            <text class="share-btn-spark">✦</text>
            <text class="share-btn-txt">自律画报</text>
          </view>
        </view>
      </view>

      <!-- 一组数据都没有时显示温柔占位与生成海报入口 -->
      <view wx:if="{{!photoComparisons || photoComparisons.length === 0}}" class="editorial-empty-state">
        <text class="editorial-empty-lead">小桥正在为你收录专属体态蜕变</text>
        <text class="editorial-empty-sub">每一次普拉提核心训练，都在悄然重塑肩颈与背脊线条</text>
        <view class="editorial-poster-trigger" bindtap="openShareModal">
          <text class="poster-trigger-spark">✦</text>
          <text class="poster-trigger-text">生成自律档案海报并保存到相册</text>
        </view>
      </view>

      <!-- 有对比数据 -->
      <block wx:else>
        <!-- 置顶对比：蜕变前 vs 当下 -->
        <view wx:if="{{pinnedComparison}}" class="editorial-compare-frame">
          <view class="compare-frame-header">
            <view class="compare-labels">
              <text class="compare-label-text">初见</text>
              <text class="compare-label-arrow">→</text>
              <text class="compare-label-text">当下新身</text>
            </view>
            <view class="compare-inline-share" bindtap="openShareModal" data-item="{{pinnedComparison}}">
              <text>画报分享 ✦</text>
            </view>
          </view>
          <view class="compare-diptych">
            <view class="diptych-pane">
              <image class="diptych-img" src="{{pinnedComparison.photo1_url}}" mode="aspectFill"
                     data-src="{{pinnedComparison.photo1_url}}" data-p1="{{pinnedComparison.photo1_url}}" data-p2="{{pinnedComparison.photo2_url}}" bindtap="previewPhoto" />
              <text class="diptych-caption">初见 · 蜕变前</text>
            </view>
            <view class="diptych-pane">
              <image class="diptych-img" src="{{pinnedComparison.photo2_url}}" mode="aspectFill"
                     data-src="{{pinnedComparison.photo2_url}}" data-p1="{{pinnedComparison.photo1_url}}" data-p2="{{pinnedComparison.photo2_url}}" bindtap="previewPhoto" />
              <text class="diptych-caption">当下 · 沉淀后</text>
            </view>
          </view>
          <text wx:if="{{pinnedComparison.analysis}}" class="compare-editorial-analysis">“{{pinnedComparison.analysis}}”</text>
        </view>

        <!-- 极简下划线视角切换 (Minimal Underline Tabs) -->
        <view class="editorial-angle-tabs">
          <view wx:for="{{angleTabs}}" wx:key="key"
                class="angle-tab-item {{selectedAngle === item.key ? 'angle-tab-active' : ''}}"
                data-angle="{{item.key}}" bindtap="switchAngle">
            <text class="angle-tab-text">{{item.label}}</text>
            <view class="angle-tab-underline" wx:if="{{selectedAngle === item.key}}"></view>
          </view>
        </view>

        <!-- 历史对比序列 -->
        <block wx:if="{{historyComparisons.length > 0}}">
          <view wx:for="{{historyComparisons}}" wx:key="id" class="editorial-compare-frame">
            <view class="compare-frame-header">
              <view class="compare-labels">
                <text class="compare-label-text">初见</text>
                <text class="compare-label-arrow">→</text>
                <text class="compare-label-text">当下新身</text>
              </view>
              <view class="compare-inline-share" bindtap="openShareModal" data-item="{{item}}">
                <text>画报分享 ✦</text>
              </view>
            </view>
            <view class="compare-diptych">
              <view class="diptych-pane">
                <image class="diptych-img" src="{{item.photo1_url}}" mode="aspectFill"
                       data-src="{{item.photo1_url}}" data-p1="{{item.photo1_url}}" data-p2="{{item.photo2_url}}" bindtap="previewPhoto" />
                <text class="diptych-caption">初见 · 蜕变前</text>
              </view>
              <view class="diptych-pane">
                <image class="diptych-img" src="{{item.photo2_url}}" mode="aspectFill"
                       data-src="{{item.photo2_url}}" data-p1="{{item.photo1_url}}" data-p2="{{item.photo2_url}}" bindtap="previewPhoto" />
                <text class="diptych-caption">当下 · 沉淀后</text>
              </view>
            </view>
            <text wx:if="{{item.analysis}}" class="compare-editorial-analysis">“{{item.analysis}}”</text>
          </view>
        </block>
      </block>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- ====== 章节六：雕塑印记 · 训练足迹 (Chapter 06: Footprints) ====== -->
    <view class="editorial-section practice-editorial stagger-6">
      <view class="editorial-header">
        <view class="editorial-chapter-tag">
          <text class="chapter-code">06</text>
          <text class="chapter-dot">/</text>
          <text class="chapter-label">雕塑印记</text>
        </view>
        <text class="editorial-title">雕塑足迹</text>
        <text class="editorial-subtitle">THE PRACTICE</text>
      </view>

      <view wx:if="{{recentTrainings.length > 0}}" class="practice-timeline">
        <view wx:for="{{recentTrainings}}" wx:key="id" class="practice-entry">
          <view class="practice-date-col">
            <text class="practice-date">{{item.date}}</text>
            <text class="practice-duration" wx:if="{{item.duration}}">{{item.duration}}</text>
          </view>
          <view class="practice-body-col">
            <view class="practice-top-line">
              <text class="practice-course-name">{{item.type}}</text>
              <text class="practice-cat-tag">{{item.category}}</text>
            </view>
            <view class="practice-focus-line" wx:if="{{item.focusArea}}">
              <text class="focus-dot">·</text>
              <text class="focus-text">重点精雕：{{item.focusArea}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="editorial-empty-state">
        <text class="editorial-empty-lead">静候你的首次开练记录</text>
        <text class="editorial-empty-sub">每一次核心私教与体态精雕，小桥都会在此为你沉淀课时印记。</text>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- ====== 章节七：双向倾听 · 私享便签 (Chapter 07: Intimate Note) ====== -->
    <view class="editorial-section note-editorial stagger-7">
      <view class="editorial-header">
        <view class="editorial-chapter-tag">
          <text class="chapter-code">07</text>
          <text class="chapter-dot">/</text>
          <text class="chapter-label">双向倾听</text>
        </view>
        <text class="editorial-title">私享便签</text>
        <text class="editorial-subtitle">INTIMATE NOTE</text>
      </view>

      <view class="note-stationery-box">
        <!-- 标签流式排印 -->
        <view class="note-tags-flow">
          <view wx:for="{{feelingTags}}" wx:key="*this"
                class="note-tag-chip {{tools.includes(selectedFeelingTags, item) ? 'note-tag-active' : ''}}"
                bindtap="toggleFeelingTag" data-tag="{{item}}">
            #{{item}}
          </view>
        </view>

        <textarea class="note-textarea" value="{{feeling}}"
                  placeholder="跟小桥说说：今天练完身体感觉怎么样？哪里舒展了，或者有什么想交流的..."
                  bindinput="onFeelingInput" maxlength="500" />

        <view class="note-action-row">
          <text class="note-privacy-hint">便签仅你与教练可见 · 小桥会认真阅读并回复</text>
          <button class="btn-note-submit" bindtap="submitFeeling" disabled="{{feelingSubmitting || feeling === ''}}">
            {{feelingSubmitting ? "发送中..." : "发给小桥"}}
          </button>
        </view>

        <view wx:if="{{feelingReply}}" class="note-reply-box">
          <view class="note-reply-header">
            <text class="note-reply-tag">小桥回音 · 亲笔</text>
            <text class="note-reply-date">已收录手札</text>
          </view>
          <text class="note-reply-content">{{feelingReply}}</text>
        </view>
      </view>
    </view>

  </block>
</view>

<!-- ====== 画报级体态美学分享卡 弹窗 ====== -->
<view class="share-modal-mask" wx:if="{{showShareModal}}" bindtap="closeShareModal">
  <!-- 右上角常驻悬浮关闭按钮：任何时候一触即关 -->
  <view class="modal-float-close" catchtap="closeShareModal">✕</view>

  <!-- 纵向滚动容器：无论文字多长都可以上下丝滑滑动 -->
  <scroll-view scroll-y class="share-modal-scroll" enhanced show-scrollbar="{{false}}">
    <view class="share-modal-container" bindtap="closeShareModal">
      <view class="poster-card" catchtap="noop">
        <view class="poster-brand">
          <text class="poster-brand-en">身 体 掌 权 · 终 生 优 雅</text>
          <text class="poster-brand-cn">徕舞 · 私人体态美学档案</text>
        </view>

        <view class="poster-member-info">
          <text class="poster-member-title">{{memberName}} · 身体掌权者</text>
          <text class="poster-member-days">相伴自律 {{joinDays}} 天</text>
        </view>

        <!-- 仅当有真实对比图时呈现对比图，未拍照会员严禁做假图 -->
        <view class="poster-compare-pair" wx:if="{{shareComparison && shareComparison.photo1_url && shareComparison.photo2_url}}">
          <view class="poster-img-box">
            <image class="poster-img" src="{{shareComparison.photo1_url}}" mode="aspectFill" />
            <text class="poster-tag">初见 · 蜕变前</text>
          </view>
          <view class="poster-img-box">
            <image class="poster-img" src="{{shareComparison.photo2_url}}" mode="aspectFill" />
            <text class="poster-tag">当下 · 新生后</text>
          </view>
        </view>
        <!-- 无对比图时的高奢自律徽章（纯净真实，绝不放假图） -->
        <view class="poster-no-photo-badge" wx:else>
          <view class="poster-badge-icon">✦</view>
          <text class="poster-badge-title">身 心 觉 察 · 终 生 自 律</text>
          <text class="poster-badge-sub">累计完成 {{trainCount || 0}} 次核心训练 · 岁月不负自律</text>
        </view>

        <view class="poster-analysis-box" wx:if="{{shareComparison && shareComparison.analysis}}">
          <text class="poster-quote">“</text>
          <text class="poster-analysis">{{shareComparison.analysis}}</text>
        </view>
        <view class="poster-analysis-box" wx:else>
          <text class="poster-quote">“</text>
          <text class="poster-analysis">锁骨舒展，骨盆中立回弹，自带松弛挺拔的大女主气场。</text>
        </view>

        <view class="poster-footer">
          <view class="poster-footer-left">
            <text class="poster-sign">小桥 · 专属私教手札</text>
            <text class="poster-slogan">自律成骨骼，岁月即礼赞</text>
          </view>
          <view class="poster-stamp">
            <text class="poster-stamp-inner">徕舞\n私享</text>
          </view>
        </view>
      </view>

      <!-- 预留底部吸底操作栏高度，让卡片内容可以完整滑出 -->
      <view class="poster-scroll-bottom-spacer"></view>
    </view>
  </scroll-view>

  <!-- 底部固定吸底操作栏：无论何时何地，保存按钮永远悬浮在屏幕最底端，一眼可见！ -->
  <view class="poster-fixed-bottom" catchtap="noop">
    <button class="poster-btn-primary" bindtap="savePosterToAlbum" loading="{{savingPoster}}">
      <text class="poster-btn-spark">✦</text> 保存海报到手机相册
    </button>
    <view class="poster-bottom-subrow">
      <button class="poster-btn-secondary" open-type="share">
        <text class="poster-btn-spark">✦</text> 分享给微信好友
      </button>
      <view class="poster-btn-close-pill" bindtap="closeShareModal">
        ✕ 关闭
      </view>
    </view>
  </view>
</view>

<!-- 离屏海报绘制画布 (用于生成保存到相册的高清图片) -->
<canvas type="2d" id="posterCanvas" class="poster-canvas-hidden"></canvas>

<!-- ====== 开屏「✦ 徕舞 · 月度之星 ✦」沉浸式大片 (1:1 对标 Lululemon 经典画幅) ====== -->
<view class="stars-lulu-container {{showStarsModal ? 'lulu-visible' : 'lulu-hidden'}} {{starsClosing ? 'lulu-closing' : ''}}" 
      wx:if="{{showStarsModal}}">
  
  <!-- 顶部常驻悬浮栏：左上角 LAIWU 品牌标 -->
  <view class="stars-lulu-top-nav">
    <text class="stars-lulu-brand">LAIWU</text>
  </view>

  <!-- 右上角避让胶囊的高奢毛玻璃关闭/跳过按钮 (独立定位，确保不被任何刘海/胶囊遮挡) -->
  <view class="stars-lulu-close-pill" catchtap="closeStarsModal">
    <text class="stars-lulu-close-text">跳过</text>
    <text class="stars-lulu-close-x">✕</text>
  </view>

  <!-- Lululemon 级全屏沉浸画报横滑 Swiper (单张铺满，手势丝滑) -->
  <swiper class="stars-lulu-swiper" 
          current="{{currentStarIndex}}"
          bindchange="onStarSwiperChange">
    <swiper-item wx:for="{{monthlyStarsList}}" wx:key="id" class="stars-lulu-item">
      <view class="stars-lulu-slide">
        <image class="stars-lulu-img" src="{{item.avatarUrl}}" mode="aspectFill" lazy-load="true"></image>
        
        <!-- 柔和电影级暗角微光，保护白字辨识度 -->
        <view class="stars-lulu-top-gradient"></view>
        <view class="stars-lulu-bottom-gradient"></view>
        
        <!-- 下半部核心信息区：白字「徕舞月度之星 —— 名字」，不放“立即选购” -->
        <view class="stars-lulu-content-box">
          <view class="stars-lulu-headline">徕舞月度之星 —— {{item.name}}</view>
          <view class="stars-lulu-quote" wx:if="{{item.quote}}">“{{item.quote}}”</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- Lululemon 同款经典细条分页指示器 (细胶囊当前页 + 微透圆点) -->
  <view class="stars-lulu-pagination">
    <view wx:for="{{monthlyStarsList}}" wx:key="id" 
          class="lulu-dot {{index === currentStarIndex ? 'lulu-dot-active' : ''}}"></view>
  </view>

  <!-- 底部毛玻璃操作栏：与小程序原生磨砂质感深度呼应，一触即入 -->
  <view class="stars-lulu-bottom-bar" catchtap="closeStarsModal">
    <view class="stars-lulu-frosted-pill">
      <text class="stars-lulu-spark">✦</text>
      <text class="stars-lulu-enter-txt">进入成长主页 · 开启今日自律</text>
      <text class="stars-lulu-enter-arrow">❯</text>
    </view>
  </view>
</view>

<!-- ====== 全屏开屏：到徕舞 一起好状态 ======
     必须放在 .growth-page 之外。
     .growth-page 带进场动画（transform），会让内部的 position: fixed
     以它为参照物，全屏层被撑成整页高度，内容就掉到屏幕下方去了。 -->
<view class="splash-screen {{splashFadeOut ? 'splash-fade-out' : ''}}" wx:if="{{showSplash}}" catchtouchmove="noop">
  <view class="splash-center">
    <!-- 高奢衬线品牌拼音：置于「到徕舞」正上方 -->
    <text class="splash-brand-luxury">L A I W U</text>
    <view class="splash-brand-line"></view>

    <!-- 核心文案 -->
    <text class="splash-sub">到徕舞</text>
    <text class="splash-main">一起</text>
    <text class="splash-main">好状态</text>

    <!-- 唯一交互入口 -->
    <view class="splash-cta" bindtap="skipSplash">即刻开启</view>
  </view>
</view>

