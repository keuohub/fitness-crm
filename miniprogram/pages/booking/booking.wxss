page {
  background-color: #F6E6DA;
  color: #1C1415;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}
.bk-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 110rpx) 32rpx 0;
  box-sizing: border-box;
}
.bk-loading { min-height: 70vh; display: flex; align-items: center; justify-content: center; }
.bk-loading-text { font-size: 26rpx; color: rgba(255,255,255,.86); }
.bk-hero { padding: 4rpx 8rpx 22rpx; }
.bk-eyebrow { display: block; font-size: 20rpx; letter-spacing: 4rpx; color: rgba(255,255,255,.68); }
.bk-title { display: block; margin-top: 14rpx; font-size: 52rpx; font-weight: 600; color: #FFFFFF; }
.bk-sub { display: block; margin-top: 12rpx; font-size: 23rpx; color: rgba(255,255,255,.82); line-height: 1.7; }
.bk-error { background: rgba(255,255,255,.92); border-radius: 16rpx; padding: 18rpx 22rpx; margin-bottom: 16rpx; color: #9E2A2B; font-size: 24rpx; }
.bk-dates { white-space: nowrap; margin-bottom: 26rpx; }
.bk-date {
  display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
  width: 96rpx; height: 120rpx; margin-right: 12rpx; border-radius: 18rpx;
  background: rgba(255,255,255,.62); vertical-align: top;
}
.bk-date-active { background: #0D0C0F; }
.bk-date-week { font-size: 20rpx; color: #6D645D; }
.bk-date-day { margin-top: 8rpx; font-size: 24rpx; color: #1C1415; }
.bk-date-active .bk-date-week, .bk-date-active .bk-date-day { color: #F6E6DA; }
.bk-section { margin-bottom: 34rpx; }
.bk-section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; padding-left: 4rpx; }
.bk-section-title { font-size: 30rpx; font-weight: 600; color: #FFFFFF; }
.bk-section-note { font-size: 20rpx; color: rgba(255,255,255,.7); }
.bk-empty { background: rgba(255,255,255,.62); border: 1rpx dashed rgba(255,255,255,.9); border-radius: 20rpx; padding: 30rpx 26rpx; }
.bk-empty-title { display: block; font-size: 26rpx; font-weight: 600; color: #FFFFFF; }
.bk-empty-body { display: block; margin-top: 10rpx; font-size: 22rpx; color: rgba(255,255,255,.84); }
.bk-session { background: rgba(255,255,255,.92); border-radius: 22rpx; padding: 22rpx 24rpx; margin-bottom: 14rpx; }
.bk-session-top { display: flex; align-items: flex-start; }
.bk-session-time { width: 116rpx; flex-shrink: 0; }
.bk-time-start { display: block; font-size: 30rpx; font-weight: 600; color: #1C1415; }
.bk-time-end { display: block; font-size: 19rpx; color: #8C827B; margin-top: 2rpx; }
.bk-session-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.bk-course { font-size: 28rpx; font-weight: 600; color: #1C1415; }
.bk-meta { margin-top: 6rpx; font-size: 20rpx; color: #8C827B; }
.bk-remain { font-size: 21rpx; color: #2E7D4F; white-space: nowrap; margin-left: 8rpx; }
.bk-remain-full { color: #9E2A2B; }
.bk-session-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(28,20,21,.06); }
.bk-capacity { font-size: 20rpx; color: #8C827B; }
.bk-book-btn { padding: 10rpx 30rpx; border-radius: 30rpx; background: #0D0C0F; color: #F6E6DA; font-size: 22rpx; }
.bk-book-disabled { padding: 10rpx 30rpx; border-radius: 30rpx; background: #F1EDE8; color: #A79E9A; font-size: 22rpx; }
.bk-booked { display: flex; align-items: center; gap: 14rpx; }
.bk-booked-text { font-size: 21rpx; color: #2E7D4F; }
.bk-cancel-mini, .bk-cancel-btn { padding: 8rpx 22rpx; border-radius: 28rpx; border: 1rpx solid #E0C9C5; color: #8A1F17; font-size: 21rpx; background: #FDF2F1; }
.bk-my-item { display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,.92); border-radius: 20rpx; padding: 20rpx 22rpx; margin-bottom: 12rpx; }
.bk-my-main { display: flex; flex-direction: column; min-width: 0; }
.bk-my-course { font-size: 26rpx; font-weight: 600; color: #1C1415; }
.bk-my-meta { margin-top: 6rpx; font-size: 20rpx; color: #8C827B; }
.bk-bottom-space { height: calc(env(safe-area-inset-bottom) + 120rpx); }
