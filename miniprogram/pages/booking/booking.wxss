/* pages/booking/booking.wxss
   徕舞女子塑形 · 会员约课系统
   轻奢暖沙原调 · 无紫色 · 吸顶分类与周历 · 黄金三栏图文排版
   ============================================================ */

page {
  background-color: #F6E6DA;
  color: #1C1415;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.bk-container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 顶部吸顶区域（导航栏 + 分类Tab + 单行周历） ── */
.bk-header-sticky {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(246, 230, 218, 0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(28, 20, 21, 0.06);
}

/* 自定义导航标题（避让灵动岛） */
.bk-navbar {
  padding-top: env(safe-area-inset-top);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.bk-nav-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1C1415;
}

/* 一级分类导航 Tab */
.bk-cat-tabs {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8rpx 24rpx 14rpx;
}

.bk-cat-tab {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
}

.bk-cat-label {
  font-size: 29rpx;
  font-weight: 500;
  color: #7A7068;
  transition: color 0.2s ease;
}

.bk-cat-active .bk-cat-label {
  color: #0D0C0F;
  font-weight: 700;
}

.bk-cat-bar {
  margin-top: 8rpx;
  width: 44rpx;
  height: 5rpx;
  background: #0D0C0F;
  border-radius: 4rpx;
}

/* 单行周历横滑条 */
.bk-dates-scroll {
  white-space: nowrap;
  padding: 10rpx 0 20rpx;
}

.bk-dates-row {
  display: inline-flex;
  padding-left: 28rpx;
  padding-right: 16rpx;
}

.bk-date-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 118rpx;
  margin-right: 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s cubic-bezier(0.2, 0.8, 0.25, 1);
}

.bk-date-pill:active {
  transform: scale(0.96);
}

.bk-date-weekday {
  font-size: 21rpx;
  font-weight: 500;
  color: #7A7068;
}

.bk-date-daynum {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1415;
}

/* 选中高亮日期：曜黑胶囊底 + 暖金微点 */
.bk-date-active {
  background: #0D0C0F !important;
  border-color: #0D0C0F !important;
  box-shadow: 0 8rpx 20rpx -4rpx rgba(13, 12, 15, 0.35);
}

.bk-date-active .bk-date-weekday,
.bk-date-active .bk-date-daynum {
  color: #F6E6DA !important;
}

.bk-date-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #C59A45;
  margin-top: 6rpx;
}

/* ── 内容区域 ── */
.bk-content {
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

.bk-loading {
  min-height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bk-loading-text {
  font-size: 26rpx;
  color: #7A7068;
}

/* 提示与无卡引导 */
.bk-alert {
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

.bk-alert-error {
  background: #FDF2F1;
  color: #9E2A2B;
  border: 1rpx solid #F5C6CB;
}

.bk-nocard {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid #E8D3BF;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
}

.bk-nocard-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8A5A32;
}

.bk-nocard-body {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #A2764F;
  line-height: 1.6;
}

/* 空状态 */
.bk-empty {
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx dashed rgba(140, 130, 123, 0.35);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-top: 30rpx;
}

.bk-empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1415;
}

.bk-empty-body {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8C827B;
}

/* ── 核心三栏课程卡片 ── */
.bk-list {
  display: flex;
  flex-direction: column;
}

.bk-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(28, 20, 21, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

/* 左栏：封面 */
.bk-card-cover-wrap {
  width: 156rpx;
  height: 196rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #EFE6DE;
}

.bk-card-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 中栏：标题、星级难度、导师 */
.bk-card-info {
  flex: 1;
  min-width: 0;
  height: 196rpx;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 6rpx 0;
  box-sizing: border-box;
}

.bk-card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1415;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.5rpx;
}

.bk-card-rating {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.bk-stars {
  display: inline-flex;
  gap: 2rpx;
}

.bk-star {
  font-size: 24rpx;
  line-height: 1;
}

.bk-star-gold {
  color: #C59A45;
}

.bk-star-gray {
  color: #D6CEC8;
}

.bk-remain-tag {
  font-size: 21rpx;
  color: #7A7068;
}

.bk-remain-full {
  color: #9E2A2B;
  font-weight: 600;
}

.bk-card-coach-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8C827B;
}

.bk-coach-name {
  font-weight: 500;
  color: #4A423D;
}

.bk-room-name {
  margin-left: 6rpx;
}

/* 右栏：大字时间与按钮 */
.bk-card-action {
  flex-shrink: 0;
  height: 196rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  padding: 6rpx 0;
  box-sizing: border-box;
  margin-left: 12rpx;
}

.bk-card-time {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1415;
  letter-spacing: -0.5rpx;
}

/* 按钮状态规范（曜黑胶囊底 / 预约红 / 灰色停用） */
.bk-btn {
  border-radius: 36rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.bk-btn:active {
  transform: scale(0.95);
}

.bk-btn-primary {
  padding: 12rpx 36rpx;
  background: #0D0C0F;
  color: #F6E6DA;
  box-shadow: 0 4rpx 14rpx rgba(13, 12, 15, 0.25);
}

.bk-btn-primary .bk-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.bk-btn-booked {
  padding: 10rpx 28rpx;
  background: #FDF2F1;
  color: #8A1F17;
  border: 1.5rpx solid #E0C9C5;
}

.bk-btn-booked .bk-btn-text {
  font-size: 22rpx;
  font-weight: 600;
}

.bk-btn-disabled {
  padding: 12rpx 32rpx;
  background: #EAE4DE;
  color: #A79E9A;
}

.bk-btn-disabled .bk-btn-text {
  font-size: 24rpx;
  font-weight: 500;
}

/* ── 我的近期预约待上课 ── */
.bk-my-section {
  margin-top: 36rpx;
  margin-bottom: 20rpx;
}

.bk-my-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.bk-my-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1415;
}

.bk-my-badge {
  font-size: 21rpx;
  color: #8C827B;
}

.bk-my-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.bk-my-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.bk-my-course {
  font-size: 27rpx;
  font-weight: 700;
  color: #1C1415;
}

.bk-my-meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8C827B;
}

.bk-my-cancel {
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid #E0C9C5;
  color: #8A1F17;
  font-size: 21rpx;
  background: #FDF2F1;
}

/* ── 底部安全间距，确保彻底避让自定义 TabBar ── */
.bk-bottom-space {
  height: calc(env(safe-area-inset-bottom) + 200rpx);
}
