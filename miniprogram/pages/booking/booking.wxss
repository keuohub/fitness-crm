/* pages/booking/booking.wxss · BRIEF_05 landing + list（v2.2 实拍：taupe 底、24rpx 圆角卡） */
page {
  background: #FDFCF9;
}
.bk-container {
  min-height: 100vh;
  background: #c9c3b9;
  color: #111111;
}
.bk-container--landing {
  background: #8a4450;
}

/* ========== landing ========== */
.bk-landing {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  overflow: hidden;
  background: #8a4450;
}
.bk-bg {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  opacity: 0;
  transition: opacity 400ms ease;
}
.bk-bg--on { opacity: 1; }
.bk-bg-solid {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: #8a4450;
  display: flex;
  align-items: flex-end;
  padding: 0 40rpx 560rpx;
  box-sizing: border-box;
}
.bk-bg-solid-text {
  font-size: 104rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #ffffff;
  letter-spacing: -1rpx;
}
/* 底部操作区轻柔微光保护，保证胶囊与白字清晰可读，不污染整张大片画质 */
.bk-landing-shade {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 480rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.28) 100%);
  pointer-events: none;
}
.bk-landing-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 40rpx;
  padding-right: 40rpx;
}
.bk-landing-brand-tag {
  font-family: -apple-system, sans-serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.7);
  text-transform: uppercase;
}
.bk-landing-title {
  display: none;
}
.bk-landing-link {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: #ffffff;
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 999rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
}
.bk-landing-bottom {
  position: absolute;
  z-index: 2;
  left: 0; right: 0;
  bottom: calc(104rpx + 64rpx + env(safe-area-inset-bottom));
}
.bk-cat-scroll {
  width: 100%;
  white-space: nowrap;
}
.bk-cat-row {
  display: inline-flex;
  align-items: flex-end;
  padding: 0 40rpx;
}
.bk-vcat {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 172rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.28);
  box-sizing: border-box;
  transition: all 240ms ease;
}
.bk-vcat-ch {
  font-size: 26rpx;
  line-height: 1.3;
  color: #ffffff;
  font-weight: 500;
}
.bk-vcat--on {
  background: #f6e3df;
  border-color: #f6e3df;
}
.bk-vcat--on .bk-vcat-ch { color: #C03438; }
.bk-vcat--on .bk-vcat-ch { font-weight: 700; }
.bk-landing-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 40rpx 0;
}
.bk-progress {
  width: 120rpx;
  display: flex;
  flex-direction: column;
}
.bk-progress--ghost { visibility: hidden; }
.bk-progress-line {
  width: 48rpx;
  height: 4rpx;
  background: #ffffff;
  margin-bottom: 8rpx;
}
.bk-progress-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  font-variant-numeric: tabular-nums;
}
.bk-landing-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #C03438;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bk-landing-btn:active { opacity: 0.85; }

/* ========== list ========== */
.bk-header-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #c9c3b9;
  padding-bottom: 8rpx;
}
.bk-navbar {
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  box-sizing: content-box;
}
.bk-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bk-back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #111111;
  border-bottom: 4rpx solid #111111;
  transform: rotate(45deg);
  margin-left: 8rpx;
}
.bk-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 16rpx 40rpx 0;
}
.bk-page-title {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5rpx;
  color: #111111;
  flex: 1;
  min-width: 0;
}
.bk-sub-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.bk-text-btn {
  font-size: 26rpx;
  color: #111111;
  padding: 12rpx 0 12rpx 28rpx;
  text-decoration: underline;
}
.bk-rule-text {
  display: block;
  padding: 8rpx 40rpx 0;
  font-size: 24rpx;
  color: #54555b;
}
.bk-cat-tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 16rpx;
}
.bk-cat-tabs {
  display: inline-flex;
  padding: 0 40rpx;
}
.bk-cat-tab {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  padding: 12rpx 0 16rpx;
}
.bk-cat-label {
  font-size: 28rpx;
  color: #54555b;
}
.bk-cat-active .bk-cat-label {
  color: #111111;
  font-weight: 700;
}
.bk-cat-line {
  position: absolute;
  bottom: 0;
  left: 0; right: 0;
  height: 4rpx;
  background: #111111;
}

.bk-content {
  padding: 16rpx 32rpx 0;
}

/* 课程介绍卡 */
.bk-intro {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}
.bk-intro-top {
  display: flex;
  align-items: center;
  padding: 24rpx;
  flex-wrap: wrap;
}
.bk-intro-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #F7ECEA;
}
.bk-intro-thumb--big {
  width: 100%;
  height: 360rpx;
  margin: 0 0 24rpx;
}
.bk-intro-head {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bk-intro-name {
  font-size: 32rpx;
  font-weight: 700;
}
.bk-intro-toggle {
  font-size: 24rpx;
  color: #54555b;
  text-decoration: underline;
}
.bk-intro-body {
  padding: 0 24rpx 32rpx;
  display: flex;
  flex-direction: column;
}
.bk-intro-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #54555b;
}
.bk-intro-cap {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8b90;
}

.bk-section-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  margin: 8rpx 8rpx 20rpx;
}

/* 日期条：白色圆角条带 */
.bk-dates-scroll {
  width: 100%;
  white-space: nowrap;
  background: #ffffff;
  border-radius: 24rpx;
  margin: 16rpx 0 20rpx;
}
.bk-dates-row {
  display: inline-flex;
  padding: 16rpx 8rpx 8rpx;
}
.bk-date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 92rpx;
}
.bk-date-weekday {
  font-size: 22rpx;
  color: #8a8b90;
}
.bk-date-daynum {
  font-size: 34rpx;
  font-weight: 600;
  color: #54555b;
  font-variant-numeric: tabular-nums;
  margin-top: 4rpx;
}
.bk-date-active .bk-date-weekday,
.bk-date-active .bk-date-daynum {
  color: #111111;
  font-weight: 700;
}
.bk-date-line,
.bk-date-dot,
.bk-date-placeholder {
  margin-top: 8rpx;
  height: 4rpx;
}
.bk-date-line { width: 40rpx; background: #111111; }
.bk-date-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #111111; margin-top: 6rpx; }
.bk-date-placeholder { width: 40rpx; }

/* 课程卡 */
.bk-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.bk-card:active { opacity: 0.9; }
.bk-card--ended { opacity: 0.55; }
.bk-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bk-card-tag {
  font-size: 22rpx;
  color: #54555b;
  background: #F7ECEA;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.bk-diff {
  display: flex;
  align-items: flex-end;
}
.bk-diff-label {
  font-size: 22rpx;
  color: #8a8b90;
  margin-right: 8rpx;
  line-height: 1;
}
.bk-diff-bars {
  display: flex;
  align-items: flex-end;
}
.bk-bar {
  width: 8rpx;
  margin-left: 4rpx;
  background: #d9d4cb;
  border-radius: 2rpx;
}
.bk-bar-0 { height: 12rpx; }
.bk-bar-1 { height: 18rpx; }
.bk-bar-2 { height: 24rpx; }
.bk-bar--on { background: #000000; }
.bk-card-name {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}
.bk-card-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #54555b;
}
.bk-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.bk-card-time {
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.bk-card-act {
  display: flex;
  align-items: center;
}
.bk-remain-warn {
  font-size: 22rpx;
  color: #c8501e;
  margin-right: 12rpx;
}
.bk-pill {
  height: 60rpx;
  line-height: 57rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1.5px solid #000000;
  font-size: 26rpx;
  color: #000000;
  box-sizing: border-box;
}
.bk-pill--dark { background: #000000; color: #ffffff; }
.bk-pill--muted { border-color: #d9d4cb; color: #8a8b90; }

/* 骨架 */
.bk-skeleton-list { padding-top: 8rpx; }
.bk-sk-card {
  height: 240rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  background: #F7ECEA;
}

.bk-bottom-space {
  height: calc(104rpx + 16rpx + env(safe-area-inset-bottom) + 40rpx);
}

/* 约课须知全量弹层 */
.bk-notice-modal {
  position: fixed;
  inset: 0;
  z-index: 995;
}

.bk-notice-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}

.bk-notice-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1px solid #e8e8e8;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 36rpx calc(env(safe-area-inset-bottom) + 32rpx);
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.bk-notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.bk-notice-head-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
}

.bk-notice-head-close {
  font-size: 32rpx;
  color: #54555b;
  padding: 8rpx 16rpx;
}

.bk-notice-scroll {
  max-height: 50vh;
  margin-bottom: 32rpx;
}

.bk-notice-modal-item {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #54555b;
}

.bk-notice-modal-num {
  font-family: var(--font-num);
  color: #999999;
  margin-right: 8rpx;
}

.bk-notice-modal-text {
  flex: 1;
}

.bk-notice-modal-btn {
  width: 100%;
}


/* 游客温馨提示条 */
.bk-guest-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #f6e3df;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.bk-guest-strip-text {
  font-size: 24rpx;
  color: #C03438;
}
.bk-guest-strip-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #C03438;
}

/* 游客登录引导卡 */
.bk-guest-card { background: #ffffff; border-radius: 24rpx; padding: 40rpx 32rpx; display: flex; flex-direction: column; align-items: flex-start; }
.bk-guest-title { font-size: 32rpx; font-weight: 600; color: #3a2a2d; }
.bk-guest-sub { margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; color: #7a6a6c; }
.bk-guest-btn { margin-top: 32rpx; height: 80rpx; line-height: 80rpx; padding: 0 56rpx; border-radius: 999rpx; background: #C03438; color: #ffffff; font-size: 28rpx; font-weight: 600; }

/* 当天课已全部结束的提示条 */
.bk-ended-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  margin-bottom: 18rpx;
  background: #FBF7F4;
  border: 1rpx dashed #E4D3CB;
  border-radius: 20rpx;
}

.bk-ended-text {
  font-size: 25rpx;
  color: #8A7C7E;
  letter-spacing: 0.5rpx;
}

.bk-ended-action {
  font-size: 25rpx;
  color: #8A3A48;
  letter-spacing: 0.5rpx;
}
