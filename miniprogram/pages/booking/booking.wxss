/* pages/booking/booking.wxss · 席位预约 · 私享礼遇与身体对话 */
/* 纯粹人手打磨 · 拒绝廉价AI卡片 · 杂志排版与呼吸感留白 */

.booking-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 40rpx) 36rpx calc(env(safe-area-inset-bottom) + 120rpx);
  animation: pageTransitIn 0.42s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes pageTransitIn {
  0% {
    opacity: 0;
    transform: translateY(16rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ================= 顶部返回与序言 (Editorial Header) ================= */
.editorial-header {
  margin-bottom: 48rpx;
}
.nav-back-row {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx 16rpx 0;
  transition: opacity 140ms ease;
}
.nav-back-row:active {
  opacity: 0.5;
}
.back-arrow {
  font-family: Georgia, serif;
  font-size: 34rpx;
  line-height: 1;
  color: #1C1415;
}
.back-label {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  color: rgba(28, 20, 21, 0.7);
  letter-spacing: 0.06em;
}

.header-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.header-roman {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.16em;
  color: #BA2428;
}
.header-dot {
  font-size: 18rpx;
  color: rgba(186, 36, 40, 0.4);
}
.header-cn-tag {
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 0.1em;
  color: rgba(28, 20, 21, 0.55);
}
.header-headline {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
  line-height: 1.3;
  margin-bottom: 12rpx;
}
.header-subhead {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(28, 20, 21, 0.65);
}

/* ================= 章节标签通用样式 (Chapter Headers) ================= */
.editorial-chapter {
  margin-bottom: 44rpx;
}
.chapter-label-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.chapter-num {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 24rpx;
  font-weight: 600;
  color: #BA2428;
}
.chapter-hairline {
  width: 24rpx;
  height: 1rpx;
  background: rgba(186, 36, 40, 0.35);
}
.chapter-name {
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.08em;
}

/* ================= 章节一：课程定制 (Course Selection) ================= */
.course-editorial-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.course-editorial-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 4rpx 16rpx rgba(186, 36, 40, 0.03);
  transition: transform 140ms ease, background-color 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
}
.course-editorial-card:active {
  transform: scale(0.985);
}
.course-index-col {
  width: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.course-roman {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(28, 20, 21, 0.35);
  transition: color 180ms ease;
}
.course-detail-col {
  flex: 1;
}
.course-name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.course-name-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
  transition: color 180ms ease;
}
.course-selected-mark {
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  color: #FFE5A3;
  letter-spacing: 0.06em;
}
.course-desc-text {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  color: rgba(28, 20, 21, 0.58);
  line-height: 1.5;
  transition: color 180ms ease;
}

/* 课程选中状态 · 曜黑深邃与微金雅致 */
.course-editorial-card.card-selected {
  background: #1C1415;
  border-color: rgba(255, 229, 163, 0.4);
  box-shadow: 0 10rpx 30rpx rgba(28, 20, 21, 0.22);
}
.course-editorial-card.card-selected .course-roman {
  color: #FFE5A3;
}
.course-editorial-card.card-selected .course-name-text {
  color: #FFFFFF;
}
.course-editorial-card.card-selected .course-desc-text {
  color: rgba(255, 255, 255, 0.72);
}

/* ================= 章节二：日期甄选 (Date Scroll) ================= */
.date-scroll-row {
  display: flex;
  gap: 14rpx;
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
}
.date-cell {
  flex-shrink: 0;
  width: 108rpx;
  height: 140rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 4rpx 14rpx rgba(186, 36, 40, 0.03);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 16rpx 8rpx;
  transition: all 160ms cubic-bezier(0.2, 0.8, 0.25, 1);
  position: relative;
}
.date-cell:active {
  transform: scale(0.95);
}
.date-weekday-label {
  font-family: "Songti SC", Georgia, serif;
  font-size: 21rpx;
  color: rgba(28, 20, 21, 0.52);
  margin-bottom: 6rpx;
  transition: color 160ms ease;
}
.date-day-num {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #1C1415;
  line-height: 1.1;
  transition: color 160ms ease;
}
.date-indicator-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #FFE5A3;
  margin-top: 6rpx;
}

/* 日期选中态 */
.date-cell.date-cell-active {
  background: #1C1415;
  border-color: rgba(255, 229, 163, 0.4);
  box-shadow: 0 8rpx 24rpx rgba(28, 20, 21, 0.25);
  transform: translateY(-2rpx);
}
.date-cell.date-cell-active .date-weekday-label {
  color: rgba(255, 255, 255, 0.65);
}
.date-cell.date-cell-active .date-day-num {
  color: #FFFFFF;
}

/* ================= 章节三：私享时段 (Time Slots Grid) ================= */
.time-grid-editorial {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}
.time-pill {
  height: 76rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 4rpx 14rpx rgba(186, 36, 40, 0.03);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 160ms ease;
}
.time-pill:active {
  transform: scale(0.97);
}
.time-text {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 24rpx;
  font-weight: 500;
  color: #1C1415;
  letter-spacing: 0.04em;
  transition: color 160ms ease;
}

/* 时段选中态 */
.time-pill.time-pill-active {
  background: #1C1415;
  border-color: rgba(255, 229, 163, 0.4);
  box-shadow: 0 8rpx 22rpx rgba(28, 20, 21, 0.22);
}
.time-pill.time-pill-active .time-text {
  color: #FFE5A3;
  font-weight: 600;
}

/* ================= 章节四：私享嘱咐信纸 (Stationery Notes) ================= */
.stationery-input-card {
  position: relative;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(186, 36, 40, 0.03);
  box-sizing: border-box;
}
.stationery-textarea {
  width: 100%;
  height: 150rpx;
  box-sizing: border-box;
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  line-height: 1.7;
  color: #1C1415;
}
.textarea-placeholder {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  color: rgba(28, 20, 21, 0.4);
}
.textarea-corner-seal {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 1.5rpx solid rgba(186, 36, 40, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.seal-mark {
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
  color: #BA2428;
}

/* ================= 章节五：预约提交与礼遇保障 (Submit & Guarantee) ================= */
.submit-section {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.btn-editorial-submit {
  width: 100%;
  height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  background: #1C1415;
  border: 1.5rpx solid rgba(255, 229, 163, 0.35);
  box-shadow: 0 12rpx 32rpx rgba(28, 20, 21, 0.28);
  transition: transform 140ms ease, opacity 140ms ease;
  padding: 0;
}
.btn-editorial-submit:active {
  transform: scale(0.98);
}
.btn-editorial-submit[disabled] {
  opacity: 0.38;
  box-shadow: none;
  border-color: rgba(28, 20, 21, 0.1);
}
.btn-submit-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 27rpx;
  font-weight: 600;
  color: #FFE5A3;
  letter-spacing: 0.12em;
}

.atelier-guarantee {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 0 16rpx;
}
.guarantee-icon {
  font-size: 18rpx;
  color: #BA2428;
}
.guarantee-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  color: rgba(28, 20, 21, 0.48);
  letter-spacing: 0.04em;
  text-align: center;
  line-height: 1.5;
}
