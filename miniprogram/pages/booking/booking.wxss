/* pages/booking/booking.wxss
   徕舞女子塑形 · 会员约课系统
   静奢燕麦象牙底色 #F7F4EE / 沉檀木黑 #231F1D / 陶赭朱砂 #9B4A3F / 柔润岩灰 #E6E0D6
   吸顶分类与周历 · 黄金三栏图文排版 · 移动端高屏效与触控工学
   ============================================================ */

page {
  background-color: #F7F4EE;
  color: #231F1D;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.bk-container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 顶部吸顶区域（导航栏 + 分类Tab + 单行周历） ── */
.bk-header-sticky {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(247, 244, 238, 0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid #E6E0D6;
}

/* 自定义导航标题（避让灵动岛） */
.bk-navbar {
  padding-top: env(safe-area-inset-top);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.bk-nav-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #231F1D;
}

/* 一级分类导航 Tab */
.bk-cat-tabs {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8rpx 20rpx 14rpx;
}

.bk-cat-tab {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
}

.bk-cat-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #7A7068;
  letter-spacing: 0.5rpx;
  transition: color 0.2s ease;
}

.bk-cat-active .bk-cat-label {
  color: #231F1D;
  font-weight: 600;
}

.bk-cat-bar {
  margin-top: 8rpx;
  width: 36rpx;
  height: 5rpx;
  background: #9B4A3F;
  border-radius: 4rpx;
}

/* 单行周历横滑条 */
.bk-dates-scroll {
  white-space: nowrap;
  padding: 8rpx 0 20rpx;
}

.bk-dates-row {
  display: inline-flex;
  padding-left: 28rpx;
  padding-right: 16rpx;
}

.bk-date-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 118rpx;
  margin-right: 14rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E6E0D6;
  box-shadow: 0 2rpx 8rpx rgba(35, 31, 29, 0.02);
  transition: all 0.2s cubic-bezier(0.2, 0.8, 0.25, 1);
}

.bk-date-pill:active {
  transform: scale(0.96);
}

.bk-date-weekday {
  font-size: 21rpx;
  font-weight: 500;
  color: #7A7068;
}

.bk-date-daynum {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #231F1D;
}

/* 选中高亮日期：沉檀木黑胶囊底 + 陶赭朱砂微点 */
.bk-date-active {
  background: #231F1D !important;
  border-color: #231F1D !important;
  box-shadow: 0 8rpx 20rpx rgba(35, 31, 29, 0.2);
}

.bk-date-active .bk-date-weekday,
.bk-date-active .bk-date-daynum {
  color: #F7F4EE !important;
}

.bk-date-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #9B4A3F;
  margin-top: 6rpx;
}

/* ── 内容区域 ── */
.bk-content {
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

.bk-loading {
  min-height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bk-loading-text {
  font-size: 26rpx;
  color: #7A7068;
}

/* 提示与无卡引导 */
.bk-alert {
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

.bk-alert-error {
  background: #FDF2F1;
  color: #9B4A3F;
  border: 1rpx solid #E8C8C5;
}

.bk-nocard {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E6E0D6;
  box-shadow: 0 4rpx 14rpx rgba(35, 31, 29, 0.03);
}

.bk-nocard-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #9B4A3F;
  letter-spacing: 0.5rpx;
}

.bk-nocard-body {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7A7068;
  line-height: 1.6;
}

/* 空状态 */
.bk-empty {
  background: #FFFFFF;
  border: 1rpx dashed #D9D2C7;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-top: 30rpx;
}

.bk-empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #231F1D;
}

.bk-empty-body {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8C827B;
}

/* ── 核心三栏课程卡片：舒展防挤压排版 ── */
.bk-list {
  display: flex;
  flex-direction: column;
}

.bk-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(35, 31, 29, 0.035);
  border: 1rpx solid #E6E0D6;
}

/* 左栏：封面 */
.bk-card-cover-wrap {
  width: 148rpx;
  height: 188rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #F7F4EE;
  border: 1rpx solid #F0ECE4;
}

.bk-card-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 中栏：标题、星级难度、导师 */
.bk-card-info {
  flex: 1;
  min-width: 0;
  height: 188rpx;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.bk-card-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #231F1D;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.5rpx;
}

.bk-card-rating {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.bk-stars {
  display: inline-flex;
  gap: 2rpx;
}

.bk-star {
  font-size: 22rpx;
  line-height: 1;
}

.bk-star-gold {
  color: #C59A45;
}

.bk-star-gray {
  color: #E2DDD6;
}

.bk-remain-tag {
  font-size: 20rpx;
  color: #7A7068;
  background: #F7F4EE;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.bk-remain-full {
  color: #9B4A3F;
  background: rgba(155, 74, 63, 0.08);
  font-weight: 500;
}

.bk-card-coach-row {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #7A7068;
}

.bk-coach-name {
  font-weight: 500;
  color: #231F1D;
}

.bk-room-name {
  margin-left: 6rpx;
}

/* 右栏：大字时间与按钮 */
.bk-card-action {
  flex-shrink: 0;
  height: 188rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  padding: 4rpx 0;
  box-sizing: border-box;
  margin-left: 14rpx;
}

.bk-card-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #231F1D;
  letter-spacing: -0.5rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Cinzel", "Plus Jakarta Sans", sans-serif;
}

/* 按钮状态规范（陶赭朱砂底 / 预约红 / 灰色停用） */
.bk-btn {
  border-radius: 36rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.bk-btn:active {
  transform: scale(0.95);
}

.bk-btn-primary {
  padding: 12rpx 32rpx;
  background: #9B4A3F;
  color: #F7F4EE;
  box-shadow: 0 4rpx 14rpx rgba(155, 74, 63, 0.25);
}

.bk-btn-primary .bk-btn-text {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1.5rpx;
}

.bk-btn-booked {
  padding: 10rpx 26rpx;
  background: rgba(155, 74, 63, 0.08);
  color: #9B4A3F;
  border: 1.5rpx solid rgba(155, 74, 63, 0.25);
}

.bk-btn-booked .bk-btn-text {
  font-size: 22rpx;
  font-weight: 600;
}

.bk-btn-disabled {
  padding: 12rpx 30rpx;
  background: #EFEBE4;
  color: #A8A099;
}

.bk-btn-disabled .bk-btn-text {
  font-size: 23rpx;
  font-weight: 500;
}

/* ── 我的近期预约待上课 ── */
.bk-my-section {
  margin-top: 36rpx;
  margin-bottom: 20rpx;
}

.bk-my-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.bk-my-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #231F1D;
  letter-spacing: 0.5rpx;
}

.bk-my-badge {
  font-size: 21rpx;
  color: #7A7068;
}

.bk-my-card {
  background: #FFFFFF;
  border: 1rpx solid #E6E0D6;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(35, 31, 29, 0.025);
}

.bk-my-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.bk-my-course {
  font-size: 27rpx;
  font-weight: 600;
  color: #231F1D;
}

.bk-my-meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #7A7068;
}

.bk-my-cancel {
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(155, 74, 63, 0.3);
  color: #9B4A3F;
  font-size: 21rpx;
  background: rgba(155, 74, 63, 0.06);
}

/* ── 底部安全间距，确保彻底避让自定义 TabBar ── */
.bk-bottom-space {
  height: calc(env(safe-area-inset-bottom) + 200rpx);
}
