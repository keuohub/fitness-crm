<view class="bk-page">

  <view wx:if="{{loading}}" class="bk-loading">
    <text class="bk-loading-text">正在打开课表…</text>
  </view>

  <block wx:else>
    <view class="bk-hero">
      <text class="bk-eyebrow">BOOK A SESSION</text>
      <text class="bk-title">预约课程</text>
      <text class="bk-sub">选一天，选一节课。名额以实时余位为准。</text>
    </view>

    <view wx:if="{{error}}" class="bk-error"><text>{{error}}</text></view>

    <scroll-view class="bk-dates" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view
        wx:for="{{dates}}"
        wx:key="value"
        class="bk-date {{selectedDate === item.value ? 'bk-date-active' : ''}}"
        data-date="{{item.value}}"
        bindtap="selectDate"
      >
        <text class="bk-date-week">{{item.weekday}}</text>
        <text class="bk-date-day">{{item.day}}</text>
      </view>
    </scroll-view>

    <view class="bk-section">
      <view class="bk-section-head">
        <text class="bk-section-title">当日课表</text>
        <text class="bk-section-note">{{shownSessions.length}} 节</text>
      </view>

      <view wx:if="{{shownSessions.length === 0}}" class="bk-empty">
        <text class="bk-empty-title">这一天还没有排课</text>
        <text class="bk-empty-body">换一天看看，或联系小桥。</text>
      </view>

      <view wx:for="{{shownSessions}}" wx:key="id" class="bk-session">
        <view class="bk-session-top">
          <view class="bk-session-time">
            <text class="bk-time-start">{{item.startTime}}</text>
            <text class="bk-time-end">{{item.endTime}}</text>
          </view>
          <view class="bk-session-main">
            <text class="bk-course">{{item.courseName}}</text>
            <text class="bk-meta">{{item.coachName || '教练待定'}}{{item.roomName ? ' · ' + item.roomName : ''}}</text>
          </view>
          <text class="bk-remain {{item.remaining === 0 ? 'bk-remain-full' : ''}}">{{item.remaining === 0 ? '已满' : '余 ' + item.remaining}}</text>
        </view>
        <view class="bk-session-bottom">
          <text class="bk-capacity">容量 {{item.capacity}} 人</text>
          <view wx:if="{{item.bookedByMe}}" class="bk-booked">
            <text class="bk-booked-text">已预约</text>
            <view class="bk-cancel-mini" data-id="{{item.bookingId}}" bindtap="cancel">取消</view>
          </view>
          <view wx:elif="{{item.remaining > 0}}" class="bk-book-btn" data-id="{{item.id}}" bindtap="reserve">预约</view>
          <view wx:else class="bk-book-disabled">已满</view>
        </view>
      </view>
    </view>

    <view class="bk-section" wx:if="{{myBookings.length > 0}}">
      <view class="bk-section-head">
        <text class="bk-section-title">我的预约</text>
        <text class="bk-section-note">待上课</text>
      </view>
      <view wx:for="{{myBookings}}" wx:key="id" class="bk-my-item">
        <view class="bk-my-main">
          <text class="bk-my-course">{{item.courseName}}</text>
          <text class="bk-my-meta">{{item.date}} · {{item.time}}{{item.coachName ? ' · ' + item.coachName : ''}}</text>
        </view>
        <view class="bk-cancel-btn" data-id="{{item.id}}" bindtap="cancel">取消</view>
      </view>
    </view>

    <view class="bk-bottom-space"></view>
  </block>
</view>
