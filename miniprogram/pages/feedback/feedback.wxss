/* pages/feedback/feedback.wxss - 小桥来信 · 私享手札 */

page {
  background-color: #FDFCF9;
  color: var(--c-text, #222222);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}

.feedback-container {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 96rpx) 32rpx calc(env(safe-area-inset-bottom) + 160rpx);
  box-sizing: border-box;
}

.loading {
  padding: 160rpx 0;
  text-align: center;
}

.loading-text {
  font-family: var(--font-sans);
  font-size: var(--fs-sub, 26rpx);
  color: var(--c-muted, #666666);
  letter-spacing: 0;
}

/* ================= 章节引言：小桥来信 ================= */
.epistle-header {
  padding: 8rpx 0 32rpx;
}

.epistle-chapter-tag {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.chapter-label {
  font-size: var(--fs-micro, 22rpx);
  font-weight: 500;
  color: var(--c-muted, #666666);
  letter-spacing: 0;
}

.epistle-hero-title {
  display: block;
  font-family: var(--font-sans);
  font-size: var(--fs-h1, 40rpx);
  font-weight: 700;
  color: var(--c-title, #000000);
  letter-spacing: 0;
  line-height: 1.2;
  margin-bottom: 10rpx;
}

.epistle-hero-subtitle {
  display: block;
  font-size: var(--fs-caption, 24rpx);
  color: var(--c-muted, #666666);
  line-height: 1.6;
  letter-spacing: 0;
}

/* ================= 章节公共区块 ================= */
.epistle-section {
  margin-bottom: 40rpx;
}

.epistle-section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.section-title {
  font-family: var(--font-sans);
  font-size: var(--fs-h3, 30rpx);
  font-weight: 700;
  color: var(--c-title, #000000);
  letter-spacing: 0;
}

.section-postmark {
  font-size: var(--fs-micro, 22rpx);
  letter-spacing: 0;
  color: var(--c-hint, #999999);
}

/* 极细发丝分隔线 */
.editorial-hairline {
  height: 1rpx;
  margin: 32rpx 0;
  background: var(--c-line, #ece7df);
}

/* ================= 最新一封手札信笺 ================= */
.stationery-letter-sheet {
  background: var(--c-card-soft, #efeae2);
  border-radius: 0;
  border: none;
  box-shadow: none;
  box-sizing: border-box;
  padding: 36rpx 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.letter-top-crimson-line {
  display: none;
}

/* 元信息条 */
.letter-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.letter-type-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.tag-point {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--c-title, #000000);
}

.tag-text {
  font-family: var(--font-sans);
  font-size: var(--fs-micro, 22rpx);
  font-weight: 600;
  color: var(--c-title, #000000);
  letter-spacing: 0;
}

.letter-postmark-date {
  font-family: var(--font-num);
  font-size: var(--fs-micro, 22rpx);
  color: var(--c-hint, #999999);
  letter-spacing: 0;
}

/* 信笺正文 */
.letter-body-text {
  margin-bottom: 24rpx;
}

.letter-summary {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--fs-sub, 26rpx);
  line-height: 1.85;
  color: var(--c-text, #222222);
  letter-spacing: 0;
}

.letter-full {
  display: block;
  font-size: var(--fs-sub, 26rpx);
  line-height: 1.85;
  color: var(--c-text, #222222);
  letter-spacing: 0;
  white-space: pre-wrap;
}

/* 专属印鉴与落款 */
.letter-sign-block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--c-line, #ece7df);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.sign-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sign-role {
  font-size: var(--fs-micro, 22rpx);
  color: var(--c-muted, #666666);
  letter-spacing: 0;
}

.sign-author {
  font-family: var(--font-sans);
  font-size: var(--fs-caption, 24rpx);
  font-weight: 600;
  color: var(--c-title, #000000);
  letter-spacing: 0;
}

.letter-seal-stamp {
  width: 60rpx;
  height: 60rpx;
  border-radius: 0;
  border: 1px solid var(--c-line, #ece7df);
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seal-text {
  font-size: 16rpx;
  line-height: 1.2;
  font-weight: 600;
  color: var(--c-title, #000000);
  text-align: center;
}

/* 折叠/展开按键 */
.letter-toggle-row {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.letter-toggle-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
}

.toggle-text {
  font-size: var(--fs-micro, 22rpx);
  color: var(--c-muted, #666666);
  letter-spacing: 0;
}

.toggle-icon {
  font-size: 18rpx;
  color: var(--c-hint, #999999);
}

/* 直达私享便签 */
.letter-action-bar {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--c-line, #ece7df);
}

.action-trigger-btn {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 16rpx 20rpx;
  border-radius: 0;
  background: #ffffff;
  border: 1px solid var(--c-line, #ece7df);
}

.action-trigger-btn:active {
  opacity: 0.85;
}

.action-spark {
  font-size: 18rpx;
  color: var(--c-title, #000000);
}

.action-txt {
  flex: 1;
  font-size: var(--fs-caption, 24rpx);
  font-weight: 500;
  color: var(--c-text, #222222);
  letter-spacing: 0;
  margin-left: 10rpx;
}

/* ================= 章节二：蜕变时光轴 ================= */
.timeline-spine-card {
  padding: 32rpx;
  border-radius: 0;
  background: var(--c-card-soft, #efeae2);
  border: none;
  box-shadow: none;
}

.milestone-spine-item {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.spine-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
  flex-shrink: 0;
  padding-top: 8rpx;
}

.spine-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #cccccc;
  box-sizing: border-box;
}

.milestone-spine-item.milestone-done .spine-dot,
.milestone-spine-item.milestone-active .spine-dot {
  background: #000000;
  border-color: #000000;
}

.spine-line {
  flex: 1;
  width: 2rpx;
  min-height: 48rpx;
  background: var(--c-line, #ece7df);
  margin: 8rpx 0;
}

.milestone-info {
  flex: 1;
  padding-bottom: 32rpx;
}

.milestone-spine-item:last-child .milestone-info {
  padding-bottom: 0;
}

.milestone-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.milestone-name {
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-title, #000000);
  letter-spacing: 0;
}

.milestone-status-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
  letter-spacing: 0;
}

.status-done {
  color: #000000;
  background: #ece7df;
  font-weight: 600;
}

.status-ongoing {
  color: #000000;
  font-weight: 600;
}

.status-locked {
  color: var(--c-hint, #999999);
}

.milestone-narrative {
  display: block;
  font-size: var(--fs-micro, 22rpx);
  line-height: 1.6;
  color: var(--c-muted, #666666);
}

/* ================= 章节三：过往手札珍藏 ================= */
.history-epistles-list {
  display: flex;
  flex-direction: column;
}

.history-epistle-card {
  padding: 28rpx;
  border-radius: 0;
  background: var(--c-card-soft, #efeae2);
  border: none;
  box-shadow: none;
}

.history-epistle-card:active {
  opacity: 0.9;
}

.history-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-type-label {
  font-family: var(--font-sans);
  font-size: var(--fs-micro, 22rpx);
  font-weight: 600;
  color: var(--c-title, #000000);
}

.history-date {
  font-family: var(--font-num);
  font-size: var(--fs-micro, 22rpx);
  color: var(--c-hint, #999999);
}

.history-summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--fs-caption, 24rpx);
  line-height: 1.7;
  color: var(--c-text, #222222);
}

.history-full {
  display: block;
  font-size: var(--fs-caption, 24rpx);
  line-height: 1.75;
  color: var(--c-text, #222222);
  white-space: pre-wrap;
}

.history-toggle-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  margin-top: 14rpx;
}

.history-toggle-txt {
  font-size: var(--fs-micro, 22rpx);
  color: var(--c-title, #000000);
}

.history-toggle-arrow {
  font-size: 18rpx;
  color: var(--c-title, #000000);
}

.history-item-hairline {
  height: 1rpx;
  margin: 16rpx 0;
  background: var(--c-line, #ece7df);
}

/* 空状态 */
.epistle-empty-state {
  padding: 60rpx 36rpx;
  border-radius: 0;
  background: var(--c-card-soft, #efeae2);
  border: none;
  text-align: center;
}

.empty-seal-stamp {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 20rpx;
  border-radius: 0;
  border: 1px solid var(--c-title, #000000);
  color: var(--c-title, #000000);
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-lead {
  display: block;
  font-family: var(--font-sans);
  font-size: var(--fs-body, 28rpx);
  font-weight: 600;
  color: var(--c-title, #000000);
  margin-bottom: 8rpx;
}

.empty-caption {
  display: block;
  font-size: var(--fs-micro, 22rpx);
  color: var(--c-muted, #666666);
  margin-bottom: 24rpx;
}

.empty-divider {
  width: 60rpx;
  height: 1rpx;
  background: var(--c-line, #ece7df);
  margin: 0 auto 16rpx;
}

.empty-sign {
  font-size: var(--fs-micro, 22rpx);
  color: var(--c-hint, #999999);
}
