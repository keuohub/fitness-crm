/* ==========================================================================
   pages/feedback/feedback.wxss - 小桥来信 · 私享手札 (The Private Epistles)
   艺术纸张质感、温润排印、手札信笺与体态蜕变时光轴
   ========================================================================== */

.feedback-container {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 96rpx) 40rpx calc(env(safe-area-inset-bottom) + 260rpx);
  box-sizing: border-box;
  animation: pageTransitIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.loading {
  padding: 160rpx 0;
  text-align: center;
}
.loading-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 2rpx;
}

/* ================= 章节引言：小桥来信 (Epistle Header) ================= */
.epistle-header {
  padding: 8rpx 0 40rpx;
}
.epistle-chapter-tag {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 8rpx;
}
.chapter-code {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 20rpx;
  font-weight: 600;
  color: #FFE5A3;
  letter-spacing: 0.14em;
}
.chapter-dot {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.35);
  margin: 0 2rpx;
}
.chapter-label {
  font-size: 19rpx;
  font-weight: 500;
  color: rgba(255, 245, 240, 0.65);
  letter-spacing: 0.15em;
  text-transform: uppercase;
}
.epistle-hero-title {
  display: block;
  font-family: "Songti SC", Georgia, "PingFang SC", serif;
  font-size: 50rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
  line-height: 1.2;
  margin-bottom: 10rpx;
}
.epistle-hero-subtitle {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  color: rgba(28, 20, 21, 0.62);
  line-height: 1.6;
  letter-spacing: 0.03em;
}

/* ================= 章节公共区块 ================= */
.epistle-section {
  margin-bottom: 48rpx;
}
.epistle-section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 22rpx;
}
.header-left {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.section-chapter-num {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFE5A3;
  letter-spacing: 0.08em;
}
.section-title {
  font-family: "Songti SC", Georgia, serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.06em;
}
.section-postmark {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: rgba(28, 20, 21, 0.45);
  text-transform: uppercase;
}

/* 极细发丝分隔律动线 */
.editorial-hairline {
  height: 1rpx;
  margin: 52rpx 0;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.25) 50%, rgba(255, 255, 255, 0.04) 100%);
}

/* ================= 最新一封手札信笺 (Stationery Letter Sheet) ================= */
.stationery-letter-sheet {
  background: rgba(255, 255, 255, 0.76);
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 48rpx rgba(186, 36, 40, 0.06), 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
  padding: 44rpx 36rpx 36rpx;
  position: relative;
  overflow: hidden;
  transition: transform 140ms ease;
}
.stationery-letter-sheet:active {
  transform: scale(0.995);
}

/* 顶部流金朱红发丝边缘 */
.letter-top-crimson-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #BA2428 0%, #E58572 60%, rgba(186, 36, 40, 0.3) 100%);
}

/* 典雅引用暗纹水印 */
.letter-watermark {
  position: absolute;
  top: 16rpx;
  right: 28rpx;
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 130rpx;
  line-height: 1;
  color: rgba(186, 36, 40, 0.06);
  pointer-events: none;
  font-weight: 700;
}

/* 元信息条 */
.letter-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 2;
}
.letter-type-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.tag-point {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #BA2428;
}
.tag-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #BA2428;
  letter-spacing: 0.08em;
}
.letter-postmark-date {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 22rpx;
  color: rgba(28, 20, 21, 0.52);
  letter-spacing: 0.06em;
}

/* 信笺正文 */
.letter-body-text {
  margin-bottom: 24rpx;
  position: relative;
  z-index: 2;
}
.letter-summary {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  line-height: 1.85;
  color: #241D1E;
  letter-spacing: 0.03em;
}
.letter-full {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  line-height: 1.85;
  color: #241D1E;
  letter-spacing: 0.03em;
  white-space: pre-wrap;
}

/* 专属印鉴与落款 */
.letter-sign-block {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(28, 20, 21, 0.12);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.sign-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.sign-role {
  font-size: 20rpx;
  color: rgba(28, 20, 21, 0.48);
  letter-spacing: 0.08em;
}
.sign-author {
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
}
.letter-seal-stamp {
  width: 68rpx;
  height: 68rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(186, 36, 40, 0.85);
  background: rgba(186, 36, 40, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-8deg);
  box-shadow: 0 4rpx 14rpx rgba(186, 36, 40, 0.15);
}
.seal-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 17rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #BA2428;
  text-align: center;
  letter-spacing: 1rpx;
}

/* 折叠/展开按键 */
.letter-toggle-row {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}
.letter-toggle-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
}
.toggle-text {
  font-size: 21rpx;
  color: rgba(28, 20, 21, 0.52);
  letter-spacing: 0.06em;
}
.toggle-icon {
  font-size: 18rpx;
  color: rgba(28, 20, 21, 0.45);
}

/* 直达私享便签 */
.letter-action-bar {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(28, 20, 21, 0.06);
}
.action-trigger-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(186, 36, 40, 0.06);
  border: 1rpx solid rgba(186, 36, 40, 0.15);
  transition: transform 140ms ease;
}
.action-trigger-btn:active {
  transform: scale(0.98);
}
.action-spark {
  font-size: 18rpx;
  color: #BA2428;
}
.action-txt {
  flex: 1;
  font-family: "Songti SC", Georgia, serif;
  font-size: 23rpx;
  font-weight: 600;
  color: #BA2428;
  letter-spacing: 0.04em;
  margin-left: 10rpx;
}
.action-arrow {
  font-size: 22rpx;
  color: #BA2428;
}

/* ================= 章节二：蜕变时光轴 (Timeline Spine Card) ================= */
.timeline-spine-card {
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 32rpx rgba(28, 20, 21, 0.04);
}
.milestone-spine-item {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}
.spine-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 44rpx;
  flex-shrink: 0;
}
.spine-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(28, 20, 21, 0.08);
  border: 1.5rpx solid rgba(28, 20, 21, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 200ms ease;
}
.dot-text {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 19rpx;
  font-weight: 600;
  color: rgba(28, 20, 21, 0.45);
}
.milestone-spine-item.milestone-done .spine-dot {
  background: #BA2428;
  border-color: #BA2428;
  box-shadow: 0 4rpx 14rpx rgba(186, 36, 40, 0.35);
}
.milestone-spine-item.milestone-done .dot-text {
  color: #FFFFFF;
}
.milestone-spine-item.milestone-active .spine-dot {
  background: rgba(28, 20, 21, 0.9);
  border-color: #FFE5A3;
  box-shadow: 0 4rpx 14rpx rgba(28, 20, 21, 0.25);
}
.milestone-spine-item.milestone-active .dot-text {
  color: #FFE5A3;
}
.spine-line {
  flex: 1;
  width: 2rpx;
  min-height: 52rpx;
  background: rgba(28, 20, 21, 0.12);
  margin: 8rpx 0;
}
.milestone-info {
  flex: 1;
  padding-bottom: 36rpx;
}
.milestone-spine-item:last-child .milestone-info {
  padding-bottom: 0;
}
.milestone-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.milestone-name {
  font-family: "Songti SC", Georgia, serif;
  font-size: 27rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
}
.milestone-status-badge {
  font-size: 19rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  letter-spacing: 0.04em;
}
.status-done {
  color: #BA2428;
  background: rgba(186, 36, 40, 0.08);
}
.status-ongoing {
  color: #BA2428;
  font-weight: 600;
}
.status-locked {
  color: rgba(28, 20, 21, 0.38);
}
.milestone-narrative {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(28, 20, 21, 0.62);
}

/* ================= 章节三：过往手札珍藏 (History Epistles) ================= */
.history-epistles-list {
  display: flex;
  flex-direction: column;
}
.history-epistle-card {
  padding: 28rpx 28rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 6rpx 18rpx rgba(186, 36, 40, 0.03);
  transition: transform 140ms ease;
}
.history-epistle-card:active {
  transform: scale(0.99);
}
.history-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.history-type-label {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #BA2428;
}
.history-date {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 21rpx;
  color: rgba(28, 20, 21, 0.45);
}
.history-summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(28, 20, 21, 0.8);
}
.history-full {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  line-height: 1.75;
  color: rgba(28, 20, 21, 0.88);
  white-space: pre-wrap;
}
.history-toggle-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  margin-top: 14rpx;
}
.history-toggle-txt {
  font-size: 20rpx;
  color: #BA2428;
}
.history-toggle-arrow {
  font-size: 18rpx;
  color: #BA2428;
}
.history-item-hairline {
  height: 1rpx;
  margin: 18rpx 0;
  background: rgba(28, 20, 21, 0.06);
}

/* 空状态 */
.epistle-empty-state {
  padding: 60rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx dashed rgba(186, 36, 40, 0.22);
  text-align: center;
}
.empty-seal-stamp {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 20rpx;
  border-radius: 8rpx;
  border: 2rpx solid #BA2428;
  color: #BA2428;
  font-family: "Songti SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-lead {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1415;
  margin-bottom: 8rpx;
}
.empty-caption {
  display: block;
  font-size: 22rpx;
  color: rgba(28, 20, 21, 0.58);
  margin-bottom: 24rpx;
}
.empty-divider {
  width: 60rpx;
  height: 1rpx;
  background: rgba(28, 20, 21, 0.15);
  margin: 0 auto 16rpx;
}
.empty-sign {
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  color: rgba(28, 20, 21, 0.42);
}
