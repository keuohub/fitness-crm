<view class="feedback-container">
  
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">正在呈递手札...</text>
  </view>

  <!-- 错误 -->
  <view wx:elif="{{error}}" class="empty-state">
    <text class="empty-title">{{error}}</text>
  </view>

  <!-- 正常内容 -->
  <block wx:else>

    <!-- 引导语 -->
    <view class="guide stagger-1">
      <view class="guide-tag-wrap">
        <text class="guide-pill">✦ 专属私教手札</text>
      </view>
      <text class="guide-label">小桥来信</text>
      <text class="guide-subtitle">见字如面 · 每一寸改变，我都替你珍藏</text>
    </view>

    <!-- 最新手札信纸大卡片 -->
    <view wx:if="{{latestFeedback}}" class="section stagger-2">
      <view class="section-header-row">
        <text class="section-title">最新一封</text>
        <text class="section-badge">专属于你</text>
      </view>
      <view class="latest-card letter-paper" bindtap="toggleLatest">
        <!-- 信笺装饰暗纹与引用符号 -->
        <text class="letter-watermark">“</text>
        <view class="paper-top-border"></view>

        <!-- 卡片头部元信息 -->
        <view class="card-header">
          <view class="type-pill-luxury">
            <text class="pill-dot"></text>
            <text class="pill-label">{{latestFeedback.typeLabel}}</text>
          </view>
          <text class="card-date">{{latestFeedback.date}}</text>
        </view>

        <!-- 信笺正文 -->
        <view class="letter-body">
          <text class="card-summary" wx:if="{{!latestExpanded}}">{{latestFeedback.summary}}</text>
          <text class="card-full" wx:if="{{latestExpanded}}">{{latestFeedback.content}}</text>
        </view>

        <!-- 专属私教印鉴与落款 (展开时展示) -->
        <view class="letter-sign-block" wx:if="{{latestExpanded}}">
          <view class="sign-left">
            <text class="sign-role">你的专属导师</text>
            <text class="sign-author">小桥 · 徕舞女性体态手札</text>
          </view>
          <view class="letter-seal-stamp">
            <text class="seal-text">徕舞私享</text>
          </view>
        </view>

        <!-- 折叠/展开按键 -->
        <view class="card-toggle">
          <view class="toggle-pill">
            <text class="toggle-label">{{latestExpanded ? "收起手札" : "展阅完整手札"}}</text>
            <text class="toggle-arrow">{{latestExpanded ? "▴" : "▾"}}</text>
          </view>
        </view>

        <!-- 交互操作条 (直达私享便签，防冒泡) -->
        <view class="letter-action-bar">
          <view class="action-btn-single" catchtap="goToFeeling">
            <text class="action-icon">✦</text>
            <text class="action-txt">给小桥写便签回音 · 记录今日体感</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 「自律长跑 · 蜕变时光轴」消除空白赤贫感 -->
    <view class="section stagger-3 timeline-section">
      <view class="section-header-row">
        <text class="section-title">自律长跑 · 蜕变时光轴</text>
        <text class="section-badge">相伴 {{joinDays}} 天</text>
      </view>
      <view class="timeline-card">
        <view class="timeline-track"></view>

        <!-- 里程碑 1 -->
        <view class="milestone-item milestone-done">
          <view class="milestone-dot"><text class="dot-inner">✓</text></view>
          <view class="milestone-content">
            <view class="milestone-head">
              <text class="milestone-title">初见测评 · 身体建档</text>
              <text class="milestone-status status-done">已启程</text>
            </view>
            <text class="milestone-desc">完成身体多维问卷与静态评估，已定制专属三阶蜕变手札与呼吸复位路径。</text>
          </view>
        </view>

        <!-- 里程碑 2 -->
        <view class="milestone-item {{trainCount >= 10 ? 'milestone-done' : 'milestone-active'}}">
          <view class="milestone-dot"><text class="dot-inner">{{trainCount >= 10 ? '✓' : '2'}}</text></view>
          <view class="milestone-content">
            <view class="milestone-head">
              <text class="milestone-title">第 10 节 · 核心觉知与体态复位</text>
              <text class="milestone-status {{trainCount >= 10 ? 'status-done' : 'status-ongoing'}}">
                {{trainCount >= 10 ? '已达成' : (trainCount > 0 ? '进行中 ' + trainCount + '/10节' : '待开启')}}
              </text>
            </view>
            <text class="milestone-desc">横膈膜呼吸与核心床深层唤醒，骨盆中立位回弹，卸下日常耸肩与腰椎代偿。</text>
          </view>
        </view>

        <!-- 里程碑 3 -->
        <view class="milestone-item {{trainCount >= 30 ? 'milestone-done' : (trainCount >= 10 ? 'milestone-active' : 'milestone-locked')}}">
          <view class="milestone-dot"><text class="dot-inner">{{trainCount >= 30 ? '✓' : '3'}}</text></view>
          <view class="milestone-content">
            <view class="milestone-head">
              <text class="milestone-title">第 30 节 · 线条精雕与体态升华</text>
              <text class="milestone-status {{trainCount >= 30 ? 'status-done' : (trainCount >= 10 ? 'status-ongoing' : 'status-locked')}}">
                {{trainCount >= 30 ? '已达成' : (trainCount >= 10 ? '冲刺中 ' + trainCount + '/30节' : '锁定中')}}
              </text>
            </view>
            <text class="milestone-desc">针对减脂塑形与肌肉走向精准雕琢，天鹅颈、直角肩与紧致臀腿初现成效。</text>
          </view>
        </view>

        <!-- 里程碑 4 -->
        <view class="milestone-item {{joinDays >= 365 ? 'milestone-done' : 'milestone-locked'}}">
          <view class="milestone-dot"><text class="dot-inner">✦</text></view>
          <view class="milestone-content">
            <view class="milestone-head">
              <text class="milestone-title">终生优雅 · 掌控身体与生活</text>
              <text class="milestone-status status-locked">终身守候</text>
            </view>
            <text class="milestone-desc">挺拔从容融于呼吸本能，自律化为骨骼底气，无论岁月流转，皆为大女主从容气场。</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 无反馈空状态 -->
    <view wx:if="{{!latestFeedback && historyFeedbacks.length === 0}}" class="empty-state stagger-2 letter-empty-stationery">
      <view class="stationery-seal">✦</view>
      <text class="empty-title">第一封专属手札 · 正在为你执笔</text>
      <text class="empty-desc">每一次深层呼吸与肌肉延展，都值得被温柔记录与珍藏</text>
      <view class="stationery-line"></view>
      <text class="stationery-footer">徕舞 · 私教手札团队</text>
    </view>

    <!-- 历史反馈列表 -->
    <view wx:if="{{historyFeedbacks.length > 0}}" class="section stagger-4">
      <view class="section-header-row">
        <text class="section-title">过往手札珍藏</text>
        <text class="section-badge">{{historyFeedbacks.length}} 封</text>
      </view>
      <view class="history-list">
        <block wx:for="{{historyFeedbacks}}" wx:key="id">
          <view class="history-item" bindtap="toggleItem" data-index="{{index}}">
            <view class="card-header">
              <view class="type-pill-luxury">
                <text class="pill-dot"></text>
                <text class="pill-label">{{item.typeLabel}}</text>
              </view>
              <text class="card-date">{{item.date}}</text>
            </view>
            <text class="card-summary" wx:if="{{!item.expanded}}">{{item.summary}}</text>
            <text class="card-full" wx:if="{{item.expanded}}">{{item.content}}</text>
            <view class="card-toggle">
              <view class="toggle-pill small">
                <text class="toggle-label">{{item.expanded ? "收起" : "展开"}}</text>
                <text class="toggle-arrow">{{item.expanded ? "▴" : "▾"}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{index < historyFeedbacks.length - 1}}" class="divider"></view>
        </block>
      </view>
    </view>

  </block>
</view>
