/* pages/cards/cards.wxss
   卡包 · lululemon 规范
   会员卡为全站唯一大色块 绛红渐变直角白字 · 流水 list-row
   ============================================================ */

page {
  background-color: #FDFCF9;
  color: #000000;
  font-family: var(--font-sans);
  min-height: 100vh;
  box-sizing: border-box;
}

.cards-page {
  padding: 0 40rpx calc(env(safe-area-inset-bottom) + 64rpx);
  box-sizing: border-box;
}

.cards-loading,
.cards-error,
.cards-empty {
  padding: 80rpx 0;
  text-align: center;
}

.cards-loading-text {
  font-size: 26rpx;
  color: #54555b;
}

.cards-error-text {
  font-size: 26rpx;
  color: #54555b;
}

.cards-empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  margin-bottom: 8rpx;
}

.cards-empty-body {
  font-size: 24rpx;
  color: #54555b;
}

/* 顶部标题 */
.cards-hero {
  padding-bottom: 32rpx;
}

.cards-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.3;
}

.cards-group {
  margin-bottom: 64rpx;
}

/* 会员卡整卡：绛红渐变卡面（与两页 hero 同源），直角，白字 */
.member-card {
  background: linear-gradient(135deg, #B92E32 0%, #C93337 55%, #8A2830 100%);
  border-radius: 0;
  padding: 36rpx;
  color: #ffffff;
  box-sizing: border-box;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-main {
  display: flex;
  flex-direction: column;
}

.card-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 白描边胶囊「年卡」 */
.card-annual-badge {
  font-size: 20rpx;
  color: #ffffff;
  border: 1px solid #ffffff;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  line-height: 1.3;
}

.card-type {
  font-size: 24rpx;
  color: #d791a0;
}

.card-status {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.card-scope {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: #d791a0;
}

.card-scope-label {
  opacity: 0.8;
}

.card-scope-text {
  color: #ffffff;
}

.card-balance-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.card-balance {
  display: flex;
  flex-direction: column;
}

.card-balance-val {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.card-balance-num {
  font-family: var(--font-num);
  font-size: 72rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.card-balance-unit {
  font-size: 28rpx;
  color: #ffffff;
}

.card-balance-label {
  font-size: 22rpx;
  color: #d791a0;
  margin-top: 6rpx;
}

.card-valid {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.card-valid-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.card-valid-label {
  font-size: 22rpx;
  color: #d791a0;
  margin-top: 4rpx;
}

/* 消费记录：list-row */
.card-tx-section {
  margin-top: 32rpx;
}

.card-tx-heading {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  margin-bottom: 8rpx;
  display: block;
}

.card-tx-list {
  display: flex;
  flex-direction: column;
}

.card-tx-info {
  display: flex;
  flex-direction: column;
}

.card-tx-label {
  font-size: 28rpx;
  color: #000000;
  margin-bottom: 4rpx;
}

.card-tx-date {
  font-size: 22rpx;
  color: #999999;
}

.card-tx-amount {
  font-family: var(--font-num);
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.cards-bottom-space {
  height: 48rpx;
}
