/* pages/me/me.wxss
   我的账户 · 简化版：档案 / 训练资产 / 小桥回音 / 服务
   ============================================================ */

page {
  background-color: #F6E6DA;
  color: #1C1415;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.me-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 110rpx) 36rpx 0;
  box-sizing: border-box;
  animation: meFadeIn 0.4s ease both;
}

@keyframes meFadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.me-loading {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.me-loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
}

.me-error {
  margin-bottom: 22rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
}

.me-error-text {
  font-size: 24rpx;
  color: #9E2A2B;
}

/* 顶部 */
.me-hero {
  padding: 4rpx 8rpx 28rpx;
}

.me-hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.me-hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 0.5rpx;
}

/* 档案卡 */
.me-profile-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 40rpx rgba(120, 24, 26, 0.12);
}

.me-profile-top {
  display: flex;
  align-items: center;
}

.me-avatar-wrap {
  position: relative;
  width: 124rpx;
  height: 124rpx;
  border-radius: 62rpx;
  overflow: hidden;
  background: #F1E7E2;
  flex-shrink: 0;
}

.me-avatar {
  width: 100%;
  height: 100%;
}

.me-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #9E2A2B;
}

.me-avatar-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 17rpx;
  line-height: 30rpx;
  color: #F7F3EF;
  background: rgba(13, 12, 15, 0.55);
}

.me-profile-main {
  margin-left: 26rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.me-profile-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 1rpx;
}

.me-profile-code {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8C827B;
}

.me-profile-status {
  margin-top: 12rpx;
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(186, 36, 40, 0.1);
  color: #9E2A2B;
  font-size: 20rpx;
}

.me-profile-meta {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(28, 20, 21, 0.06);
  display: flex;
}

.me-meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.me-meta-label {
  font-size: 20rpx;
  color: #8C827B;
}

.me-meta-value {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #2B2629;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 管理端专享入口 */
.me-manager-entrance {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #1A191D 0%, #0D0C0F 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(184, 147, 88, 0.4);
  box-shadow: 0 8rpx 24rpx rgba(13, 12, 15, 0.15);
}

.me-manager-badge {
  display: inline-block;
  font-size: 18rpx;
  color: #F6E6DA;
  background: rgba(184, 147, 88, 0.25);
  border: 1rpx solid rgba(184, 147, 88, 0.4);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.me-manager-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.me-manager-desc {
  display: block;
  font-size: 20rpx;
  color: #C7C2BA;
}

.me-manager-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(184, 147, 88, 0.2);
  border: 1rpx solid rgba(184, 147, 88, 0.4);
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  color: #F6E6DA;
  flex-shrink: 0;
}

.me-manager-btn-text {
  font-size: 22rpx;
  font-weight: 600;
}

.me-manager-arrow {
  font-size: 28rpx;
  color: #B89358;
}

/* section */
.me-section {
  margin-top: 42rpx;
}

.me-section-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
  padding-left: 4rpx;
}

.me-section-index {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
  margin-right: 14rpx;
  letter-spacing: 2rpx;
}

.me-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

/* 训练资产 */
.me-total-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 26rpx;
  padding: 30rpx;
}

.me-total-label {
  font-size: 23rpx;
  color: #6D645D;
}

.me-total-row {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.me-total-num {
  font-size: 82rpx;
  line-height: 1.1;
  font-weight: 600;
  color: #0D0C0F;
}

.me-total-unit {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #6D645D;
}

.me-total-note {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8C827B;
}

.me-total-right {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(28, 20, 21, 0.06);
}

.me-total-empty-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #1C1415;
}

.me-total-empty-body {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8C827B;
}

.me-course-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.me-course-card {
  background: rgba(255, 255, 255, 0.78);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
}

.me-course-name {
  font-size: 22rpx;
  color: #5C5559;
}

.me-course-num {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #BA2428;
  line-height: 1.1;
}

.me-course-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #8C827B;
}

/* 回音 */
.me-reply-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
}

.me-reply-date {
  display: block;
  font-size: 20rpx;
  color: #8C827B;
}

.me-reply-text {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.85;
  color: #2B2629;
}

.me-empty {
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx dashed rgba(255, 255, 255, 0.92);
  border-radius: 22rpx;
  padding: 28rpx 26rpx;
}

.me-empty-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.me-empty-body {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.85);
}

.me-empty-link {
  margin-top: 16rpx;
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 30rpx;
  border-radius: 32rpx;
  background: #0D0C0F;
  color: #F7F3EF;
  font-size: 22rpx;
}

/* 服务 */
.me-service-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 22rpx;
  overflow: hidden;
}

.me-service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid rgba(28, 20, 21, 0.06);
}

.me-service-row-last {
  border-bottom: none;
}

.me-service-texts {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.me-service-title {
  font-size: 26rpx;
  color: #1C1415;
}

.me-service-note {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8C827B;
}

.me-service-arrow {
  font-size: 30rpx;
  color: #B9B0AC;
}

.me-bottom-space {
  height: calc(env(safe-area-inset-bottom) + 210rpx);
}
