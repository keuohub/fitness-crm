/* pages/me/me.wxss
   我的账户 · 女子塑形高奢温润版（Cin v3 规范）
   暖米底色 · 胭脂玫瑰主色 · 柔和圆角 · 典藏管家入口
   ============================================================ */

page {
  background-color: #FDFCF9;
  color: #1A1A1A;
  font-family: var(--font-sans);
  min-height: 100vh;
  box-sizing: border-box;
}

.me-page {
  padding: 0 40rpx;
  box-sizing: border-box;
}

.me-loading,
.me-error {
  padding: 80rpx 0;
  text-align: center;
}

.me-loading-text {
  font-size: 26rpx;
  color: #6B6B6B;
}

.me-error-text {
  font-size: 26rpx;
  color: #6B6B6B;
}

/* 顶部头像与问候语 */
.me-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding-bottom: 40rpx;
}

.me-avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  position: relative;
  flex-shrink: 0;
  cursor: pointer;
}

.me-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  object-fit: cover;
  display: block;
  box-shadow: 0 0 0 4rpx #F0EEE8, 0 6rpx 16rpx rgba(26, 26, 26, 0.08);
}

.me-avatar-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #F0EEE8;
  color: #1A1A1A;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 4rpx #F0EEE8;
}

/* 头像右下小圆「+」 */
.me-avatar-plus {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #1A1A1A;
  border: 3rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.me-avatar-plus::before {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 2rpx;
  background: #ffffff;
}

.me-avatar-plus::after {
  content: "";
  position: absolute;
  width: 2rpx;
  height: 14rpx;
  background: #ffffff;
}

.me-header-info {
  flex: 1;
  min-width: 0;
}

.me-greeting {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.me-meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.me-tag {
  font-size: 22rpx;
  color: #1A1A1A;
  background: #F0EEE8;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  font-weight: 500;
}

/* 管理员专享入口（纯黑质感卡，不掺任何酒红/金） */
.me-manager-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #232323 0%, #141414 100%);
  border: 1px solid rgba(26, 26, 26, 0.06);
  border-radius: 24rpx;
  margin-top: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.16);
  cursor: pointer;
  transition: transform 0.15s ease;
}

.me-manager-row:active {
  transform: scale(0.98);
}

.me-manager-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.me-manager-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #EDEAE3;
  letter-spacing: 1rpx;
}

.me-manager-desc {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.12);
}

.me-manager-arrow {
  font-size: 36rpx;
  color: #EDEAE3;
  font-weight: 300;
}

/* 训练数据 */
.me-section {
  margin-bottom: 40rpx;
}

.me-section-head {
  margin-bottom: 20rpx;
}

.me-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.me-total-block {
  padding: 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1px solid #F2F0EA;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 26, 0.04);
  box-sizing: border-box;
}

.me-total-label {
  font-size: 24rpx;
  color: #6B6B6B;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.me-total-num-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.me-total-num {
  font-family: var(--font-num);
  font-size: 80rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1;
}

.me-total-unit {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.me-total-note {
  font-size: 23rpx;
  color: #9A9A9A;
  display: block;
}

/* 停卡中：把粉色标签压成中性灰，避免"相伴 · 停卡中"看起来像营销徽章 */
.me-tag-frozen {
  color: #6B6B6B;
  background: #ece7e0;
}

.me-freeze-note {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  background: #f4f1ec;
  border-radius: 16rpx;
  font-size: 23rpx;
  color: #6B6B6B;
  line-height: 1.6;
}

/* ── 我的训练：双栏数字（累计上课 / 卡内剩余）── */
.me-stat-grid {
  display: flex;
  align-items: stretch;
  padding: 40rpx 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1px solid #F2F0EA;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 26, 0.04);
  box-sizing: border-box;
}

.me-stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.me-stat-divider {
  width: 1rpx;
  background: linear-gradient(180deg, rgba(244, 242, 237, 0) 0%, #F2F0EA 50%, rgba(244, 242, 237, 0) 100%);
  margin: 6rpx 8rpx;
}

.me-stat-num {
  font-family: var(--font-num);
  font-size: 68rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.1;
}

.me-stat-num-muted {
  color: #cbb9bb;
}

.me-stat-label {
  font-size: 23rpx;
  color: #6B6B6B;
  letter-spacing: 0.5rpx;
  margin-top: 10rpx;
}

.me-nocard-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 26rpx 28rpx;
  background: #ffffff;
  border: 1px dashed #e4d3cb;
  border-radius: 24rpx;
}

.me-nocard-text {
  font-size: 26rpx;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.me-course-list {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1px solid #F2F0EA;
  margin-top: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(26, 26, 26, 0.03);
}

.me-course-name {
  font-size: 28rpx;
  color: #1A1A1A;
}

.me-course-count {
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* 列表行导航菜单 */
.me-menu-section {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1px solid #F2F0EA;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 26, 0.04);
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1px solid #FDFCF9;
  box-sizing: border-box;
  transition: background-color 0.15s ease;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row:active {
  background-color: #fdfaf7;
}

.me-menu-title {
  font-size: 28rpx;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.list-row__arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2px solid #D8D5CE;
  border-right: 2px solid #D8D5CE;
  transform: rotate(45deg);
}

.me-logout-row {
  margin-top: 8rpx;
  border-top: 1px solid #FDFCF9;
}

.me-logout-text {
  color: #9A9A9A !important;
  font-size: 26rpx;
}

.me-bottom-space {
  height: calc(104rpx + 28rpx + env(safe-area-inset-bottom) + 40rpx);
}
