/* ==========================================================================
   pages/me/me.wxss - 我的 · 会员尊享中心 (The Member Sanctuary)
   大牌艺术手札质感、身体资产矩阵与私享排课
   ========================================================================== */

.me-container {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 96rpx) 40rpx calc(env(safe-area-inset-bottom) + 260rpx);
  box-sizing: border-box;
  animation: pageTransitIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.loading {
  padding: 140rpx 0;
  text-align: center;
}
.loading-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 2rpx;
}

/* 极细发丝分隔律动线 */
.editorial-hairline {
  height: 1rpx;
  margin: 48rpx 0;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.25) 50%, rgba(255, 255, 255, 0.04) 100%);
}

/* ================= 模块一：会员尊享画卷 (Profile Hero) ================= */
.profile-editorial-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 12rpx 0 20rpx;
}

.avatar-editorial-wrap {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  position: relative;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 44rpx rgba(28, 20, 21, 0.16), 0 0 0 8rpx rgba(186, 36, 40, 0.08);
  background: #1C1415;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 160ms cubic-bezier(0.2, 0.8, 0.25, 1);
}
.avatar-editorial-wrap:active {
  transform: scale(0.95);
}
.avatar-img {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  display: block;
}
.avatar-placeholder {
  font-family: "Songti SC", Georgia, serif;
  font-size: 56rpx;
  font-weight: 500;
  color: #FFFFFF;
}
.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(28, 20, 21, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  color: #FFE5A3;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.profile-hero-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.profile-name {
  font-family: "Songti SC", Georgia, serif;
  font-size: 48rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
  line-height: 1.25;
  margin-bottom: 10rpx;
}
.profile-status-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.profile-tier-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #BA2428;
  letter-spacing: 0.06em;
}
.status-dot {
  font-size: 20rpx;
  color: rgba(28, 20, 21, 0.35);
}
.profile-days-text {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 22rpx;
  color: rgba(28, 20, 21, 0.58);
  letter-spacing: 0.04em;
}

/* ================= 模块二：私享预约席位 (Concierge Card) ================= */
.concierge-editorial-card {
  padding: 32rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 36rpx rgba(186, 36, 40, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  transition: transform 140ms ease;
}
.concierge-editorial-card:active {
  transform: scale(0.985);
}
.concierge-content {
  flex: 1;
}
.concierge-tag {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 6rpx;
}
.concierge-code {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 19rpx;
  font-weight: 600;
  color: #FFE5A3;
  letter-spacing: 0.12em;
}
.concierge-dot {
  font-size: 16rpx;
  color: rgba(28, 20, 21, 0.35);
  margin: 0 2rpx;
}
.concierge-label {
  font-size: 18rpx;
  color: #BA2428;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.concierge-title {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.04em;
  margin-bottom: 6rpx;
}
.concierge-desc {
  display: block;
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(28, 20, 21, 0.58);
}
.concierge-arrow-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(186, 36, 40, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.concierge-arrow {
  font-size: 26rpx;
  color: #BA2428;
  line-height: 1;
}

/* ================= 模块三：身体资产档案 (Portfolio Grid) ================= */
.section-editorial-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.section-tag-group {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.section-num {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFE5A3;
  letter-spacing: 0.08em;
}
.section-title {
  font-family: "Songti SC", Georgia, serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1415;
  letter-spacing: 0.05em;
}
.section-en {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: rgba(28, 20, 21, 0.42);
  text-transform: uppercase;
}

.portfolio-metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.portfolio-metric-box {
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 6rpx 20rpx rgba(186, 36, 40, 0.03);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.metric-val {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 48rpx;
  font-weight: 600;
  color: #1C1415;
  line-height: 1.1;
  letter-spacing: -0.01em;
  margin-bottom: 6rpx;
}
.metric-stage {
  font-family: "Songti SC", Georgia, serif;
  font-size: 36rpx;
  color: #BA2428;
}
.metric-unit {
  font-size: 20rpx;
  font-weight: 500;
  color: #BA2428;
  margin-left: 4rpx;
}
.metric-caption {
  font-size: 20rpx;
  color: rgba(28, 20, 21, 0.55);
  letter-spacing: 0.04em;
}

/* ================= 模块四：我的私享便签 (Notes History) ================= */
.notes-feed {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.note-feed-card {
  padding: 28rpx 28rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 6rpx 18rpx rgba(186, 36, 40, 0.03);
}
.note-feed-body {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 25rpx;
  line-height: 1.7;
  color: #1C1415;
  font-style: italic;
  margin-bottom: 16rpx;
}
.note-reply-bar {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(186, 36, 40, 0.05);
  border: 1rpx solid rgba(186, 36, 40, 0.12);
  margin-bottom: 14rpx;
}
.reply-seal {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: rgba(186, 36, 40, 0.88);
  color: #FFE5A3;
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transform: rotate(-6deg);
}
.reply-text-wrap {
  flex: 1;
}
.reply-lead {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 20rpx;
  font-weight: 600;
  color: #BA2428;
  margin-bottom: 4rpx;
}
.reply-quote {
  display: block;
  font-family: "Songti SC", Georgia, serif;
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(28, 20, 21, 0.82);
}
.note-feed-date {
  display: block;
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 19rpx;
  color: rgba(28, 20, 21, 0.42);
}

/* ================= 模块五：我的预约 (Bookings Schedule) ================= */
.bookings-spine-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.booking-spine-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.booking-time-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.booking-date-text {
  font-family: "Didot", "Bodoni MT", Georgia, serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1415;
}
.booking-time-text {
  font-size: 20rpx;
  color: rgba(28, 20, 21, 0.5);
}
.booking-body-block {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.booking-type-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1415;
}
.booking-status-tag {
  font-size: 19rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}
.status-confirmed {
  color: #BA2428;
  background: rgba(186, 36, 40, 0.08);
}
.status-pending {
  color: rgba(28, 20, 21, 0.6);
  background: rgba(28, 20, 21, 0.06);
}
.status-cancelled {
  color: rgba(28, 20, 21, 0.35);
  background: rgba(28, 20, 21, 0.04);
}

/* ================= 模块六：账号操作 (Account Operations) ================= */
.account-actions-editorial {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding-bottom: 20rpx;
}
.logout-link-editorial {
  padding: 12rpx 32rpx;
  transition: opacity 140ms ease;
}
.logout-link-editorial:active {
  opacity: 0.5;
}
.logout-txt {
  font-family: "Songti SC", Georgia, serif;
  font-size: 21rpx;
  color: rgba(28, 20, 21, 0.42);
  letter-spacing: 0.08em;
}
