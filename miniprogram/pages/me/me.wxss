/* pages/me/me.wxss
   我的账户 · 粉白渐变主题（参考 lululemon「一起好状态」）
   绛红 hero 压顶（白字）→ 奶油白正文（墨字）→ 白玻璃卡片
   ============================================================ */

page {
  background-color: #FDFCF9;
  color: #1A1A1A;
  font-family: var(--font-sans);
  min-height: 100vh;
  box-sizing: border-box;
}

.me-page {
  min-height: 100vh;
}

/* ── hero：绛红压顶 ──
   渐变取自参考图实测色：#B92E32 → #C93337 → #E96A67 → #E3B5AF。
   白字只出现在深红区，往下自然过渡到腮粉，再接奶油白正文。 */
.me-hero {
  margin: 0;
  padding: 0 40rpx 110rpx;
  background: linear-gradient(180deg, #B92E32 0%, #C93337 42%, #E96A67 80%, #E3B5AF 100%);
}

.me-loading {
  padding: 60rpx 0 20rpx;
  text-align: center;
}

.me-loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 顶部头像与问候语（白字） */
.me-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding-top: 16rpx;
}

.me-avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  position: relative;
  flex-shrink: 0;
}

.me-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  object-fit: cover;
  display: block;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.55), 0 8rpx 20rpx rgba(0, 0, 0, 0.18);
}

.me-avatar-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.55);
}

.me-avatar-plus {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}

.me-avatar-plus::before {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 2rpx;
  background: #C03438;
}

.me-avatar-plus::after {
  content: "";
  position: absolute;
  width: 2rpx;
  height: 14rpx;
  background: #C03438;
}

.me-header-info {
  flex: 1;
  min-width: 0;
}

.me-greeting {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.me-header-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
}

/* ── 正文：白卡浮层，向上叠住 hero 下缘 ── */
.me-body {
  position: relative;
  margin-top: -64rpx;
  padding: 0 40rpx;
}

/* 管理员入口（墨黑卡，压在腮粉过渡带上） */
.me-manager-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #232323 0%, #141414 100%);
  border-radius: 24rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 10rpx 28rpx rgba(120, 30, 32, 0.18);
}

.me-manager-row:active {
  transform: scale(0.98);
}

.me-manager-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.me-manager-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.me-manager-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.me-manager-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}

/* 训练数据 */
.me-section {
  margin-bottom: 44rpx;
}

.me-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.me-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.me-section-en {
  font-size: 20rpx;
  color: #C03438;
  letter-spacing: 3rpx;
  font-weight: 600;
}

/* 双栏数字 */
.me-stat-grid {
  display: flex;
  align-items: stretch;
  padding: 40rpx 24rpx;
  background: var(--card-glass);
  border-radius: 28rpx;
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 10rpx 30rpx rgba(150, 45, 48, 0.10);
  box-sizing: border-box;
}

.me-stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.me-stat-divider {
  width: 1rpx;
  background: linear-gradient(180deg, rgba(227, 181, 175, 0) 0%, #E3B5AF 50%, rgba(227, 181, 175, 0) 100%);
  margin: 6rpx 8rpx;
}

.me-stat-num {
  font-family: var(--font-num);
  font-size: 68rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.1;
}

.me-stat-num-muted {
  color: #D9B8B4;
}

.me-stat-label {
  font-size: 23rpx;
  color: #6B6B6B;
  letter-spacing: 0.5rpx;
  margin-top: 10rpx;
}

/* 四类课：2×2 小卡，恢复全部课程 */
.me-course-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 16rpx;
}

.me-course-cell {
  background: var(--card-glass);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(150, 45, 48, 0.07);
  box-sizing: border-box;
}

.me-course-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.me-course-num {
  font-family: var(--font-num);
  font-size: 40rpx;
  font-weight: 700;
  color: #C03438;
  line-height: 1;
}

.me-course-unit {
  font-size: 22rpx;
  color: #6B6B6B;
}

.me-course-name {
  font-size: 24rpx;
  color: #1A1A1A;
  margin-top: 10rpx;
  display: block;
}

.me-total-note {
  font-size: 23rpx;
  color: #9A9A9A;
  display: block;
  margin-top: 16rpx;
  padding: 0 6rpx;
}

.me-freeze-note {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1px solid rgba(192, 52, 56, 0.16);
  border-radius: 16rpx;
  font-size: 23rpx;
  color: #A8433F;
  line-height: 1.6;
}

.me-nocard-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 26rpx 28rpx;
  background: var(--card-glass);
  border: 1px dashed rgba(192, 52, 56, 0.4);
  border-radius: 24rpx;
}

.me-nocard-text {
  font-size: 26rpx;
  color: #C03438;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* ── 菜单：三组，白卡分组 ── */
.me-menu-section {
  margin-bottom: 44rpx;
}

.me-group-label {
  font-size: 22rpx;
  color: #B98A87;
  letter-spacing: 3rpx;
  margin: 26rpx 6rpx 12rpx;
}

.me-menu-card {
  background: var(--card-glass);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(150, 45, 48, 0.08);
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1px solid rgba(227, 181, 175, 0.22);
  box-sizing: border-box;
  transition: background-color 0.15s ease;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row:active {
  background-color: rgba(239, 194, 189, 0.18);
}

.me-menu-title {
  font-size: 28rpx;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.list-row__arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2px solid #DBAEAA;
  border-right: 2px solid #DBAEAA;
  transform: rotate(45deg);
}

.me-logout-row {
  border-top: 1px solid rgba(227, 181, 175, 0.22);
}

.me-logout-text {
  color: #B98A87 !important;
  font-size: 26rpx;
}

.me-bottom-space {
  height: calc(104rpx + 28rpx + env(safe-area-inset-bottom) + 40rpx);
}
