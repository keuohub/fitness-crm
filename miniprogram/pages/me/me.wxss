/* pages/me/me.wxss
   我的账户 · 会员档案与私享管家 (对标 Apple 与 Cartier 黑曜石尊享卡)
   暖砂白主色调 · 黑曜石会员卡 · 8px/16px/24px 网格系统
   ============================================================ */

page {
  background-color: #F6E6DA;
  color: #1A181E;
  font-family: -apple-system, "PingFang SC", "Songti SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.me-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 36rpx) 40rpx 0;
}

/* 顶部轻奢导航头 */
.me-hero-header {
  padding-bottom: 28rpx;
}

.me-pill-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(13, 12, 15, 0.05);
  border: 1rpx solid rgba(13, 12, 15, 0.12);
  border-radius: 30rpx;
  margin-bottom: 20rpx;
}

.tag-letter {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: #1A181E;
}

.tag-slash {
  font-size: 18rpx;
  color: #A0968E;
}

.tag-sub {
  font-size: 20rpx;
  color: #6D645D;
  letter-spacing: 0.04em;
}

.me-title-wrap {
  display: flex;
  flex-direction: column;
}

.me-hero-title {
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 56rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.06em;
  line-height: 1.2;
}

.me-hero-subtitle {
  font-size: 26rpx;
  color: #726A63;
  margin-top: 14rpx;
  letter-spacing: 0.04em;
}

/* 模块一：黑金高奢会员身份画卷 (Black Obsidian Member Card) */
.member-obsidian-card {
  padding: 36rpx 32rpx;
  background: #0E0D10;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx -10rpx rgba(13, 12, 15, 0.35);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.card-brand-mark {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.card-brand-en {
  font-family: -apple-system, sans-serif;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0.22em;
  color: #FFFFFF;
}

.card-brand-tier {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: #D4AF37;
}

.card-status-pill {
  font-size: 19rpx;
  color: #D4AF37;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(212, 175, 55, 0.12);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}

.card-profile-row {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-bottom: 32rpx;
}

.card-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1C1A20;
  flex-shrink: 0;
}

.card-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
}

.card-avatar-placeholder {
  font-family: "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.card-avatar-edit-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  font-size: 16rpx;
  color: #D4AF37;
  background: #0E0D10;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.4);
}

.card-profile-info {
  display: flex;
  flex-direction: column;
}

.card-member-name {
  font-family: "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.06em;
  margin-bottom: 6rpx;
}

.card-member-code {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.65);
  letter-spacing: 0.04em;
  margin-bottom: 4rpx;
}

.card-member-phone {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
}

.card-footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  padding-top: 24rpx;
}

.card-footer-item {
  display: flex;
  flex-direction: column;
}

.footer-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: 6rpx;
}

.footer-val {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 极细发丝分隔律动线 */
.editorial-hairline {
  height: 1rpx;
  background: rgba(140, 130, 122, 0.18);
  margin: 36rpx 0;
}

/* 模块通用样式 */
.me-section {
  display: flex;
  flex-direction: column;
}

.section-title-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-tag-group {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.section-index {
  font-family: "Didot", serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #9E2A2B;
}

.section-heading {
  font-family: "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.06em;
}

.section-en-label {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: #A39991;
  font-weight: 500;
}

.section-intro {
  font-size: 24rpx;
  color: #6E6660;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 四宫格身体资产矩阵 */
.assets-grid-box {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 30rpx 20rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx -6rpx rgba(13, 12, 15, 0.05);
}

.asset-grid-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.grid-cell-val {
  font-family: "Didot", "Playfair Display", "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #0E0D10;
  margin-bottom: 8rpx;
}

.cell-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #8C827B;
  margin-left: 2rpx;
}

.grid-cell-caption {
  font-size: 19rpx;
  color: #7A726A;
  letter-spacing: 0.02em;
}

/* 反馈与回音列表 */
.feedback-feed-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feedback-feed-item {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx -6rpx rgba(13, 12, 15, 0.05);
}

.feedback-date-row {
  margin-bottom: 12rpx;
}

.feedback-date-badge {
  font-size: 19rpx;
  color: #8C827B;
  background: rgba(13, 12, 15, 0.05);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.feedback-user-quote {
  font-size: 24rpx;
  color: #38332E;
  line-height: 1.6;
}

.mentor-reply-block {
  margin-top: 18rpx;
  padding: 20rpx;
  background: rgba(246, 230, 222, 0.55);
  border-left: 4rpx solid #9E2A2B;
  border-radius: 0 16rpx 16rpx 0;
  display: flex;
  gap: 14rpx;
}

.reply-seal-tag {
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  background: #9E2A2B;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.reply-text-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.reply-mentor-title {
  font-size: 21rpx;
  font-weight: 600;
  color: #0E0D10;
}

.reply-mentor-body {
  font-size: 23rpx;
  color: #4A433D;
  line-height: 1.6;
}

/* 专属管家卡片 */
.concierge-action-card {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx -6rpx rgba(13, 12, 15, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  transition: transform 180ms ease;
}

.concierge-action-card:active {
  transform: scale(0.98);
}

.concierge-left-info {
  display: flex;
  flex-direction: column;
}

.concierge-wechat-tag {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.wechat-prefix {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #9E2A2B;
}

.wechat-id {
  font-family: -apple-system, sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.04em;
}

.concierge-desc-text {
  font-size: 22rpx;
  color: #787069;
  line-height: 1.45;
}

.concierge-copy-pill {
  padding: 14rpx 28rpx;
  background: #0E0D10;
  border-radius: 30rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(14, 13, 16, 0.25);
}

.copy-pill-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.06em;
}

/* 退出登录 */
.logout-action-wrap {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.logout-pill-btn {
  padding: 16rpx 48rpx;
  background: rgba(13, 12, 15, 0.05);
  border: 1rpx solid rgba(13, 12, 15, 0.12);
  border-radius: 40rpx;
  transition: all 180ms ease;
}

.logout-pill-btn:active {
  background: rgba(13, 12, 15, 0.1);
}

.logout-btn-text {
  font-size: 22rpx;
  color: #8C827B;
  letter-spacing: 0.05em;
}

/* 底部防遮挡垫片 */
.dock-spacer {
  height: calc(env(safe-area-inset-bottom) + 210rpx);
}
