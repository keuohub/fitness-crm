/* pages/me/me.wxss
   我的账户 · 结合 BRAND_SYSTEM_SPEC.md 静奢设计规范打磨
   燕麦象牙底色 #F7F4EE / 沉檀木黑 #231F1D / 陶赭朱砂 #9B4A3F / 柔润岩灰 #E6E0D6
   ============================================================ */

page {
  background-color: #F7F4EE;
  color: #231F1D;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.me-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 100rpx) 36rpx 0;
  box-sizing: border-box;
  animation: meFadeIn 0.35s ease both;
}

@keyframes meFadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.me-loading {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.me-loading-text {
  font-size: 26rpx;
  color: #7A7068;
}

.me-error {
  margin-bottom: 22rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #FFF;
  border: 1rpx solid #E6E0D6;
}

.me-error-text {
  font-size: 24rpx;
  color: #9B4A3F;
}

/* 顶部标题区：高对比度沉檀木黑 + 温润副标题，彻底解决白字在浅底上失焦问题 */
.me-hero {
  padding: 10rpx 8rpx 32rpx;
}

.me-hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #231F1D;
  letter-spacing: 1.5rpx;
}

.me-hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7A7068;
  letter-spacing: 0.5rpx;
  line-height: 1.5;
}

/* 档案卡：白底纯粹微水泥质感 + 柔润岩灰细边 */
.me-profile-card {
  background: #FFFFFF;
  border: 1rpx solid #E6E0D6;
  border-radius: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(35, 31, 29, 0.04);
}

.me-profile-top {
  display: flex;
  align-items: center;
}

.me-avatar-wrap {
  position: relative;
  width: 124rpx;
  height: 124rpx;
  border-radius: 62rpx;
  overflow: hidden;
  background: #F7F4EE;
  border: 2rpx solid #E6E0D6;
  flex-shrink: 0;
}

.me-avatar {
  width: 100%;
  height: 100%;
}

.me-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 500;
  color: #9B4A3F;
  background: #F4EFEB;
}

.me-avatar-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 17rpx;
  line-height: 28rpx;
  color: #F7F4EE;
  background: rgba(35, 31, 29, 0.65);
}

.me-profile-main {
  margin-left: 26rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.me-profile-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #231F1D;
  letter-spacing: 1rpx;
}

.me-profile-code {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7A7068;
  letter-spacing: 0.5rpx;
}

.me-profile-status {
  margin-top: 10rpx;
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(155, 74, 63, 0.08);
  border: 1rpx solid rgba(155, 74, 63, 0.16);
  color: #9B4A3F;
  font-size: 20rpx;
  font-weight: 500;
}

.me-profile-meta {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #F0ECE4;
  display: flex;
}

.me-meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.me-meta-label {
  font-size: 20rpx;
  color: #8C827B;
  letter-spacing: 0.5rpx;
}

.me-meta-value {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #231F1D;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 管理端专享入口 */
.me-manager-entrance {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #2B2623 0%, #1F1B19 100%);
  border-radius: 22rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(155, 74, 63, 0.35);
  box-shadow: 0 8rpx 24rpx rgba(35, 31, 29, 0.12);
}

.me-manager-badge {
  display: inline-block;
  font-size: 18rpx;
  color: #F7F4EE;
  background: rgba(155, 74, 63, 0.35);
  border: 1rpx solid rgba(155, 74, 63, 0.5);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.me-manager-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #F7F4EE;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.me-manager-desc {
  display: block;
  font-size: 20rpx;
  color: #D4CDC5;
}

.me-manager-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(155, 74, 63, 0.25);
  border: 1rpx solid rgba(155, 74, 63, 0.5);
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  color: #F7F4EE;
  flex-shrink: 0;
}

.me-manager-btn-text {
  font-size: 22rpx;
  font-weight: 600;
}

.me-manager-arrow {
  font-size: 28rpx;
  color: #D49386;
}

/* 分区公共头部：陶赭朱砂编号 + 沉檀木黑标题 */
.me-section {
  margin-top: 44rpx;
}

.me-section-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.me-section-index {
  font-size: 22rpx;
  font-weight: 600;
  color: #9B4A3F;
  margin-right: 14rpx;
  letter-spacing: 2rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Cinzel", sans-serif;
}

.me-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #231F1D;
  letter-spacing: 1rpx;
}

/* 训练资产卡片 */
.me-total-card {
  background: #FFFFFF;
  border: 1rpx solid #E6E0D6;
  border-radius: 26rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(35, 31, 29, 0.03);
}

.me-total-label {
  font-size: 23rpx;
  color: #7A7068;
}

.me-total-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

.me-total-num {
  font-size: 82rpx;
  line-height: 1.05;
  font-weight: 600;
  color: #231F1D;
  font-family: -apple-system, BlinkMacSystemFont, "Cinzel", "Plus Jakarta Sans", sans-serif;
}

.me-total-unit {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #7A7068;
}

.me-total-note {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #8C827B;
}

.me-total-right {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0ECE4;
}

.me-total-empty-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #231F1D;
}

.me-total-empty-body {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7A7068;
}

.me-course-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.me-course-card {
  background: #FFFFFF;
  border: 1rpx solid #E6E0D6;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 12rpx rgba(35, 31, 29, 0.025);
}

.me-course-name {
  font-size: 22rpx;
  color: #7A7068;
}

.me-course-num {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 600;
  color: #9B4A3F;
  line-height: 1.1;
  font-family: -apple-system, BlinkMacSystemFont, "Cinzel", "Plus Jakarta Sans", sans-serif;
}

.me-course-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #7A7068;
  margin-left: 4rpx;
}

/* 02 小桥的回音卡片 */
.me-reply-card {
  background: #FFFFFF;
  border: 1rpx solid #E6E0D6;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(35, 31, 29, 0.03);
}

.me-reply-date {
  display: block;
  font-size: 21rpx;
  color: #9B4A3F;
  letter-spacing: 0.5rpx;
}

.me-reply-text {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #231F1D;
}

.me-empty {
  background: #FFFFFF;
  border: 1rpx dashed #D9D2C7;
  border-radius: 24rpx;
  padding: 34rpx 30rpx;
}

.me-empty-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #231F1D;
}

.me-empty-body {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: #7A7068;
}

.me-empty-link {
  display: inline-block;
  margin-top: 18rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(155, 74, 63, 0.08);
  border: 1rpx solid rgba(155, 74, 63, 0.2);
  color: #9B4A3F;
  font-size: 22rpx;
  font-weight: 500;
}

/* 03 服务菜单卡片：静奢白底列表 + 柔润岩灰分割线 + 贴心触摸态 */
.me-service-card {
  background: #FFFFFF;
  border: 1rpx solid #E6E0D6;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(35, 31, 29, 0.03);
}

.me-service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #F0ECE4;
  transition: background-color 0.15s ease;
}

.me-service-row:active {
  background-color: #FAF7F2;
}

.me-service-row-last {
  border-bottom: none;
}

.me-service-texts {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.me-service-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #231F1D;
  letter-spacing: 0.5rpx;
}

.me-service-note {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8C827B;
}

.me-service-arrow {
  font-size: 28rpx;
  color: #B5ADA4;
  font-weight: 400;
  margin-left: 16rpx;
}

.me-bottom-space {
  height: calc(env(safe-area-inset-bottom) + 140rpx);
}
