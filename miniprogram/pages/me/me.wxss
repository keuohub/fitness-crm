/* pages/me/me.wxss
   我的账户 · 女子塑形高奢温润版（Cin v3 规范）
   暖米底色 · 胭脂玫瑰主色 · 柔和圆角 · 典藏管家入口
   ============================================================ */

page {
  background-color: #f6f0ea;
  color: #3a2a2d;
  font-family: var(--font-sans);
  min-height: 100vh;
  box-sizing: border-box;
}

.me-page {
  padding: 0 40rpx;
  box-sizing: border-box;
}

.me-loading,
.me-error {
  padding: 80rpx 0;
  text-align: center;
}

.me-loading-text {
  font-size: 26rpx;
  color: #7a6a6c;
}

.me-error-text {
  font-size: 26rpx;
  color: #7a6a6c;
}

/* 顶部头像与问候语 */
.me-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding-bottom: 40rpx;
}

.me-avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  position: relative;
  flex-shrink: 0;
  cursor: pointer;
}

.me-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  object-fit: cover;
  display: block;
  box-shadow: 0 0 0 4rpx #f6e3df, 0 6rpx 16rpx rgba(138, 58, 72, 0.12);
}

.me-avatar-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #f6e3df;
  color: #8a3a48;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 4rpx #f6e3df;
}

/* 头像右下小圆「+」 */
.me-avatar-plus {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #8a3a48;
  border: 3rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.me-avatar-plus::before {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 2rpx;
  background: #ffffff;
}

.me-avatar-plus::after {
  content: "";
  position: absolute;
  width: 2rpx;
  height: 14rpx;
  background: #ffffff;
}

.me-header-info {
  flex: 1;
  min-width: 0;
}

.me-greeting {
  font-size: 40rpx;
  font-weight: 600;
  color: #3a2a2d;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.me-meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.me-tag {
  font-size: 22rpx;
  color: #8a3a48;
  background: #f6e3df;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  font-weight: 500;
}

/* 管理员专享入口 (黑金高定典藏卡) */
.me-manager-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #2D1418 0%, #1A0B0E 100%);
  border: 1px solid rgba(248, 223, 176, 0.35);
  border-radius: 24rpx;
  margin-top: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(45, 20, 24, 0.25);
  cursor: pointer;
  transition: transform 0.15s ease;
}

.me-manager-row:active {
  transform: scale(0.98);
}

.me-manager-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.me-manager-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #F8DFB0;
  letter-spacing: 1rpx;
}

.me-manager-desc {
  font-size: 22rpx;
  color: rgba(248, 223, 176, 0.75);
}

.me-manager-arrow {
  font-size: 36rpx;
  color: #F8DFB0;
  font-weight: 300;
}

/* 训练数据 */
.me-section {
  margin-bottom: 40rpx;
}

.me-section-head {
  margin-bottom: 20rpx;
}

.me-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3a2a2d;
  letter-spacing: 0.5rpx;
}

.me-total-block {
  padding: 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1px solid #efe4dc;
  box-shadow: 0 8rpx 24rpx rgba(138, 58, 72, 0.05);
  box-sizing: border-box;
}

.me-total-label {
  font-size: 24rpx;
  color: #7a6a6c;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.me-total-num-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.me-total-num {
  font-family: var(--font-num);
  font-size: 80rpx;
  font-weight: 600;
  color: #8a3a48;
  line-height: 1;
}

.me-total-unit {
  font-size: 28rpx;
  color: #8a3a48;
  font-weight: 500;
}

.me-total-note {
  font-size: 23rpx;
  color: #a8999b;
  display: block;
}

.me-course-list {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1px solid #efe4dc;
  margin-top: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(138, 58, 72, 0.04);
}

.me-course-name {
  font-size: 28rpx;
  color: #3a2a2d;
}

.me-course-count {
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 600;
  color: #8a3a48;
}

/* 列表行导航菜单 */
.me-menu-section {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1px solid #efe4dc;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(138, 58, 72, 0.05);
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1px solid #f6f0ea;
  box-sizing: border-box;
  transition: background-color 0.15s ease;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row:active {
  background-color: #fdfaf7;
}

.me-menu-title {
  font-size: 28rpx;
  color: #3a2a2d;
  letter-spacing: 0.5rpx;
}

.list-row__arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2px solid #c9c0b8;
  border-right: 2px solid #c9c0b8;
  transform: rotate(45deg);
}

.me-logout-row {
  margin-top: 8rpx;
  border-top: 1px solid #f6f0ea;
}

.me-logout-text {
  color: #a8999b !important;
  font-size: 26rpx;
}

.me-bottom-space {
  height: calc(104rpx + 28rpx + env(safe-area-inset-bottom) + 40rpx);
}
