<view class="me-container">
  
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">正在呈递你的私享手札...</text>
  </view>

  <!-- 正常内容 -->
  <block wx:else>

    <!-- 模块一：会员尊享画卷 (Member Sanctuary Profile) -->
    <view class="profile-editorial-hero stagger-1">
      <view class="avatar-editorial-wrap" bindtap="handleAvatarTap">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <text wx:else class="avatar-placeholder">{{initial}}</text>
        <view class="avatar-edit-badge">写真</view>
      </view>

      <view class="profile-hero-meta">
        <text class="profile-name">{{memberName}}</text>
        <view class="profile-status-line">
          <text class="profile-tier-text">{{joinDays >= 365 ? '资深自律挚友' : '身体掌权者'}}</text>
          <text class="status-dot">·</text>
          <text class="profile-days-text" wx:if="{{joinDays > 0}}">相伴自律 {{formattedDays}} 天</text>
          <text class="profile-days-text" wx:else>相伴自律启程之日</text>
        </view>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- 模块二：私享预约席位 (The Private Concierge) -->
    <view class="concierge-editorial-card stagger-2" bindtap="navigateToBooking">
      <view class="concierge-content">
        <view class="concierge-tag">
          <text class="concierge-code">CONCIERGE</text>
          <text class="concierge-dot">/</text>
          <text class="concierge-label">私享排课</text>
        </view>
        <text class="concierge-title">预约专属私享席位</text>
        <text class="concierge-desc">调整核心床私教排课，可在此轻点或直联导师小桥</text>
      </view>
      <view class="concierge-arrow-wrap">
        <text class="concierge-arrow">→</text>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- 模块三：身体资产档案 (Body Portfolio) -->
    <view class="portfolio-section stagger-3">
      <view class="section-editorial-header">
        <view class="section-tag-group">
          <text class="section-num">01</text>
          <text class="section-title">身体资产档案</text>
        </view>
        <text class="section-en">PORTFOLIO</text>
      </view>

      <!-- 4 宫格开放式排印度量 (4-Metric Editorial Grid) -->
      <view class="portfolio-metrics-grid">
        <view class="portfolio-metric-box">
          <text class="metric-val metric-stage">{{stageName}}</text>
          <text class="metric-caption">塑形进阶阶段</text>
        </view>
        <view class="portfolio-metric-box">
          <text class="metric-val">{{trainCount || 0}}<text class="metric-unit">节</text></text>
          <text class="metric-caption">私教训练课时</text>
        </view>
        <view class="portfolio-metric-box">
          <text class="metric-val">{{questionnaireCount || 0}}<text class="metric-unit">次</text></text>
          <text class="metric-caption">体态深度测评</text>
        </view>
        <view class="portfolio-metric-box">
          <text class="metric-val">{{photoCount || 0}}<text class="metric-unit">组</text></text>
          <text class="metric-caption">身形蜕变定格</text>
        </view>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline" wx:if="{{feelings.length > 0}}"></view>

    <!-- 模块四：我的私享便签 (Private Notes) -->
    <view class="notes-history-section stagger-4" wx:if="{{feelings.length > 0}}">
      <view class="section-editorial-header">
        <view class="section-tag-group">
          <text class="section-num">02</text>
          <text class="section-title">我的私享便签</text>
        </view>
        <text class="section-en">INTIMATE NOTES</text>
      </view>

      <view class="notes-feed">
        <view wx:for="{{feelings}}" wx:key="id" class="note-feed-card">
          <text class="note-feed-body">“{{item.feeling}}”</text>
          <view wx:if="{{item.xiaoqiaoReply}}" class="note-reply-bar">
            <view class="reply-seal">印</view>
            <view class="reply-text-wrap">
              <text class="reply-lead">小桥回音 · 亲笔</text>
              <text class="reply-quote">{{item.xiaoqiaoReply}}</text>
            </view>
          </view>
          <text class="note-feed-date">{{item.createdAt}}</text>
        </view>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline" wx:if="{{bookings.length > 0}}"></view>

    <!-- 模块五：我的预约 (Bookings) -->
    <view class="bookings-section stagger-5" wx:if="{{bookings.length > 0}}">
      <view class="section-editorial-header">
        <view class="section-tag-group">
          <text class="section-num">03</text>
          <text class="section-title">我的私享排课</text>
        </view>
        <text class="section-en">SCHEDULE</text>
      </view>

      <view class="bookings-spine-list">
        <view wx:for="{{bookings}}" wx:key="id" class="booking-spine-item">
          <view class="booking-time-block">
            <text class="booking-date-text">{{item.bookingDate}}</text>
            <text class="booking-time-text">{{item.bookingTime}}</text>
          </view>
          <view class="booking-body-block">
            <text class="booking-type-text">{{item.courseType}}</text>
            <text class="booking-status-tag status-{{item.status}}">
              {{item.status === "pending" ? "待确认" : item.status === "confirmed" ? "已确认" : "已取消"}}
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- 极细发丝分隔律动线 -->
    <view class="editorial-hairline"></view>

    <!-- 模块六：账号操作 (Account Operations) -->
    <view class="account-actions-editorial stagger-5">
      <view class="logout-link-editorial" bindtap="handleLogout">
        <text class="logout-txt">暂时离开手札</text>
      </view>
    </view>

  </block>
</view>
