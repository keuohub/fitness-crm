<view class="me-container">

  <!-- 顶部标题区 (避开顶部刘海与状态栏，呈现从容留白) -->
  <view class="me-hero-header">
    <view class="me-title-wrap">
      <text class="me-hero-title">我的账户</text>
      <text class="me-hero-subtitle">自律是赠予自己最珍贵的资产</text>
    </view>
  </view>

  <!-- 模块一：黑金高奢会员身份画卷 (Black Obsidian Member Card，严禁展示电话号码) -->
  <view class="member-obsidian-card">
    <view class="card-top-row">
      <view class="card-brand-mark">
        <text class="card-brand-en">LAIWU</text>
        <text class="card-brand-tier">会员档案</text>
      </view>
      <text class="card-status-pill">活跃会员</text>
    </view>

    <view class="card-profile-row">
      <view class="card-avatar-wrap" bindtap="handleAvatarTap">
        <image wx:if="{{avatarUrl}}" class="card-avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <text wx:else class="card-avatar-placeholder">{{initial}}</text>
        <view class="card-avatar-edit-badge">写真</view>
      </view>

      <view class="card-profile-info">
        <text class="card-member-name">{{memberName}}</text>
        <text class="card-member-code">卡号 · {{memberCode}}</text>
      </view>
    </view>

    <view class="card-footer-row">
      <view class="card-footer-item">
        <text class="footer-label">入会日期</text>
        <text class="footer-val">{{joinedAt}}</text>
      </view>
      <view class="card-footer-item">
        <text class="footer-label">专属导师</text>
        <text class="footer-val">{{mentorName}}</text>
      </view>
      <view class="card-footer-item">
        <text class="footer-label">伴行天数</text>
        <text class="footer-val">{{joinDays}} 天</text>
      </view>
    </view>
  </view>

  <!-- 极细发丝分隔律动线 -->
  <view class="editorial-hairline"></view>

  <!-- 模块二：身体资产矩阵 (01 ASSET PORTFOLIO - 总课时数在上方突出，各分课时在下方) -->
  <view class="me-section">
    <view class="section-title-bar">
      <view class="section-tag-group">
        <text class="section-index">01</text>
        <text class="section-heading">训练度量资产</text>
      </view>
      <text class="section-en-label">PORTFOLIO</text>
    </view>
    <text class="section-intro">每一次深层对抗与呼吸，都在沉淀为可被验证的内在力量。</text>

    <!-- 顶部突出大字卡片：总课时数 -->
    <view class="total-hours-hero-card">
      <view class="total-hours-content">
        <view class="total-hours-header">
          <text class="total-hours-badge-label">累计完成训练</text>
          <text class="total-hours-stage-pill">{{stageName}}</text>
        </view>
        <view class="total-hours-num-row">
          <text class="total-hours-big">{{totalHours}}</text>
          <text class="total-hours-unit">节课时</text>
        </view>
        <text class="total-hours-footnote">包含垫上核心、大器械阻力对抗与专属超模减脂训练</text>
      </view>
    </view>

    <!-- 下方网格：各分课时明细 (后台可实时更改同步) -->
    <view class="sub-hours-grid">
      <view class="sub-hour-card">
        <view class="sub-hour-top">
          <text class="sub-hour-name">精选普拉提</text>
          <view class="sub-hour-count-wrap">
            <text class="sub-hour-count">{{hoursPilates}}</text>
            <text class="sub-hour-unit">节</text>
          </view>
        </view>
        <text class="sub-hour-desc">垫上核心与呼吸模式激活</text>
      </view>

      <view class="sub-hour-card">
        <view class="sub-hour-top">
          <text class="sub-hour-name">高定大器械</text>
          <view class="sub-hour-count-wrap">
            <text class="sub-hour-count">{{hoursEquipment}}</text>
            <text class="sub-hour-unit">节</text>
          </view>
        </view>
        <text class="sub-hour-desc">核心床与阻力深层雕刻</text>
      </view>

      <view class="sub-hour-card">
        <view class="sub-hour-top">
          <text class="sub-hour-name">超模减脂班</text>
          <view class="sub-hour-count-wrap">
            <text class="sub-hour-count">{{hoursFatBurn}}</text>
            <text class="sub-hour-unit">节</text>
          </view>
        </view>
        <text class="sub-hour-desc">间歇燃脂与直角肩塑形</text>
      </view>

      <view class="sub-hour-card">
        <view class="sub-hour-top">
          <text class="sub-hour-name">体态深度测评</text>
          <view class="sub-hour-count-wrap">
            <text class="sub-hour-count">{{questionnaireCount}}</text>
            <text class="sub-hour-unit">次</text>
          </view>
        </view>
        <text class="sub-hour-desc">医学级临床影像跟踪</text>
      </view>
    </view>
  </view>

  <!-- 极细发丝分隔律动线 -->
  <view class="editorial-hairline"></view>

  <!-- 模块三：我的私享便签与回音 (02 INTIMATE FEEDBACKS - 富有情绪价值，让会员有截图分享欲) -->
  <view class="me-section" wx:if="{{feelings.length > 0}}">
    <view class="section-title-bar">
      <view class="section-tag-group">
        <text class="section-index">02</text>
        <text class="section-heading">反馈与导师回音</text>
      </view>
      <text class="section-en-label">ARCHIVE</text>
    </view>
    <text class="section-intro">你在手札中记录的每一次体感变化，小桥的温暖回音皆妥善收录于此。</text>

    <view class="feedback-feed-list">
      <view wx:for="{{feelings}}" wx:key="id" class="feedback-feed-item">
        <view class="feedback-date-row">
          <text class="feedback-date-badge">{{item.date}}</text>
          <text class="feedback-share-tip">可截图分享</text>
        </view>
        <text class="feedback-user-quote">“{{item.feeling}}”</text>

        <view class="mentor-reply-block" wx:if="{{item.xiaoqiaoReply}}">
          <view class="reply-seal-tag">印</view>
          <view class="reply-text-col">
            <text class="reply-mentor-title">导师小桥 · 亲笔手札回音</text>
            <text class="reply-mentor-body">{{item.xiaoqiaoReply}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部留白防遮挡 -->
  <view class="dock-spacer"></view>

</view>
