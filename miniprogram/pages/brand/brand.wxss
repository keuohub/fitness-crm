/* pages/brand/brand.wxss
   了解徕舞 · 品牌介绍
   纯白底 · 直角无阴影 · 真实照片展现
   ============================================================ */

page {
  background-color: #FDFCF9;
  color: #000000;
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}

.brand-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 40rpx;
}

/* 顶部标题区 */
.brand-hero-header {
  padding-bottom: 48rpx;
}

.brand-hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.3;
}

/* 模块通用样式 */
.brand-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 64rpx;
}

.section-title-bar {
  margin-bottom: 8rpx;
}

.section-heading {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.35;
}

.section-intro {
  font-size: 24rpx;
  color: #54555b;
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 场馆：与导师同一套横滑卡片节奏，全部等宽并排 */
.venue-scroll {
  width: 100%;
  white-space: nowrap;
}

.venue-card {
  display: inline-block;
  width: 500rpx;
  margin-right: 24rpx;
  vertical-align: top;
}

.venue-card-media {
  position: relative;
  width: 500rpx;
  height: 375rpx;
  overflow: hidden;
  background-color: #f4f2ed;
}

.venue-card-img {
  width: 500rpx;
  height: 375rpx;
  object-fit: cover;
  display: block;
  border-radius: 0;
  background-color: #f4f2ed;
}

.venue-card-tag {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  max-width: 380rpx;
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.venue-card-count {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: #1a1a1a;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
}

/* 标题与描述块，与导师卡保持同一节奏 */
.venue-meta {
  padding-top: 16rpx;
}

.venue-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
  display: block;
  line-height: 1.4;
}

.venue-desc {
  font-size: 24rpx;
  color: #54555b;
  line-height: 1.5;
  margin-top: 4rpx;
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 导师横滑（宽 400rpx，3:4） */
.team-scroll {
  width: 100%;
  white-space: nowrap;
}

.mentor-card {
  display: inline-block;
  width: 400rpx;
  margin-right: 24rpx;
  vertical-align: top;
}

.mentor-avatar {
  width: 400rpx;
  height: calc(400rpx * 4 / 3);
  object-fit: cover;
  display: block;
  border-radius: 0;
  background-color: #efeae2;
}

.mentor-meta {
  padding-top: 16rpx;
}

.mentor-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  display: block;
  line-height: 1.4;
}

.mentor-role {
  font-size: 24rpx;
  color: #54555b;
  display: block;
  margin-top: 4rpx;
  line-height: 1.4;
}

/* 课程介绍（满宽 16:9） */
.offerings-list {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.offering-card {
  width: 100%;
  box-sizing: border-box;
}

.offering-img {
  width: 100%;
  height: calc((100vw - 64rpx) * 9 / 16);
  object-fit: cover;
  display: block;
  border-radius: 0;
  background-color: #efeae2;
}

.offering-content {
  padding-top: 20rpx;
}

.offering-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
  display: block;
  line-height: 1.35;
  margin-bottom: 8rpx;
}

.offering-summary {
  font-size: 28rpx;
  color: #000000;
  line-height: 1.5;
  display: block;
  margin-bottom: 8rpx;
}

.offering-target {
  font-size: 24rpx;
  color: #54555b;
  line-height: 1.5;
  display: block;
  margin-bottom: 4rpx;
}

.offering-highlight {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
  display: block;
}

/* 底部防遮挡垫片 */
.dock-spacer {
  height: calc(100rpx + env(safe-area-inset-bottom) + 32rpx);
}
