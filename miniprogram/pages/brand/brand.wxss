/* pages/brand/brand.wxss
   了解徕舞 · 品牌殿堂 (对标 Cartier 典藏与 Lululemon 品牌画册)
   暖砂白主色调 · 克制留白 · 8px/16px/24px 网格系统
   ============================================================ */

page {
  background-color: #F6E6DA;
  color: #1A181E;
  font-family: -apple-system, "PingFang SC", "Songti SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.brand-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 80rpx) 40rpx 0;
}

/* 顶部轻奢导航头 */
.brand-hero-header {
  padding-bottom: 32rpx;
}

.brand-pill-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(13, 12, 15, 0.05);
  border: 1rpx solid rgba(13, 12, 15, 0.12);
  border-radius: 30rpx;
  margin-bottom: 24rpx;
}

.tag-letter {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: #1A181E;
}

.tag-slash {
  font-size: 18rpx;
  color: #A0968E;
}

.tag-sub {
  font-size: 20rpx;
  color: #6D645D;
  letter-spacing: 0.04em;
}

.brand-title-wrap {
  display: flex;
  flex-direction: column;
}

.brand-hero-title {
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 56rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.06em;
  line-height: 1.2;
}

.brand-hero-subtitle {
  font-size: 26rpx;
  color: #726A63;
  margin-top: 14rpx;
  letter-spacing: 0.04em;
  line-height: 1.5;
}

/* 极细发丝分隔律动线 */
.editorial-hairline {
  height: 1rpx;
  background: rgba(140, 130, 122, 0.18);
  margin: 36rpx 0;
}

/* 模块通用样式 */
.brand-section {
  display: flex;
  flex-direction: column;
}

.section-title-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-tag-group {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.section-index {
  font-family: "Didot", "Playfair Display", serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #9E2A2B;
  letter-spacing: 0.04em;
}

.section-heading {
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.06em;
}

.section-en-label {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: #A39991;
  font-weight: 500;
}

.section-intro {
  font-size: 24rpx;
  color: #6E6660;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

/* 场馆横滑画廊 */
.venue-gallery-scroll {
  width: 100%;
  white-space: nowrap;
  padding-bottom: 12rpx;
}

.venue-card-item {
  display: inline-block;
  width: 520rpx;
  margin-right: 28rpx;
  vertical-align: top;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 28rpx -6rpx rgba(13, 12, 15, 0.06);
  overflow: hidden;
  transition: transform 200ms ease;
}

.venue-card-item:active {
  transform: scale(0.98);
}

.venue-image-wrap {
  width: 100%;
  height: 320rpx;
  position: relative;
  overflow: hidden;
}

.venue-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.venue-tag-overlay {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  z-index: 2;
}

.venue-tag-pill {
  font-size: 20rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: rgba(13, 12, 15, 0.55);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.venue-meta {
  padding: 24rpx 22rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.venue-name {
  font-family: "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
}

.venue-desc {
  font-size: 22rpx;
  color: #6D655E;
  line-height: 1.5;
  white-space: normal;
}

/* 导师团队 */
.team-cards-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.mentor-card {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx -8rpx rgba(13, 12, 15, 0.05);
  transition: transform 200ms ease;
}

.mentor-card:active {
  transform: scale(0.985);
}

.mentor-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.mentor-avatar {
  width: 130rpx;
  height: 150rpx;
  border-radius: 18rpx;
  object-fit: cover;
  flex-shrink: 0;
  border: 1rpx solid rgba(13, 12, 15, 0.08);
}

.mentor-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.mentor-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.mentor-name {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.04em;
}

.mentor-role-badge {
  font-size: 20rpx;
  font-weight: 500;
  color: #9E2A2B;
  background: rgba(158, 42, 43, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(158, 42, 43, 0.18);
}

.mentor-exp {
  font-size: 22rpx;
  color: #554E48;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.mentor-creds {
  font-size: 20rpx;
  color: #8C827B;
  line-height: 1.45;
}

.mentor-quote-box {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(246, 230, 222, 0.55);
  border-left: 4rpx solid #9E2A2B;
  border-radius: 0 14rpx 14rpx 0;
}

.mentor-quote {
  font-size: 23rpx;
  color: #4A433D;
  line-height: 1.6;
  font-style: italic;
}

/* 5大核心项目卡片 (严格无预约入口) */
.offerings-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.offering-card {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx -8rpx rgba(13, 12, 15, 0.06);
}

.offering-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.offering-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #0E0D10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.offering-num {
  font-family: "Didot", "Playfair Display", serif;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.offering-names {
  display: flex;
  flex-direction: column;
}

.offering-title {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.05em;
}

.offering-en {
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: #948A82;
  font-weight: 500;
}

.offering-summary-pill {
  display: inline-flex;
  padding: 8rpx 20rpx;
  background: rgba(158, 42, 43, 0.06);
  border-radius: 20rpx;
  margin-bottom: 22rpx;
}

.offering-summary-txt {
  font-size: 22rpx;
  font-weight: 500;
  color: #9E2A2B;
  letter-spacing: 0.03em;
}

.offering-detail-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-top: 1rpx solid rgba(140, 130, 122, 0.14);
  padding-top: 20rpx;
}

.detail-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-label {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #8C827B;
}

.detail-content {
  font-size: 24rpx;
  color: #3D3732;
  line-height: 1.6;
}

/* 底部防遮挡垫片 */
.dock-spacer {
  height: calc(env(safe-area-inset-bottom) + 210rpx);
}
