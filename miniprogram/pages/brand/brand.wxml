<view class="brand-container">
  <view class="nav-row" style="padding-top: {{nav.navTop}}px; height: {{nav.navH}}px;">
    <view class="nav-back" bindtap="navBack"><view class="nav-back-arrow"></view></view>
  </view>
  <view class="nav-gap"></view>

  <!-- 顶部标题区 -->
  <view class="brand-hero-header">
    <text class="brand-hero-title">{{heroTitle || '了解徕舞'}}</text>
  </view>

  <!-- 空状态：三块全空时显示 -->
  <view wx:if="{{venueList.length === 0 && teamList.length === 0 && offeringsList.length === 0}}" class="empty-state">
    <text>内容在准备中</text>
  </view>

  <block wx:else>

    <!-- 板块一：场馆空间 -->
    <view class="brand-section" wx:if="{{venueList.length > 0}}">
      <view class="section-title-bar">
        <text class="section-heading">{{sec1Title || '场馆空间'}}</text>
      </view>
      <text class="section-intro" wx:if="{{sec1Intro}}">{{sec1Intro}}</text>

      <!-- 第一张满宽 4:3 大图 -->
      <view class="venue-hero-card" bindtap="previewVenueImage" data-src="{{venueList[0].imageUrl}}">
        <image
          wx:if="{{!venueList[0].imgFailed}}"
          class="venue-hero-img"
          src="{{venueList[0].imageUrl}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          binderror="onImgError"
          data-key="venueList"
          data-index="0"
        />
        <view wx:else class="img-fallback venue-hero-img"></view>
        <view class="venue-meta">
          <text class="venue-name">{{venueList[0].name}}</text>
          <text class="venue-desc" wx:if="{{venueList[0].desc}}">{{venueList[0].desc}}</text>
        </view>
      </view>

      <!-- 其余横滑（宽 600rpx，4:3） -->
      <scroll-view wx:if="{{venueList.length > 1}}" class="venue-scroll" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
        <view
          wx:for="{{venueList}}"
          wx:key="id"
          wx:if="{{index > 0}}"
          class="venue-scroll-card"
          bindtap="previewVenueImage"
          data-src="{{item.imageUrl}}"
        >
          <image
            wx:if="{{!item.imgFailed}}"
            class="venue-scroll-img"
            src="{{item.imageUrl}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            binderror="onImgError"
            data-key="venueList"
            data-index="{{index}}"
          />
          <view wx:else class="img-fallback venue-scroll-img"></view>
          <view class="venue-meta">
            <text class="venue-name">{{item.name}}</text>
            <text class="venue-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 板块二：同行导师 -->
    <view class="brand-section" wx:if="{{teamList.length > 0}}">
      <view class="section-title-bar">
        <text class="section-heading">{{sec2Title || '同行导师'}}</text>
      </view>
      <text class="section-intro" wx:if="{{sec2Intro}}">{{sec2Intro}}</text>

      <scroll-view class="team-scroll" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
        <view
          wx:for="{{teamList}}"
          wx:key="id"
          class="mentor-card"
          bindtap="previewTeamImage"
          data-src="{{item.avatarUrl}}"
        >
          <image
            wx:if="{{!item.imgFailed}}"
            class="mentor-avatar"
            src="{{item.avatarUrl}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            binderror="onImgError"
            data-key="teamList"
            data-index="{{index}}"
          />
          <view wx:else class="img-fallback mentor-avatar"></view>
          <view class="mentor-meta">
            <text class="mentor-name">{{item.name}}</text>
            <text class="mentor-role" wx:if="{{item.roleTitle}}">{{item.roleTitle}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 板块三：项目介绍 -->
    <view class="brand-section offerings-section" wx:if="{{offeringsList.length > 0}}">
      <view class="section-title-bar">
        <text class="section-heading">{{sec3Title || '项目介绍'}}</text>
      </view>
      <text class="section-intro" wx:if="{{sec3Intro}}">{{sec3Intro}}</text>

      <view class="offerings-list">
        <view
          wx:for="{{offeringsList}}"
          wx:key="id"
          class="offering-card"
        >
          <image
            wx:if="{{item.imageUrl && !item.imgFailed}}"
            class="offering-img"
            src="{{item.imageUrl}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            binderror="onImgError"
            data-key="offeringsList"
            data-index="{{index}}"
          />
          <view wx:elif="{{item.imageUrl && item.imgFailed}}" class="img-fallback offering-img"></view>

          <view class="offering-content">
            <text class="offering-title">{{item.name}}</text>
            <text class="offering-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
            <text class="offering-target" wx:if="{{item.target}}">适合：{{item.target}}</text>
            <text class="offering-highlight" wx:if="{{item.highlight}}">{{item.highlight}}</text>
          </view>
        </view>
      </view>
    </view>

  </block>

  <!-- 底部防遮挡垫片 -->
  <view class="dock-spacer"></view>

</view>
