/* pages/login · 统一登录（粉白美学版） */

page {
  background-color: #FDFCF9;
  color: #1A1A1A;
  font-family: var(--font-sans);
  min-height: 100vh;
  box-sizing: border-box;
}

.login-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 80rpx) 56rpx calc(env(safe-area-inset-bottom) + 80rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(180deg, #FBF1EE 0%, #FDF7F5 28%, #FDFCF9 65%, #FFFFFF 100%);
}

/* 品牌区 */
.brand {
  text-align: center;
  margin-bottom: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-name {
  display: block;
  font-size: 88rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  line-height: 1.15;
}

.brand-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #B92E32;
  letter-spacing: 6rpx;
}

/* 输入表单 */
.input-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.invite-input {
  width: 100%;
  box-sizing: border-box;
  height: 104rpx;
  padding: 0 36rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(185, 46, 50, 0.16);
  border-radius: 22rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  box-shadow: 0 6rpx 20rpx rgba(185, 46, 50, 0.04);
  transition: all 0.2s ease;
}

.invite-input:focus {
  border-color: #B92E32;
  box-shadow: 0 8rpx 24rpx rgba(185, 46, 50, 0.1);
  background: #FFFFFF;
}

.phone-suffix-input {
  background: #FFFFFF;
}

.input-placeholder {
  color: #A39B95;
  font-size: 26rpx;
}

/* 提示文案 */
.login-hint {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8C827A;
  text-align: center;
}

/* 主登录按钮：徕舞胭脂绛红渐变 */
.login-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #8C1C20 0%, #B92E32 50%, #C93337 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(185, 46, 50, 0.28);
  transition: all 0.15s ease;
}

.login-btn:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.login-btn[disabled] {
  background: #E8D7D5 !important;
  color: #FFFFFF !important;
  box-shadow: none !important;
}

/* 先逛逛 */
.guest-skip-wrap {
  margin-top: 32rpx;
  padding: 16rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.guest-skip-text {
  font-size: 24rpx;
  color: #B92E32;
  letter-spacing: 1rpx;
  text-decoration: underline;
  text-underline-offset: 6rpx;
  font-weight: 500;
}

.guest-skip-wrap:active .guest-skip-text {
  opacity: 0.7;
}

/* 错误提示卡片 */
.error-text {
  display: block;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #B91C1C;
  background: #FDF2F2;
  border: 1rpx solid #FACDCD;
  border-radius: 16rpx;
  line-height: 1.5;
}

/* 底部说明 */
.footer-wrap {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.footer-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #A39B95;
}
