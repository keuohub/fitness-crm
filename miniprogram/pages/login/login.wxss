/* pages/login · 登录 */

page {
  background-color: var(--c-bg, #ffffff);
  color: var(--c-text, #222222);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}

.login-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 80rpx) 56rpx calc(env(safe-area-inset-bottom) + 80rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.brand {
  text-align: center;
  margin-bottom: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-name {
  display: block;
  font-family: var(--font-sans);
  font-size: 56rpx;
  font-weight: 700;
  color: var(--c-title, #000000);
  letter-spacing: 0;
  line-height: 1.2;
}

.brand-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--c-muted, #666666);
  letter-spacing: 0;
}

.guide {
  text-align: center;
  margin-bottom: 40rpx;
}

.guide-text {
  font-size: var(--fs-sub, 26rpx);
  color: var(--c-muted, #666666);
  letter-spacing: 0;
}

.input-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.invite-input {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border: 4rpx solid var(--c-line, #e8e8e8);
  border-radius: 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--c-title, #000000);
  box-shadow: none;
  transition: border-color var(--dur-fast) var(--ease);
}

.invite-input:focus {
  border-color: #000000;
}

.phone-suffix-input {
  font-size: 28rpx;
  background: #ffffff;
}

.input-placeholder {
  color: var(--c-hint, #999999);
  font-size: var(--fs-caption, 24rpx);
}

.login-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--c-muted, #666666);
  text-align: center;
}

.login-btn {
  margin-top: 36rpx;
  width: 100%;
}

.guest-skip-wrap {
  margin-top: 28rpx;
  padding: 16rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.guest-skip-text {
  font-size: var(--fs-caption, 24rpx);
  color: var(--c-title, #000000);
  letter-spacing: 0;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.guest-skip-wrap:active .guest-skip-text {
  opacity: 0.7;
}

.error-text {
  display: block;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  text-align: center;
  font-size: var(--fs-caption, 24rpx);
  color: var(--c-text, #222222);
  background: var(--c-card-soft, #f6f6f6);
  border: 1px solid var(--c-line, #e8e8e8);
  border-radius: 0;
}

.footer-wrap {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.footer-note {
  display: block;
  text-align: center;
  font-size: var(--fs-micro, 22rpx);
  color: var(--c-hint, #999999);
}

/* ===== v2.2 深色沉浸（BRIEF_06 §5.6） ===== */
page, .login-container { background-color: #141414 !important; color: #ffffff; }
.brand-name { color: #ffffff !important; font-size: 104rpx !important; font-weight: 700 !important; letter-spacing: -1rpx; line-height: 1.1; }
.brand-subtitle, .guide-text, .login-hint, .footer-note { color: rgba(255, 255, 255, 0.72) !important; }
.input-card { background: transparent !important; border: none !important; }
.invite-input { background: #1f1f1f !important; color: #ffffff !important; border: 1px solid rgba(255, 255, 255, 0.16) !important; border-radius: 0 !important; }
.invite-input:focus { border-color: #ffffff !important; }
.input-placeholder { color: rgba(255, 255, 255, 0.48) !important; }
.login-btn { background: #ffffff !important; color: #000000 !important; }
.login-btn[disabled] { background: rgba(255, 255, 255, 0.48) !important; color: #000000 !important; }
.guest-skip-text { color: rgba(255, 255, 255, 0.72) !important; }
.error-text { color: #ffffff !important; background: #1f1f1f !important; border: none !important; }
