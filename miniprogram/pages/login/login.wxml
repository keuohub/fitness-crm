<view class="login-container">
  
  <!-- 品牌标识区 -->
  <view class="brand">
    <text class="brand-name">徕舞</text>
    <text class="brand-subtitle">女子塑形</text>
  </view>

  <!-- 统一登录卡片：同唯一登录入口，输入学员信息进学员端，输入管理员账号密码进管理端 -->
  <view class="input-card">
    <input
      class="invite-input"
      value="{{accountInput}}"
      placeholder="请输入手机号或管理员账号"
      placeholder-class="input-placeholder"
      bindinput="onAccountInput"
      maxlength="50"
      confirm-type="next"
    />
    <input
      class="invite-input phone-suffix-input"
      value="{{passwordInput}}"
      password="true"
      placeholder="请输入密码（手机后4位或管理密码）"
      placeholder-class="input-placeholder"
      bindinput="onPasswordInput"
      maxlength="50"
      confirm-type="go"
      bindconfirm="handleUnifiedLogin"
    />
  </view>

  <text class="login-hint">老会员请输入入会手机号与后4位；管理人员输入管理账号与密码</text>

  <!-- 登录按钮 -->
  <button class="btn-primary login-btn" bindtap="handleUnifiedLogin" loading="{{submitting}}" disabled="{{submitting}}">
    {{submitting ? "正在验证身份..." : "登 录"}}
  </button>

  <!-- 暂不登录 / 返回首页体验 -->
  <view class="guest-skip-wrap" bindtap="handleSkipLogin">
    <text class="btn-text guest-skip-text">先逛逛，看看徕舞的课</text>
  </view>

  <!-- 错误提示 -->
  <text wx:if="{{error}}" class="error-text">{{error}}</text>

  <!-- 底部说明 -->
  <view class="footer-wrap">
    <text class="footer-note">还未在馆内建档？加小桥微信，约一节体验课</text>
  </view>

</view>
