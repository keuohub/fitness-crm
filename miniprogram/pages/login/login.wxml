<view class="login-container">
  
  <!-- 品牌标识区 -->
  <view class="brand">
    <text class="brand-name">徕舞</text>
    <text class="brand-subtitle">女子塑形</text>
  </view>


  <!-- 专属卡号 / 邀请码 + 6位安全PIN码 -->
  <view class="input-card">
    <input
      class="invite-input"
      value="{{inviteCode}}"
      placeholder="会员卡号 / 专属邀请码 (如 LW8866)"
      placeholder-class="input-placeholder"
      bindinput="onCodeInput"
      maxlength="20"
      confirm-type="next"
    />
    <input
      class="invite-input phone-suffix-input"
      value="{{phoneSuffix}}"
      placeholder="会员登录 PIN 码"
      placeholder-class="input-placeholder"
      bindinput="onPhoneSuffixInput"
      maxlength="6"
      type="number"
      confirm-type="go"
      bindconfirm="handleLogin"
    />
  </view>

  <text class="login-hint">老会员请使用馆长小桥为你配置的卡号与 6 位专属 PIN 码登录</text>

  <!-- 登录按钮 -->
  <button class="btn-primary login-btn" bindtap="handleLogin" loading="{{submitting}}" disabled="{{submitting}}">
    {{submitting ? "正在开启档案..." : "开启专属成长手札"}}
  </button>

  <!-- 暂不登录 / 返回首页体验 -->
  <view class="guest-skip-wrap" bindtap="handleSkipLogin">
    <text class="btn-text guest-skip-text">先逛逛，看看徕舞的课</text>
  </view>

  <!-- 错误提示 -->
  <text wx:if="{{error}}" class="error-text">{{error}}</text>

  <!-- 底部说明 -->
  <view class="footer-wrap">
    <text class="footer-note">还未取得专属卡号？加小桥微信，约一节体验课</text>
  </view>

</view>
