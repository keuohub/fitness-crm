<page-meta page-style="overflow: hidden; height: 100vh;"></page-meta>

<view class="stars-viewport">

  <!-- 全屏满幅横滑画报 (100vh Full-Bleed Horizontal Swiper) -->
  <swiper
    class="stars-swiper"
    current="{{currentIndex}}"
    bindchange="onSwiperChange"
    duration="420"
    circular="{{true}}"
    easing-function="easeInOutCubic"
  >
    <swiper-item wx:for="{{starsList}}" wx:key="id" class="star-slide-item">
      <view class="image-wrapper">
        <image
          class="star-hero-img"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          bindtap="onImageTap"
          data-src="{{item.avatarUrl}}"
        />
        <!-- 顶部温润微晕影 -->
        <view class="vignette-top"></view>
        <!-- 底部深邃渐变晕影，烘托文本与胶囊栏 -->
        <view class="vignette-bottom"></view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 浮动信息图层 (Editorial Lower Third - Above Dock) -->
  <view class="stars-floating-overlay">
    <!-- 伴行历程与上课信息（无标签纯净版） -->
    <view class="star-meta-row" wx:if="{{currentStar.journey}}">
      <text class="star-journey-text">{{currentStar.journey}}</text>
    </view>

    <!-- 会员姓名行 -->
    <view class="star-name-row">
      <text class="star-name">{{currentStar.name}}</text>
      <text class="star-name-en">MEMBER OF LAIWU</text>
    </view>

    <!-- 会员自律体态心语 -->
    <text class="star-quote-text" wx:if="{{currentStar.quote}}">{{currentStar.quote}}</text>

    <!-- lululemon 级别细长药丸指示器 (Elongated Pill Indicator) -->
    <view class="pill-indicator-track">
      <view
        wx:for="{{starsList}}"
        wx:key="id"
        class="indicator-item {{index === currentIndex ? 'indicator-pill-active' : 'indicator-dot'}}"
        data-index="{{index}}"
        bindtap="jumpToSlide"
      ></view>
    </view>
  </view>

  <!-- 无真实月度之星：空状态，绝不展示虚构会员 -->
  <view wx:if="{{!loading && starsList.length === 0}}" style="position:fixed;left:0;right:0;top:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 90rpx;text-align:center;background:linear-gradient(170deg,#F5E5D9 0%,#D4423C 100%);">
    <text style="font-size:22rpx;letter-spacing:4rpx;color:rgba(255,255,255,.7);">MONTHLY STARS</text>
    <text style="margin-top:26rpx;font-size:46rpx;font-weight:600;color:#FFFFFF;font-family:serif;">本月之星 · 名单待定</text>
    <text style="margin-top:22rpx;font-size:25rpx;line-height:1.9;color:rgba(255,255,255,.85);">我们只在本人点头之后，才放上她的照片和故事。这一期还在等她们答复。</text>
  </view>
  <view wx:if="{{loading}}" style="position:fixed;left:0;right:0;top:0;bottom:0;background:linear-gradient(170deg,#F5E5D9 0%,#D4423C 100%);"></view>
</view>
