/* pages/stars/stars.wxss
   全屏满幅画报 · 纯横滑视界（对标 Lululemon 封面画报与 Apple 极简全景）
   ============================================================ */

page {
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background-color: #08070A;
}

.stars-viewport {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  z-index: 1;
}

/* 全屏 Swiper */
.stars-swiper {
  width: 100vw;
  height: 100vh;
}

.star-slide-item {
  width: 100vw;
  height: 100vh;
  position: relative;
}

.image-wrapper {
  width: 100%;
  height: 100%;
  position: relative;
}

.star-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* 顶部与底部光影层，保证各种背景图下的清晰对比度 */
.vignette-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(to bottom, rgba(10, 9, 12, 0.5) 0%, rgba(10, 9, 12, 0.15) 60%, rgba(10, 9, 12, 0) 100%);
  pointer-events: none;
}

.vignette-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  background: linear-gradient(to top, rgba(8, 7, 10, 0.94) 0%, rgba(8, 7, 10, 0.72) 45%, rgba(8, 7, 10, 0.25) 80%, rgba(8, 7, 10, 0) 100%);
  pointer-events: none;
}

/* 底部图层 (浮于磨砂底栏上方) */
.stars-floating-overlay {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  z-index: 50;
  display: flex;
  flex-direction: column;
  pointer-events: auto;
}

.star-meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.star-journey-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 0.05em;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.star-name-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.star-name {
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 52rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.08em;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.star-name-en {
  font-family: -apple-system, sans-serif;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.16em;
  color: rgba(255, 255, 255, 0.5);
}

.star-quote-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #F8EFEA;
  font-weight: 400;
  letter-spacing: 0.04em;
  margin-bottom: 24rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
}

/* Lululemon 细长胶囊指示器 */
.pill-indicator-track {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}

.indicator-item {
  cursor: pointer;
  height: 6rpx;
  border-radius: 3rpx;
  transition: all 340ms cubic-bezier(0.2, 0.8, 0.25, 1);
}

.indicator-dot {
  width: 12rpx;
  background: rgba(255, 255, 255, 0.38);
}

.indicator-pill-active {
  width: 52rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.65);
}

/* ================= 全屏开屏：到徕舞 一起好状态 ================= */
.splash-screen {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background-color: #CE3834;
  background-image:
    radial-gradient(circle at 85% 12%, rgba(255, 248, 242, 0.78) 0%, transparent 50%),
    linear-gradient(168deg, #F5E5D9 0%, #E58572 30%, #D4423C 62%, #BA2428 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: env(safe-area-inset-top) 48rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  transition: opacity 450ms cubic-bezier(0.16, 1, 0.3, 1), transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  touch-action: none;
}

.splash-fade-out {
  opacity: 0;
  transform: scale(1.04);
  pointer-events: none;
}

.splash-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transform: translateY(-24rpx);
}

.splash-brand-luxury {
  font-family: "Didot", "Bodoni MT", Georgia, "Times New Roman", serif;
  font-size: 46rpx;
  font-weight: 400;
  color: #FFFFFF;
  letter-spacing: 0.40em;
  margin-right: -0.40em;
  line-height: 1;
  text-shadow: 0 4rpx 20rpx rgba(140, 20, 20, 0.18);
}

.splash-brand-line {
  width: 48rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.65);
  margin: 28rpx 0 44rpx;
}

.splash-sub {
  font-size: 60rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.16em;
  margin-right: -0.16em;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 24rpx rgba(140, 20, 20, 0.2);
}

.splash-main {
  font-size: 136rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.08;
  letter-spacing: 0.08em;
  margin-right: -0.08em;
  text-shadow: 0 8rpx 32rpx rgba(140, 20, 20, 0.25);
}

.splash-cta {
  margin-top: 96rpx;
  width: 310rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: rgba(82, 22, 20, 0.68);
  border: 1.5rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
  padding-left: 0.14em;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 12rpx 32rpx rgba(90, 15, 15, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), background-color 180ms;
}

.splash-cta:active {
  transform: scale(0.95);
  background: rgba(60, 14, 12, 0.85);
}
