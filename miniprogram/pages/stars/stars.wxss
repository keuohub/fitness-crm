/* pages/stars/stars.wxss
   全屏满幅画报 · 纯横滑视界（对标 Lululemon 封面画报与 Apple 极简全景）
   ============================================================ */

page {
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background-color: #08070A;
}

.stars-viewport {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  z-index: 1;
}

/* 全屏 Swiper */
.stars-swiper {
  width: 100vw;
  height: 100vh;
}

.star-slide-item {
  width: 100vw;
  height: 100vh;
  position: relative;
}

.image-wrapper {
  width: 100%;
  height: 100%;
  position: relative;
}

.star-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* 顶部与底部光影层，保证各种背景图下的清晰对比度 */
.vignette-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(to bottom, rgba(10, 9, 12, 0.5) 0%, rgba(10, 9, 12, 0.15) 60%, rgba(10, 9, 12, 0) 100%);
  pointer-events: none;
}

.vignette-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  background: linear-gradient(to top, rgba(8, 7, 10, 0.94) 0%, rgba(8, 7, 10, 0.72) 45%, rgba(8, 7, 10, 0.25) 80%, rgba(8, 7, 10, 0) 100%);
  pointer-events: none;
}

/* 底部图层 (浮于磨砂底栏上方) */
.stars-floating-overlay {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  z-index: 50;
  display: flex;
  flex-direction: column;
  pointer-events: auto;
}

.star-meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.star-journey-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 0.05em;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.star-name-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.star-name {
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 52rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.08em;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.star-name-en {
  font-family: -apple-system, sans-serif;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.16em;
  color: rgba(255, 255, 255, 0.5);
}

.star-quote-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #F8EFEA;
  font-weight: 400;
  letter-spacing: 0.04em;
  margin-bottom: 24rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
}

/* Lululemon 细长胶囊指示器 */
.pill-indicator-track {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}

.indicator-item {
  cursor: pointer;
  height: 6rpx;
  border-radius: 3rpx;
  transition: all 340ms cubic-bezier(0.2, 0.8, 0.25, 1);
}

.indicator-dot {
  width: 12rpx;
  background: rgba(255, 255, 255, 0.38);
}

.indicator-pill-active {
  width: 52rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.65);
}
