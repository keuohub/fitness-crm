/* pages/booking-success/booking-success.wxss */
.success-page {
  min-height: 100vh;
  background-color: #f3efe8;
  padding: 48rpx 36rpx calc(env(safe-area-inset-bottom) + 60rpx);
  box-sizing: border-box;
}

/* 骨架屏 */
.success-skeleton-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.success-sk-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-bottom: 36rpx;
}

.success-sk-title {
  width: 240rpx;
  height: 60rpx;
  margin-bottom: 48rpx;
}

.success-sk-card {
  width: 100%;
  height: 380rpx;
  border-radius: 0;
}

/* 报错态 */
.success-error-box {
  padding-top: 100rpx;
}

.success-error-title {
  font-size: var(--fs-h3, 32rpx);
  font-weight: 700;
  color: var(--c-title, #000000);
  margin-bottom: 16rpx;
}

.success-error-hint {
  font-size: var(--fs-caption, 24rpx);
  color: var(--c-muted, #666666);
  margin-bottom: 48rpx;
}

.success-error-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 560rpx;
}

.success-err-btn {
  width: 100%;
}

/* 正常成功态 */
.success-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 32rpx;
}

/* 顶部细描边对勾徽标（墨色2rpx线） */
.success-badge {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.success-badge-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid var(--c-title, #000000);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.success-badge-check {
  width: 34rpx;
  height: 18rpx;
  border-left: 2rpx solid var(--c-title, #000000);
  border-bottom: 2rpx solid var(--c-title, #000000);
  transform: rotate(-45deg) translate(2rpx, -4rpx);
  box-sizing: border-box;
}

.success-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.success-title {
  display: block;
  font-family: var(--font-sans);
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--c-title, #000000);
  letter-spacing: 0;
}

.success-subtitle {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-num);
  font-size: 30rpx;
  color: var(--c-muted, #666666);
  font-weight: 500;
}

/* 课次信息卡片 */
.success-card {
  width: 100%;
  background: var(--c-card-soft, #efeae2);
  border: none;
  border-radius: 0;
  padding: 36rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.success-course-name {
  display: block;
  font-size: var(--fs-h3, 32rpx);
  font-weight: 700;
  color: var(--c-title, #000000);
  margin-bottom: 14rpx;
}

.success-meta-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
  font-size: var(--fs-sub, 26rpx);
  color: var(--c-muted, #666666);
}

.success-meta-time {
  font-family: var(--font-num);
  font-weight: 600;
  color: var(--c-title, #000000);
}

.success-meta-duration {
  font-family: var(--font-num);
}

.success-coach {
  font-weight: 500;
  color: var(--c-title, #000000);
}

.success-room {
  color: var(--c-muted, #666666);
}

.success-divider {
  height: 1rpx;
  background: var(--c-line, #ece7df);
  margin: 20rpx 0;
}

.success-rule-row {
  margin-bottom: 12rpx;
}

.success-rule-text {
  font-size: var(--fs-caption, 24rpx);
  color: var(--c-muted, #666666);
}

.success-card-deduct {
  margin-top: 12rpx;
}

.success-deduct-text {
  font-size: var(--fs-caption, 24rpx);
  color: var(--c-text, #222222);
  font-family: var(--font-sans);
  line-height: 1.5;
}

/* 陪伴文案 */
.success-warm-wrap {
  width: 100%;
  padding: 16rpx 20rpx 40rpx;
  text-align: center;
}

.success-warm-text {
  font-size: var(--fs-sub, 26rpx);
  line-height: 1.6;
  color: var(--c-muted, #666666);
}

/* 行动按钮区 */
.success-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.success-btn-main {
  width: 100%;
}

.success-btn-sub {
  width: 100%;
}

.success-text-btn-wrap {
  text-align: center;
  margin-top: 12rpx;
  padding: 12rpx 0;
}
