/* pages/manager/manager.wxss
   徕舞普拉提 · 手机端管家工作台
   设计语言：曜石黑 + 柔沙暖米 (#F6E6DA) + 浅金微光，轻奢克制
   ============================================================ */

page {
  background-color: #F6E6DA;
  color: #1C1415;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.mgr-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 90rpx) 32rpx calc(env(safe-area-inset-bottom) + 60rpx);
  box-sizing: border-box;
}

/* 顶部自定义状态栏 */
.mgr-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(env(safe-area-inset-top) + 88rpx);
  padding-top: env(safe-area-inset-top);
  background: #F6E6DA;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  z-index: 100;
  border-bottom: 1rpx solid rgba(28, 20, 21, 0.06);
}

.mgr-nav-left {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(13, 12, 15, 0.06);
}

.mgr-nav-back {
  font-size: 36rpx;
  line-height: 1;
  color: #0D0C0F;
}

.mgr-nav-back-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #0D0C0F;
}

.mgr-nav-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mgr-nav-brand {
  font-size: 30rpx;
  font-weight: 700;
  color: #0D0C0F;
  letter-spacing: 0.5rpx;
}

.mgr-nav-badge {
  font-size: 18rpx;
  color: #F6E6DA;
  background: #0D0C0F;
  border: 1rpx solid #B89358;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.mgr-nav-right {
  width: 120rpx;
}

/* loading / error */
.mgr-loading, .mgr-error {
  padding: 80rpx 0;
  text-align: center;
}

.mgr-loading-text, .mgr-error-text {
  font-size: 26rpx;
  color: #78716C;
}

/* 顶部黑金头图卡 */
.mgr-hero-card {
  margin-top: 14rpx;
  background: linear-gradient(135deg, #1A191D 0%, #0D0C0F 100%);
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid rgba(184, 147, 88, 0.35);
  box-shadow: 0 10rpx 28rpx rgba(13, 12, 15, 0.16);
  position: relative;
  overflow: hidden;
  margin-bottom: 22rpx;
}

.mgr-hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.mgr-hero-brand-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mgr-hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
}

.mgr-hero-tag {
  font-size: 18rpx;
  color: #F6E6DA;
  background: rgba(184, 147, 88, 0.25);
  border: 1rpx solid rgba(184, 147, 88, 0.5);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.mgr-hero-date {
  font-size: 20rpx;
  color: #A8A29E;
}

.mgr-hero-desc {
  font-size: 22rpx;
  color: #C7C2BA;
  line-height: 1.4;
}

/* 三大核心实时指标卡 */
.mgr-stats-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.mgr-stat-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(13, 12, 15, 0.04);
  border: 1rpx solid rgba(28, 20, 21, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mgr-stat-label {
  font-size: 22rpx;
  color: #78716C;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.mgr-stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #0D0C0F;
  line-height: 1.2;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.mgr-stat-hint {
  font-size: 18rpx;
  margin-top: 6rpx;
  font-weight: 500;
}

.hint-gold { color: #9E7B44; }
.hint-green { color: #059669; }
.hint-blue { color: #2563EB; }

/* 实时动态通报条 */
.mgr-ticker-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(13, 12, 15, 0.03);
  border: 1rpx solid rgba(28, 20, 21, 0.05);
  margin-bottom: 22rpx;
}

.mgr-ticker-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  overflow: hidden;
  flex: 1;
}

.mgr-ticker-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.dot-green { background: #10B981; }
.dot-red { background: #EF4444; }

.mgr-ticker-text {
  font-size: 24rpx;
  color: #1C1917;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 500;
}

.mgr-ticker-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.mgr-ticker-time {
  font-size: 20rpx;
  color: #A8A29E;
}

.mgr-ticker-arrow {
  font-size: 26rpx;
  color: #A8A29E;
}

/* 快捷工具三大按钮 */
.mgr-tools-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mgr-tool-btn {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 16rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 3rpx 10rpx rgba(13, 12, 15, 0.03);
  border: 1rpx solid rgba(28, 20, 21, 0.05);
}

.mgr-tool-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-gold { background: #FAF4EC; }
.icon-blue { background: #EFF6FF; }
.icon-green { background: #ECFDF5; }

.mgr-tool-symbol {
  font-size: 22rpx;
}

.mgr-tool-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #292524;
}

/* 九宫格大卡片 */
.mgr-grid-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(13, 12, 15, 0.04);
  border: 1rpx solid rgba(28, 20, 21, 0.05);
  margin-bottom: 30rpx;
}

.mgr-grid-head {
  padding: 0 10rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #F5F2EB;
}

.mgr-grid-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1917;
}

.mgr-grid-note {
  font-size: 20rpx;
  color: #A8A29E;
}

.mgr-grid-body {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx 8rpx;
  padding-top: 20rpx;
}

.mgr-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
}

.mgr-item-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.bg-gold { background: #FAF4EC; }
.bg-blue { background: #EFF6FF; }
.bg-purple { background: #F5F3FF; }
.bg-green { background: #ECFDF5; }
.bg-amber { background: #FFFBEB; }
.bg-slate { background: #F1F5F9; }
.bg-orange { background: #FEF3C7; }
.bg-sky { background: #F0F9FF; }
.bg-rose { background: #FFF1F2; }

.mgr-item-char {
  font-size: 32rpx;
  font-weight: 700;
  color: #0D0C0F;
}

.mgr-item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1917;
  margin-bottom: 4rpx;
}

.mgr-item-sub {
  font-size: 20rpx;
  color: #A8A29E;
}

/* 底部操作 */
.mgr-footer-section {
  padding: 10rpx 8rpx 40rpx;
}

.mgr-switch-btn {
  background: #FFFFFF;
  border: 1rpx solid rgba(184, 147, 88, 0.4);
  border-radius: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(13, 12, 15, 0.04);
}

.mgr-switch-text {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0D0C0F;
  margin-bottom: 4rpx;
}

.mgr-switch-note {
  display: block;
  font-size: 20rpx;
  color: #78716C;
}

/* 弹窗通用样式 */
.mgr-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(13, 12, 15, 0.55);
  backdrop-filter: blur(4rpx);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.mgr-modal-card {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.2);
}

.mgr-modal-card-lg {
  width: 100%;
  max-width: 660rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.mgr-modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.mgr-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0D0C0F;
}

.mgr-modal-close {
  width: 48rpx;
  height: 48rpx;
  font-size: 40rpx;
  line-height: 48rpx;
  text-align: center;
  color: #78716C;
}

.mgr-modal-desc {
  font-size: 26rpx;
  color: #57534E;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.mgr-modal-code {
  background: #F5F5F4;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #0D0C0F;
  margin-bottom: 28rpx;
  word-break: break-all;
  font-family: monospace;
}

.mgr-modal-quote {
  background: #FAF4EC;
  border: 1rpx solid #ECE0D1;
  padding: 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #78350F;
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.mgr-modal-notice {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  padding: 24rpx;
  border-radius: 14rpx;
  margin-bottom: 28rpx;
}

.mgr-notice-strong {
  font-size: 26rpx;
  font-weight: 700;
  color: #166534;
  line-height: 1.6;
}

.mgr-notice-text {
  font-size: 24rpx;
  color: #166534;
  line-height: 1.6;
}

.mgr-modal-action-btn {
  width: 100%;
  background: #0D0C0F;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  line-height: 1.4;
  border: none;
}

/* 场次列表滚动区 */
.mgr-session-scroll {
  max-height: 50vh;
  margin-bottom: 24rpx;
}

.mgr-session-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #A8A29E;
}

.mgr-session-item {
  background: #F9F8F6;
  border: 1rpx solid #EFECE6;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.mgr-session-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.mgr-session-time {
  font-size: 26rpx;
  font-weight: 700;
  color: #0D0C0F;
}

.mgr-session-badge {
  font-size: 20rpx;
  color: #78716C;
  background: #EFECE6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.mgr-session-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.mgr-session-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1917;
}

.mgr-session-coach {
  font-size: 22rpx;
  color: #9E7B44;
}

.mgr-session-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mgr-session-booked {
  font-size: 22rpx;
  color: #57534E;
}

.mgr-session-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.tag-open {
  background: #ECFDF5;
  color: #059669;
}

.tag-full {
  background: #FEF2F2;
  color: #DC2626;
}
