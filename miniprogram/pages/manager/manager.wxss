  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(13, 12, 15, 0.04);
}

.mgr-detail-up-date {
  font-size: 20rpx;
  color: #B92E32;
  font-weight: 600;
  flex-shrink: 0;
}

.mgr-detail-up-course {
  font-size: 22rpx;
  color: #2B2723;
}

/* 最近记录 */
.mgr-detail-rec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13rpx 0;
  border-bottom: 1rpx solid rgba(13, 12, 15, 0.04);
}

.mgr-detail-rec-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.mgr-detail-rec-course {
  font-size: 22rpx;
  color: #1B1917;
  font-weight: 600;
}

.mgr-detail-rec-meta {
  font-size: 18rpx;
  color: #9A9287;
}

.mgr-detail-rec-status {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.mgr-detail-rec-status.status-attended {
  color: #16794A;
  background: #E6F4EC;
}

.mgr-detail-rec-status.status-no_show {
  color: #8A5A00;
  background: #FCF1DC;
}

.mgr-detail-rec-status.status-cancelled {
  color: #9A9287;
  background: #F1EFEA;
}

.mgr-detail-rec-status.status-booked,
.mgr-detail-rec-status.status-waitlist {
  color: #B92E32;
  background: #FBEDEC;
}

.mgr-detail-foot {
  text-align: center;
  font-size: 18rpx;
  color: #B8B2A8;
  padding: 8rpx 0 40rpx;
}

/* ════════════════════════════════════════════════════════════ */
/* 扩展能力：分栏切换、卡种规则库、代客约课、教练团队、权限中枢 */
/* ════════════════════════════════════════════════════════════ */

/* 分栏切换器 (Segmented Tabs) */
.mgr-seg-tabs {
  display: flex;
  background: rgba(13, 12, 15, 0.05);
  padding: 6rpx;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}

.mgr-seg-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  color: #8C8478;
  padding: 14rpx 0;
  border-radius: 14rpx;
  transition: all 0.2s ease;
}

.mgr-seg-tab.is-active {
  background: #FFFFFF;
  color: #1A1719;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 顶部通用快速添加按钮栏 */
.mgr-add-act-bar {
  margin-bottom: 24rpx;
}

.mgr-add-act-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #FFFFFF;
  border: 1rpx dashed #C2B6A6;
  border-radius: 20rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #B92E32;
  box-shadow: 0 4rpx 12rpx rgba(185, 46, 50, 0.04);
}

.mgr-add-act-icon {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
}

/* 表单内类型二选一选择器 */
.mgr-seg-picker {
  display: flex;
  background: #F3EFEA;
  border-radius: 14rpx;
  padding: 6rpx;
  gap: 8rpx;
}

.mgr-seg-opt {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  font-weight: 500;
  color: #7A7266;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}

.mgr-seg-opt.is-chosen {
  background: #B92E32;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(185, 46, 50, 0.25);
}

/* 卡项卡片顶部操作 */
.mgr-card-top-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mgr-pill-return {
  font-size: 20rpx;
  font-weight: 600;
  color: #C03438;
  background: #FDF2F2;
  border: 1rpx solid #FACDCD;
  padding: 4rpx 14rpx;
  border-radius: 99rpx;
}

/* 卡种规则行 */
.mgr-type-name-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mgr-type-cat-tag {
  font-size: 18rpx;
  font-weight: 600;
  color: #8C6239;
  background: #F7EFE5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.mgr-pill-toggle {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 99rpx;
  line-height: 1.2;
}

.mgr-pill-toggle.is-active-btn {
  background: #EAF7EE;
  color: #1B8342;
  border: 1rpx solid #C4ECD0;
}

.mgr-pill-toggle.is-inactive-btn {
  background: #F4F2EE;
  color: #8C8478;
  border: 1rpx solid #DDD8CE;
}

/* 教室规则行 */
.mgr-room-rule-line {
  font-size: 20rpx;
  color: #8C8478;
  line-height: 1.5;
}

/* 代客约课组件 */
.mgr-attendees-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.mgr-pill-book-mgr {
  font-size: 22rpx;
  font-weight: 600;
  color: #B92E32;
  background: #FDF2F2;
  border: 1rpx solid #F5D3D3;
  padding: 6rpx 18rpx;
  border-radius: 99rpx;
}

.mgr-book-member-box {
  background: #FAF7F2 !important;
  border: 1rpx solid #E8DFD5 !important;
}

.mgr-form-hint-bar {
  font-size: 22rpx;
  color: #8C6239;
  background: rgba(140, 98, 57, 0.08);
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.mgr-member-picker-scroll {
  max-height: 320rpx;
  overflow-y: auto;
  border: 1rpx solid #E5DFD5;
  border-radius: 16rpx;
  background: #FFFFFF;
  margin-bottom: 24rpx;
}

.mgr-picker-member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #F4F1EC;
  transition: all 0.2s ease;
}

.mgr-picker-member-row:last-child {
  border-bottom: none;
}

.mgr-picker-member-row.is-selected {
  background: #FDF5F5;
}

.mgr-picker-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mgr-picker-member-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1719;
}

.mgr-picker-member-phone {
  font-size: 22rpx;
  color: #8C8478;
}

.mgr-picker-check {
  font-size: 22rpx;
  font-weight: 700;
  color: #B92E32;
}

.mgr-picker-empty {
  padding: 28rpx 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A39B8F;
}

/* 教练卡片 */
.mgr-coach-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(13, 12, 15, 0.04);
}

.mgr-coach-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mgr-coach-avatar-circle {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FAF4EF 0%, #EFE5DA 100%);
  color: #8C6239;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mgr-coach-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mgr-coach-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mgr-coach-name-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1719;
}

.mgr-coach-status-tag {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.mgr-coach-status-tag.tag-active {
  background: #EAF7EE;
  color: #1B8342;
}

.mgr-coach-status-tag.tag-inactive {
  background: #F4F2EE;
  color: #8C8478;
}

.mgr-coach-title-text {
  font-size: 22rpx;
  color: #7A7266;
}

/* 管理员卡片 */
.mgr-admin-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(13, 12, 15, 0.04);
}

.mgr-admin-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mgr-admin-name-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mgr-admin-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1719;
}

.mgr-admin-badge {
  font-size: 18rpx;
  font-weight: 600;
  color: #B92E32;
  background: #FDF2F2;
  border: 1rpx solid #FACDCD;
  padding: 2rpx 12rpx;
  border-radius: 99rpx;
}

.mgr-admin-status {
  font-size: 20rpx;
  font-weight: 600;
  color: #1B8342;
}

.mgr-admin-meta-row {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #7A7266;
}

.mgr-admin-meta-label {
  color: #A39B8F;
}

.mgr-admin-meta-val {
  font-family: monospace;
}

/* ════════════════════════════════════════════════════════════ */
/* 视图 0：管理员专属安全登录面板样式 */
/* ════════════════════════════════════════════════════════════ */
.mgr-login-container {
  width: 100%;
  padding: 20rpx 0 60rpx;
}

.mgr-login-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(185, 46, 50, 0.12);
  box-shadow: 0 12rpx 36rpx rgba(185, 46, 50, 0.08);
  overflow: hidden;
}

.mgr-login-header {
  background: linear-gradient(135deg, #8C1C20 0%, #B92E32 50%, #A12529 100%);
  padding: 44rpx 32rpx 36rpx;
  text-align: center;
}

.mgr-login-brand {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.mgr-login-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 14rpx;
}

.mgr-login-badge {
  display: inline-block;
  font-size: 18rpx;
  color: #FFF2E2;
  background: rgba(230, 188, 139, 0.25);
  border: 1rpx solid #E6BC8B;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.mgr-login-body {
  padding: 36rpx 30rpx 40rpx;
}

.mgr-login-security-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #FAF4F2;
  border: 1rpx solid rgba(185, 46, 50, 0.12);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 28rpx;
}

.mgr-tip-icon {
  font-size: 24rpx;
}

.mgr-tip-text {
  font-size: 20rpx;
  color: #8C1C20;
  line-height: 1.45;
}

.mgr-preset-group {
  margin-bottom: 28rpx;
}

.mgr-preset-label {
  font-size: 20rpx;
  color: #8C8478;
  margin-bottom: 12rpx;
  display: block;
}

.mgr-preset-pills {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mgr-preset-pill {
  font-size: 20rpx;
  color: #B92E32;
  background: rgba(185, 46, 50, 0.06);
  border: 1rpx solid rgba(185, 46, 50, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.mgr-preset-pill.is-active {
  background: #B92E32;
  color: #FFFFFF;
  border-color: #B92E32;
}

.mgr-login-field {
  margin-bottom: 24rpx;
}

.mgr-field-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A1719;
  margin-bottom: 10rpx;
  display: block;
}

.mgr-field-input {
  width: 100%;
  height: 80rpx;
  background: #FAF8F5;
  border: 1rpx solid #EFE8DE;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1A1719;
  box-sizing: border-box;
}

.mgr-field-ph {
  color: #A8A29E;
  font-size: 24rpx;
}

.mgr-login-error {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 24rpx;
}

.mgr-error-icon {
  font-size: 24rpx;
}

.mgr-error-msg {
  font-size: 22rpx;
  color: #DC2626;
  font-weight: 500;
}

.mgr-login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #B92E32 0%, #A12529 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 16rpx;
  margin-top: 10rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(185, 46, 50, 0.25);
}

.mgr-login-footnote {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0E8E6;
}

.mgr-fn-item {
  font-size: 19rpx;
  color: #8C8478;
  line-height: 1.6;
}

/* 导航栏退出按钮 */
.mgr-nav-logout-pill {
  font-size: 20rpx;
  color: #B92E32;
  background: rgba(185, 46, 50, 0.08);
  border: 1rpx solid rgba(185, 46, 50, 0.25);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* 账号与留痕寻迹二级导航与列表样式 */
.mgr-admins-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mgr-adm-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #8C8478;
  background: #FFFFFF;
  border: 1rpx solid #EFE8DE;
  border-radius: 14rpx;
}

.mgr-adm-tab.is-active {
  color: #FFFFFF;
  background: #B92E32;
  border-color: #B92E32;
  box-shadow: 0 4rpx 14rpx rgba(185, 46, 50, 0.2);
}

.mgr-audit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.mgr-audit-card {
  background: #FFFFFF;
  border: 1rpx solid rgba(185, 46, 50, 0.1);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(185, 46, 50, 0.03);
}

.mgr-audit-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.mgr-audit-actor {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mgr-audit-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1719;
}

.mgr-audit-user {
  font-size: 20rpx;
  color: #8C8478;
  font-family: monospace;
}

.mgr-audit-badge {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.badge-green { background: #ECFDF5; color: #047857; border: 1rpx solid #A7F3D0; }
.badge-red { background: #FEF2F2; color: #B91C1C; border: 1rpx solid #FECACA; }
.badge-gold { background: #FFFBEB; color: #B45309; border: 1rpx solid #FDE68A; }
.badge-orange { background: #FFF7ED; color: #C2410C; border: 1rpx solid #FED7AA; }
.badge-blue { background: #EFF6FF; color: #1D4ED8; border: 1rpx solid #BFDBFE; }
.badge-teal { background: #F0FDFA; color: #0F766E; border: 1rpx solid #99F6E4; }
.badge-purple { background: #FAF5FF; color: #7C3AED; border: 1rpx solid #E9D5FF; }
.badge-slate { background: #F8FAFC; color: #475569; border: 1rpx solid #E2E8F0; }

.mgr-audit-summary {
  font-size: 23rpx;
  color: #292524;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.mgr-audit-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 18rpx;
  color: #A8A29E;
  padding-top: 10rpx;
  border-top: 1rpx dashed #F5EFEB;
}

.mgr-empty-box {
  padding: 80rpx 0;
  text-align: center;
}

.mgr-empty-text {
  font-size: 24rpx;
  color: #A8A29E;
}
