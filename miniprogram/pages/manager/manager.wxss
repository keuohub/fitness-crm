/* 会员列表与搜索 (Members List) */
/* ════════════════════════════════════════════════════════════ */

.mgr-search-bar-wrap {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.mgr-search-input {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid rgba(13, 12, 15, 0.1);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 24rpx;
}

.mgr-search-btn {
  background: #0D0C0F;
  color: #F6E6DA;
  border: 1rpx solid #B89358;
