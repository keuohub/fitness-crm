  font-size: 26rpx;
  font-weight: 700;
  color: #0D0C0F;
}

.mgr-member-code-badge {
  font-size: 18rpx;
  color: #927038;
  background: rgba(184, 147, 88, 0.15);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.mgr-member-phone {
  font-size: 20rpx;
  color: #78716C;
}

.mgr-member-card-right {
