  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.mgr-member-card {
  background: #FFFFFF;
  border: 1rpx solid rgba(13, 12, 15, 0.08);
  border-radius: 18rpx;
