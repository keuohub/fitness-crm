/* pages/manager/manager.wxss
   徕舞普拉提 · 手机端管家智能工作台
   设计语言：曜石黑 + 柔沙暖米 (#F6E6DA) + 浅金微光，轻奢克制
   全屏子视图原生滚动，无弹窗遮罩穿透
   ============================================================ */

page {
  background-color: #FDFCF9;
  color: var(--c-text, #3D3538);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}

.mgr-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 94rpx) 30rpx calc(104rpx + 16rpx + env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
}

/* 顶部自定义状态栏 */
.mgr-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(env(safe-area-inset-top) + 88rpx);
  padding-top: env(safe-area-inset-top);
  background: var(--c-bg, #ffffff);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  z-index: 100;
  border-bottom: 1rpx solid var(--c-line, #E6DDD4);
}

.mgr-nav-left {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(13, 12, 15, 0.08);
}

.mgr-nav-back {
  font-size: 36rpx;
  line-height: 1;
  color: #000000;
}

.mgr-nav-back-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #000000;
}

.mgr-nav-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mgr-nav-brand {
  font-size: 30rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: 0.5rpx;
}

.mgr-nav-badge {
  font-size: 18rpx;
  color: #F6E6DA;
  background: #000000;
  border: 1rpx solid #B89358;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.mgr-nav-right {
  width: 140rpx;
  display: flex;
  justify-content: flex-end;
}

.mgr-nav-home-pill {
  font-size: 20rpx;
  color: #000000;
  background: rgba(184, 147, 88, 0.2);
  border: 1rpx solid rgba(184, 147, 88, 0.5);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* loading / error */
.mgr-loading, .mgr-error {
  padding: 100rpx 0;
  text-align: center;
}

.mgr-loading-text, .mgr-error-text {
  font-size: 26rpx;
  color: #78716C;
}

.mgr-inner-loading {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #78716C;
}

.mgr-error-card {
  margin: 24rpx 0;
  padding: 32rpx 24rpx;
  background: #FFF7ED;
  border: 1rpx solid #FDBA74;
  border-radius: 16rpx;
  text-align: center;
}

.mgr-error-card-text {
  font-size: 24rpx;
  color: #C2410C;
  line-height: 1.5;
}

.mgr-list-footnote {
  padding: 30rpx 20rpx 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A8A29E;
  line-height: 1.5;
}

.mgr-view-container {
  width: 100%;
}

/* ════════════════════════════════════════════════════════════ */
/* 视图 1：主工作台九宫格样式 */
/* ════════════════════════════════════════════════════════════ */

/* 顶部高定绛红头图卡 */
.mgr-hero-card {
  margin-top: 14rpx;
  background: linear-gradient(135deg, #8C1C20 0%, #B92E32 50%, #A12529 100%);
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid rgba(230, 188, 139, 0.45);
  box-shadow: 0 12rpx 36rpx rgba(185, 46, 50, 0.22);
  position: relative;
  overflow: hidden;
  margin-bottom: 22rpx;
}

.mgr-hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.mgr-hero-brand-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mgr-hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
}

.mgr-hero-tag {
  font-size: 18rpx;
  color: #FFF2E2;
  background: rgba(230, 188, 139, 0.25);
  border: 1rpx solid #E6BC8B;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.mgr-hero-date {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mgr-hero-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.4;
}

/* 三大核心实时指标卡 */
.mgr-stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.mgr-stat-card {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid rgba(185, 46, 50, 0.1);
  border-radius: 18rpx;
  padding: 22rpx 18rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(185, 46, 50, 0.04);
}

.mgr-stat-label {
  font-size: 20rpx;
  color: #8C8478;
  margin-bottom: 8rpx;
}

.mgr-stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1719;
  line-height: 1;
  margin-bottom: 10rpx;
}

.mgr-stat-hint {
  font-size: 18rpx;
  font-weight: 600;
}

.hint-gold { color: #B92E32; }
.hint-green { color: #C5A880; }
.hint-blue { color: #2E7D4F; }

/* 实时动态通报条 */
.mgr-ticker-card {
  background: #FAF4F2;
  border: 1rpx solid rgba(185, 46, 50, 0.1);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.mgr-ticker-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  overflow: hidden;
}

.mgr-ticker-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-green { background: #16A34A; }
.dot-red { background: #DC2626; }

.mgr-ticker-text {
  font-size: 22rpx;
  color: #292524;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mgr-ticker-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.mgr-ticker-time {
  font-size: 18rpx;
  color: #A8A29E;
}

.mgr-ticker-arrow {
  font-size: 26rpx;
  color: #78716C;
}

/* 快捷工具三大按钮 */
.mgr-tools-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.mgr-tool-btn {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid rgba(13, 12, 15, 0.06);
  border-radius: 16rpx;
  padding: 18rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(13, 12, 15, 0.03);
}

.mgr-tool-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-gold { background: rgba(184, 147, 88, 0.15); }
.icon-blue { background: rgba(30, 96, 145, 0.12); }
.icon-green { background: rgba(22, 163, 74, 0.12); }

.mgr-tool-symbol {
  font-size: 26rpx;
}

.mgr-tool-name {
  font-size: 22rpx;
  color: #292524;
  font-weight: 500;
}

/* 九宫格大卡片 */
.mgr-grid-card {
  background: #FFFFFF;
  border: 1rpx solid rgba(185, 46, 50, 0.1);
  border-radius: 24rpx;
  padding: 28rpx 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(185, 46, 50, 0.04);
  margin-bottom: 30rpx;
}

.mgr-grid-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.mgr-grid-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1719;
}

.mgr-grid-note {
  font-size: 20rpx;
  color: #C5A880;
  font-weight: 500;
}

.mgr-grid-body {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 14rpx;
}

.mgr-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 6rpx;
  background: #FAF8F5;
  border-radius: 18rpx;
  border: 1rpx solid rgba(185, 46, 50, 0.06);
  box-shadow: 0 2rpx 8rpx rgba(185, 46, 50, 0.02);
  transition: all 0.15s ease;
}

.mgr-grid-item:active {
  background: #F5EFEB;
  transform: scale(0.97);
}

.mgr-item-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

/* 9个高定渐变轻奢图标盒子，严格对齐品牌色系 */
.bg-gold { background: rgba(185, 46, 50, 0.1); border: 1rpx solid rgba(185, 46, 50, 0.2); }
.bg-gold .mgr-item-char { color: #B92E32; }

.bg-blue { background: rgba(197, 168, 128, 0.2); border: 1rpx solid rgba(197, 168, 128, 0.35); }
.bg-blue .mgr-item-char { color: #8F6B2A; }

.bg-purple { background: rgba(20, 140, 130, 0.12); border: 1rpx solid rgba(20, 140, 130, 0.25); }
.bg-purple .mgr-item-char { color: #0F766E; }

.bg-green { background: rgba(124, 58, 237, 0.12); border: 1rpx solid rgba(124, 58, 237, 0.25); }
.bg-green .mgr-item-char { color: #7C3AED; }

.bg-amber { background: rgba(37, 99, 235, 0.12); border: 1rpx solid rgba(37, 99, 235, 0.25); }
.bg-amber .mgr-item-char { color: #1D4ED8; }

.bg-slate { background: rgba(185, 46, 50, 0.15); border: 1rpx solid rgba(185, 46, 50, 0.3); }
.bg-slate .mgr-item-char { color: #A12529; }

.bg-orange { background: rgba(217, 119, 6, 0.15); border: 1rpx solid rgba(217, 119, 6, 0.28); }
.bg-orange .mgr-item-char { color: #B45309; }

.bg-sky { background: rgba(22, 163, 74, 0.12); border: 1rpx solid rgba(22, 163, 74, 0.25); }
.bg-sky .mgr-item-char { color: #15803D; }

.bg-rose { background: rgba(71, 85, 105, 0.12); border: 1rpx solid rgba(71, 85, 105, 0.25); }
.bg-rose .mgr-item-char { color: #334155; }

.mgr-item-char {
  font-size: 32rpx;
  font-weight: 700;
}

.mgr-item-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1719;
  margin-bottom: 4rpx;
}

.mgr-item-sub {
  font-size: 18rpx;
  color: #8C8478;
}

/* 底部操作 */
.mgr-footer-section {
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.mgr-switch-btn {
  background: #FFFFFF;
  border: 1rpx solid rgba(13, 12, 15, 0.12);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.mgr-switch-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #000000;
}

.mgr-switch-note {
  font-size: 20rpx;
  color: #78716C;
}


/* ════════════════════════════════════════════════════════════ */
/* 子视图通用头部 & 组件样式 */
/* ════════════════════════════════════════════════════════════ */

.mgr-sub-header {
  margin-top: 14rpx;
  margin-bottom: 24rpx;
}

.mgr-sub-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.mgr-sub-view-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #000000;
}

.mgr-sub-view-sub {
  font-size: 22rpx;
  color: #78716C;
  line-height: 1.4;
}

.mgr-date-pick-badge {
  font-size: 22rpx;
  color: #000000;
  background: rgba(184, 147, 88, 0.25);
  border: 1rpx solid rgba(184, 147, 88, 0.6);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

/* 7天水平日期选择条 */
.mgr-date-ribbon {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
  padding-bottom: 8rpx;
}

.mgr-date-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 24rpx;
  margin-right: 14rpx;
  background: #FAF3EC;
  border: 1rpx solid rgba(184, 147, 88, 0.25);
  border-radius: 18rpx;
  position: relative;
  min-width: 110rpx;
}

.tab-active {
  background: #000000;
  border-color: #000000;
}

.mgr-tab-day {
  font-size: 20rpx;
  color: #78716C;
  margin-bottom: 4rpx;
}

.tab-active .mgr-tab-day {
  color: #ffffff;
}

.mgr-tab-date {
  font-size: 24rpx;
  font-weight: 700;
  color: #000000;
}

.tab-active .mgr-tab-date {
  color: #FFFFFF;
}

.mgr-tab-indicator {
  position: absolute;
  bottom: 6rpx;
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #B89358;
}

/* 空状态卡片 */
.mgr-empty-card {
  background: #FAF3EC;
  border: 1rpx dashed rgba(184, 147, 88, 0.4);
  border-radius: 20rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  margin-top: 20rpx;
}

.mgr-empty-card-sm {
  background: #FAF3EC;
  border: 1rpx dashed rgba(13, 12, 15, 0.15);
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  margin-top: 14rpx;
  margin-bottom: 20rpx;
}

.mgr-empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #000000;
  display: block;
  margin-bottom: 10rpx;
}

.mgr-empty-desc {
  font-size: 22rpx;
  color: #78716C;
  display: block;
  margin-bottom: 24rpx;
}

.mgr-empty-text {
  font-size: 22rpx;
  color: #78716C;
}

.mgr-empty-action-btn {
  display: inline-block;
  background: #000000;
  color: #F6E6DA;
  border: 1rpx solid #B89358;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
}


/* ════════════════════════════════════════════════════════════ */
/* 预约场次卡片 (Session Card) */
/* ════════════════════════════════════════════════════════════ */

.mgr-session-card {
  background: #FFFFFF;
  border: 1rpx solid rgba(184, 147, 88, 0.25);
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(13, 12, 15, 0.04);
}

.mgr-card-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.mgr-session-time-badge {
  background: #FAF3EC;
  border: 1rpx solid rgba(184, 147, 88, 0.35);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.mgr-time-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #000000;
}

.mgr-room-tag {
  font-size: 20rpx;
  color: #927038;
  background: rgba(184, 147, 88, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.mgr-session-name-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.mgr-session-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000000;
}

.mgr-coach-name {
  font-size: 22rpx;
  color: #78716C;
}

.mgr-capacity-bar-wrap {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(13, 12, 15, 0.06);
}

.mgr-capacity-text-row {
  display: flex;
  align-items: baseline;
}

.mgr-cap-label {
  font-size: 22rpx;
  color: #78716C;
}

.mgr-cap-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #000000;
}

.text-full {
  color: #DC2626;
}

/* 学员列表模块 */
.mgr-attendees-box {
  background: #FAF3EC;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
}

.mgr-attendees-header {
  font-size: 20rpx;
  color: #78716C;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.mgr-attendee-none {
  font-size: 20rpx;
  color: #A8A29E;
  padding: 8rpx 0;
}

.mgr-attendee-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(13, 12, 15, 0.04);
}

.mgr-attendee-cell:last-child {
  border-bottom: none;
}

.mgr-att-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mgr-att-avatar-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #000000;
  color: #F6E6DA;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #B89358;
}

.mgr-att-text-col {
  display: flex;
  flex-direction: column;
}

.mgr-att-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #000000;
}

.mgr-att-meta {
  font-size: 18rpx;
  color: #78716C;
}

.mgr-att-cancel-pill {
  font-size: 20rpx;
  color: #DC2626;
  background: #FEE2E2;
  border: 1rpx solid #FCA5A5;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}


/* ════════════════════════════════════════════════════════════ */
/* 表单卡片通用样式 (Form Card) */
/* ════════════════════════════════════════════════════════════ */

.mgr-form-card {
  background: #FAF3EC;
  border: 1rpx solid rgba(184, 147, 88, 0.35);
  border-radius: 22rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(13, 12, 15, 0.05);
}

.mgr-form-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.mgr-form-card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #000000;
  margin-bottom: 20rpx;
}

.mgr-form-close-text {
  font-size: 24rpx;
  color: #78716C;
  padding: 4rpx 12rpx;
}

.mgr-field-group {
  margin-bottom: 22rpx;
}

.mgr-field-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #44403C;
  display: block;
  margin-bottom: 10rpx;
}

.mgr-field-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.mgr-field-hint {
  font-size: 20rpx;
  color: #B89358;
  font-weight: 600;
}

.mgr-field-picker {
  background: #FFFFFF;
  border: 1rpx solid rgba(13, 12, 15, 0.12);
  border-radius: 14rpx;
  padding: 0 24rpx;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.mgr-field-input {
  background: #FFFFFF;
  border: 1rpx solid rgba(13, 12, 15, 0.12);
  border-radius: 14rpx;
  padding: 0 24rpx;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #000000;
  box-sizing: border-box;
  width: 100%;
}

/* 席位步进器触控栏 (大触控区、饱满舒适) */
.mgr-stepper-wrap {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1.5rpx solid rgba(184, 147, 88, 0.45);
  border-radius: 18rpx;
  height: 96rpx;
  min-height: 96rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.mgr-stepper-btn {
  width: 110rpx;
