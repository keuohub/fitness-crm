      </view>
    </view>

    <!-- 选项卡 1：留痕寻迹实时流 -->
    <block wx:if="{{adminsTab === 'logs'}}">
      <view wx:if="{{loadingAuditLogs}}" class="mgr-inner-loading">正在拉取全链路操作留痕…</view>
      <view wx:elif="{{auditLogsList.length === 0}}" class="mgr-empty-box">
        <text class="mgr-empty-text">暂无操作留痕记录</text>
      </view>
      <view wx:else class="mgr-audit-list">
        <view wx:for="{{auditLogsList}}" wx:key="id" class="mgr-audit-card">
          <view class="mgr-audit-card-top">
            <view class="mgr-audit-actor">
              <text class="mgr-audit-name">{{item.actorName}}</text>
              <text class="mgr-audit-user">({{item.actorUsername}})</text>
            </view>
            <text class="mgr-audit-badge {{item.action === 'checkin' ? 'badge-green' : (item.action === 'no_show' ? 'badge-red' : (item.action === 'issue_card' ? 'badge-gold' : (item.action === 'return_card' ? 'badge-orange' : (item.action === 'cancel_booking' ? 'badge-blue' : (item.action === 'book_for_member' ? 'badge-teal' : (item.action === 'manager_login' ? 'badge-purple' : 'badge-slate'))))))}}">{{item.action === 'checkin' ? '到课签到' : (item.action === 'no_show' ? '旷课未到' : (item.action === 'issue_card' ? '开卡办理' : (item.action === 'return_card' ? '退卡停卡' : (item.action === 'cancel_booking' ? '代客退课' : (item.action === 'book_for_member' ? '代客约课' : (item.action === 'manager_login' ? '管家登录' : '系统操作'))))))}}</text>
          </view>
          <view class="mgr-audit-summary">{{item.summary}}</view>
          <view class="mgr-audit-footer">
            <text class="mgr-audit-time">{{item.createdAt}}</text>
            <text class="mgr-audit-ip" wx:if="{{item.ip}}">IP: {{item.ip}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 选项卡 2：专职管理账号清单 -->
    <block wx:else>
      <view wx:if="{{loadingAdmins}}" class="mgr-inner-loading">正在核验管理员授权…</view>
      <block wx:else>
        <view wx:for="{{adminsList}}" wx:key="id" class="mgr-admin-card">
          <view class="mgr-admin-card-top">
            <view class="mgr-admin-name-box">
              <text class="mgr-admin-name">{{item.name}}</text>
              <text class="mgr-admin-badge">{{item.role === 'owner' ? '总店长 · 核心主理' : (item.email.indexOf('front') >= 0 ? '前台管家 · 接待约课' : '教务督导 · 教学排课')}}</text>
            </view>
            <text class="mgr-admin-status">权限生效中</text>
          </view>
          <view class="mgr-admin-meta-row">
            <text class="mgr-admin-meta-label">专属账号：</text>
            <text class="mgr-admin-meta-val">{{item.email || ('admin_' + item.id)}}</text>
          </view>
        </view>

        <view class="mgr-engine-card">
          <view class="mgr-engine-title">权限安全隔离与小桥权限说明</view>
          <view class="mgr-engine-badge">安全生效中</view>
          <text class="mgr-engine-desc">
            1. 专职管理员凭专属账号+密码登录，严禁普通学员手机号免密进入工作台。\n2. 店主小桥的管理权限已彻底撤销停用，小桥手机号无法访问后台与管理端。\n3. 每一次签到扣次、发卡、退卡、代约均实时写入数据库留痕寻迹，责任到人。
          </text>
        </view>
      </block>
    </block>
  </view>


