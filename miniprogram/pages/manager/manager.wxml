    </view>

    <!-- 顶部二级切页选项卡 -->
    <view class="mgr-admins-tabs">
      <view
        class="mgr-adm-tab {{adminsTab === 'logs' ? 'is-active' : ''}}"
        data-tab="logs"
        bindtap="onAdminsTabChange"
      >
        留痕寻迹 ({{auditLogsTotal}})
      </view>
      <view
        class="mgr-adm-tab {{adminsTab === 'accounts' ? 'is-active' : ''}}"
