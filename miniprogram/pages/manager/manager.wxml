  <!-- 视图 6：会员卡项全屏工作台 (currentView === 'cards') -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <view wx:elif="{{currentView === 'cards'}}" class="mgr-view-container">
    <view class="mgr-sub-header">
      <view class="mgr-sub-title-row">
        <text class="mgr-sub-view-title">会员卡与卡种管理</text>
      </view>
      <text class="mgr-sub-view-sub">支持查看会员已持卡、退卡停卡以及卡种规则自定义</text>
    </view>

    <!-- 顶部卡项切换分栏 -->
    <view class="mgr-seg-tabs">
      <view
        class="mgr-seg-tab {{cardTab === 'cards' ? 'is-active' : ''}}"
        bindtap="onCardTabChange"
        data-tab="cards"
      >
        会员持卡 ({{cardsList.length}})
      </view>
      <view
        class="mgr-seg-tab {{cardTab === 'types' ? 'is-active' : ''}}"
        bindtap="onCardTabChange"
        data-tab="types"
      >
        卡种规则库 ({{cardTypesList.length}})
      </view>
    </view>

    <!-- 分支 A：会员已持卡列表 -->
    <block wx:if="{{cardTab === 'cards'}}">
      <view wx:if="{{loadingCards}}" class="mgr-inner-loading">正在同步会馆卡项明细…</view>
      <view wx:elif="{{errorCards}}" class="mgr-error-card" bindtap="fetchCards">
        <text class="mgr-error-card-text">{{errorCards}}（点击重试）</text>
      </view>
      <block wx:else>
        <view wx:if="{{cardsList.length === 0}}" class="mgr-empty-card-sm">
          <text class="mgr-empty-text">暂无有效会员卡记录</text>
        </view>
        <view wx:for="{{cardsList}}" wx:key="id" class="mgr-card-item">
          <view class="mgr-card-item-top">
            <text class="mgr-card-type-name">{{item.card_name}}</text>
            <view class="mgr-card-top-right">
              <text class="mgr-card-status-badge">{{item.status === 'active' ? '有效生效中' : item.status}}</text>
              <view
                wx:if="{{item.status === 'active'}}"
                class="mgr-pill-return"
                catchtap="doReturnCard"
                data-id="{{item.id}}"
                data-member="{{item.member_name}}"
                data-card="{{item.card_name}}"
              >退卡/停用</view>
            </view>
          </view>
          <view class="mgr-card-member-row">
            <text class="mgr-card-member-name">{{item.member_name}}</text>
            <text class="mgr-card-member-phone">{{item.member_phone}}</text>
          </view>
          <view class="mgr-card-times-row">
            <text class="mgr-times-label">剩余课时：</text>
            <text class="mgr-times-val">{{item.remaining_count}} / {{item.total_count}} 次</text>
          </view>
          <view class="mgr-card-date-row">
            <text class="mgr-date-range">有效期：{{item.start_date || '长期'}} 至 {{item.end_date || '不限期'}}</text>
          </view>
        </view>
        <view wx:if="{{cardsList.length > 0}}" class="mgr-list-footnote">
          <text>当前展示最近 {{cardsList.length}} 张会员卡</text>
        </view>
      </block>
    </block>

    <!-- 分支 B：卡种规则库 (增删改查) -->
    <block wx:elif="{{cardTab === 'types'}}">
      <!-- 快速新建卡种按钮 -->
      <view class="mgr-add-act-bar">
        <view class="mgr-add-act-btn" bindtap="openNewCardTypeForm">
          <text class="mgr-add-act-icon">+</text>
          <text>新建卡种种类</text>
        </view>
      </view>

      <!-- 新建卡种表单卡片 -->
      <view wx:if="{{showNewCardTypeForm}}" class="mgr-form-card">
        <view class="mgr-form-card-head">
          <text class="mgr-form-card-title">创建新卡种规则</text>
          <text class="mgr-form-close-text" bindtap="closeNewCardTypeForm">取消</text>
        </view>

        <view class="mgr-field-group">
          <text class="mgr-field-label">卡种类别</text>
          <view class="mgr-seg-picker">
            <view
              class="mgr-seg-opt {{newCardTypeCategory === 'count' ? 'is-chosen' : ''}}"
              bindtap="onCardTypeCategoryChange"
              data-cat="count"
            >课时次卡</view>
            <view
              class="mgr-seg-opt {{newCardTypeCategory === 'period' ? 'is-chosen' : ''}}"
              bindtap="onCardTypeCategoryChange"
              data-cat="period"
            >尊享期限卡</view>
          </view>
        </view>

        <view class="mgr-field-group">
          <text class="mgr-field-label">卡种全称</text>
          <input
            class="mgr-field-input"
            type="text"
            placeholder="如：普拉提重力核心床10次卡"
            value="{{newCardTypeName}}"
            bindinput="onNewCardTypeNameInput"
          />
        </view>

        <view class="mgr-field-group" wx:if="{{newCardTypeCategory === 'count'}}">
          <text class="mgr-field-label">初始课时 (节)</text>
          <input
            class="mgr-field-input"
            type="number"
            placeholder="如：10"
            value="{{newCardTypeCount}}"
            bindinput="onNewCardTypeCountInput"
          />
        </view>

        <view class="mgr-field-group">
          <text class="mgr-field-label">有效天数 (天)</text>
          <input
            class="mgr-field-input"
            type="number"
            placeholder="如：90 或 365"
            value="{{newCardTypeDays}}"
            bindinput="onNewCardTypeDaysInput"
          />
        </view>

        <view class="mgr-field-group">
          <text class="mgr-field-label">售价参考 (元，选填)</text>
          <input
            class="mgr-field-input"
            type="digit"
            placeholder="如：1680"
            value="{{newCardTypePrice}}"
            bindinput="onNewCardTypePriceInput"
          />
        </view>

        <button
          class="mgr-primary-btn"
          bindtap="submitCreateCardType"
          loading="{{submittingCardType}}"
          disabled="{{submittingCardType}}"
        >
          确认保存卡种规则
        </button>
      </view>

      <!-- 卡种规则列表 -->
      <view wx:if="{{loadingCardTypes}}" class="mgr-inner-loading">正在同步卡种规则…</view>
      <block wx:else>
        <view wx:if="{{cardTypesList.length === 0}}" class="mgr-empty-card-sm">
          <text class="mgr-empty-text">暂无卡种配置记录</text>
        </view>
        <view wx:for="{{cardTypesList}}" wx:key="id" class="mgr-card-item">
          <view class="mgr-card-item-top">
            <view class="mgr-type-name-box">
              <text class="mgr-card-type-name">{{item.name}}</text>
              <text class="mgr-type-cat-tag">{{item.category === 'count' ? '次卡' : '期限卡'}}</text>
            </view>
            <view
              class="mgr-pill-toggle {{item.is_active ? 'is-active-btn' : 'is-inactive-btn'}}"
              catchtap="toggleCardTypeStatus"
              data-id="{{item.id}}"
              data-active="{{item.is_active}}"
              data-name="{{item.name}}"
            >
              {{item.is_active ? '使用中' : '已停用'}}
            </view>
          </view>
          <view class="mgr-card-times-row">
            <text class="mgr-times-label">额度参数：</text>
            <text class="mgr-times-val">{{item.category === 'count' ? item.total_count + ' 节' : '不限次畅练'}} · 有效期 {{item.validity_days ? item.validity_days + ' 天' : '长期'}}</text>
          </view>
          <view class="mgr-card-times-row" wx:if="{{item.price_cents > 0}}">
            <text class="mgr-times-label">指导售价：</text>
            <text class="mgr-times-val text-gold">¥{{item.price_cents / 100}}</text>
          </view>
          <view class="mgr-card-date-row" wx:if="{{item.courseCategories && item.courseCategories.length > 0}}">
            <text class="mgr-date-range">适用课种：{{item.courseCategories.join(' · ')}}</text>
          </view>
        </view>
      </block>
    </block>
  </view>


