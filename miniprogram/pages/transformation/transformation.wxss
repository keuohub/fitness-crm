/* pages/transformation/transformation.wxss
   我的蜕变 · 个人档案与体态展陈 (对标 Cartier 刻度仪与 Dior 展陈美学)
   ============================================================ */

page {
  background-color: #F6E6DA;
  color: #1A181E;
  font-family: -apple-system, "PingFang SC", "Songti SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.transformation-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 80rpx) 40rpx 0;
}

.trans-loading-box {
  padding: 200rpx 0;
  text-align: center;
}

.trans-loading-txt {
  font-size: 26rpx;
  color: #8C827B;
  letter-spacing: 0.05em;
}

/* 顶部会员档案头部 */
.trans-hero-header {
  padding-bottom: 28rpx;
}

.trans-hero-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.member-days-badge {
  padding: 6rpx 18rpx;
  background: rgba(13, 12, 15, 0.05);
  border: 1rpx solid rgba(13, 12, 15, 0.1);
  border-radius: 20rpx;
}

.days-badge-txt {
  font-size: 22rpx;
  color: #6D645D;
  font-weight: 500;
}

.member-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 20rpx;
  background: rgba(13, 12, 15, 0.06);
  border: 1rpx solid rgba(13, 12, 15, 0.12);
  border-radius: 30rpx;
}

.badge-en {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: #1A181E;
}

.badge-dot {
  font-size: 18rpx;
  color: #A0968E;
}

.badge-cn {
  font-size: 20rpx;
  color: #6D645D;
}

.member-days-counter {
  font-size: 22rpx;
  font-weight: 500;
  color: #8C827A;
  letter-spacing: 0.04em;
}

.member-name-block {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.member-name-text {
  font-family: "Songti SC", serif;
  font-size: 54rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.06em;
}

.member-stage-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #9E2A2B;
  background: rgba(158, 42, 43, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(158, 42, 43, 0.18);
}

.whisper-banner {
  margin-top: 10rpx;
  padding: 16rpx 22rpx;
  background: rgba(255, 255, 255, 0.5);
  border-left: 4rpx solid #0E0D10;
  border-radius: 0 12rpx 12rpx 0;
}

.whisper-content {
  font-size: 24rpx;
  color: #554E48;
  line-height: 1.55;
  font-style: italic;
}

/* 卡地亚风格刻度仪与四维资产矩阵 */
.caliber-horizon-card {
  margin-top: 24rpx;
  padding: 34rpx 32rpx;
  background: #0E0D10;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx -10rpx rgba(13, 12, 15, 0.35);
  display: flex;
  flex-direction: column;
}

.caliber-gauge-wrap {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.gauge-meta-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.gauge-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0.05em;
}

.gauge-value {
  font-family: "Didot", serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.gauge-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

.gauge-track {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 4rpx;
  overflow: hidden;
}

.gauge-bar {
  height: 100%;
  background: linear-gradient(90deg, #9E2A2B 0%, #D4AF37 100%);
  border-radius: 4rpx;
  box-shadow: 0 0 12rpx rgba(212, 175, 55, 0.5);
  transition: width 600ms cubic-bezier(0.2, 0.8, 0.25, 1);
}

.asset-matrix-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  padding-top: 28rpx;
}

.asset-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.asset-num {
  font-family: "Didot", "Playfair Display", serif;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.asset-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 2rpx;
}

.asset-caption {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.48);
  letter-spacing: 0.02em;
}

/* 发丝线 */
.editorial-hairline {
  height: 1rpx;
  background: rgba(140, 130, 122, 0.18);
  margin: 36rpx 0;
}

/* 模块标题与角度标签 */
.section-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-tag-group {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.section-index {
  font-family: "Didot", serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #9E2A2B;
}

.section-heading {
  font-family: "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.06em;
}

.section-en-label {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: #A39991;
  font-weight: 500;
}

.section-intro {
  font-size: 24rpx;
  color: #6E6660;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

/* 角度切换胶囊 */
.angle-tabs-pill {
  display: flex;
  background: rgba(13, 12, 15, 0.06);
  border-radius: 30rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.angle-tab-item {
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  transition: all 200ms ease;
}

.angle-tab-active {
  background: #0E0D10;
  box-shadow: 0 4rpx 12rpx rgba(14, 13, 16, 0.25);
}

.angle-tab-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #5A524C;
}

.angle-tab-active .angle-tab-text {
  color: #FFFFFF;
  font-weight: 600;
}

/* 迪奥展陈式体态双幅卡片 */
.diptych-exhibition-card {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx -8rpx rgba(13, 12, 15, 0.07);
}

.diptych-frames-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.diptych-frame {
  flex: 1;
  display: flex;
  flex-direction: column;
  transition: transform 180ms ease;
}

.diptych-frame:active {
  transform: scale(0.975);
}

.frame-tag-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.frame-fig {
  font-family: "Didot", serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #8C827B;
}

.frame-status {
  font-size: 19rpx;
  color: #8C827B;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(13, 12, 15, 0.05);
}

.frame-status.highlight {
  color: #9E2A2B;
  background: rgba(158, 42, 43, 0.08);
  font-weight: 600;
}

.frame-img-box {
  width: 100%;
  height: 380rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #EAE0D6;
  border: 1rpx solid rgba(13, 12, 15, 0.08);
}

.diptych-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.frame-date {
  font-size: 19rpx;
  color: #8C827B;
  margin-top: 10rpx;
  text-align: center;
}

.diptych-axis-divider {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 4rpx;
}

.axis-line {
  width: 2rpx;
  height: 80rpx;
  background: rgba(140, 130, 122, 0.25);
}

.axis-node {
  font-family: "Didot", serif;
  font-size: 20rpx;
  font-weight: 700;
  color: #9E2A2B;
  margin: 12rpx 0;
  letter-spacing: 0.06em;
}

/* 导师解析卡片 */
.coach-analysis-card {
  margin-top: 28rpx;
  padding: 24rpx;
  background: rgba(246, 230, 222, 0.55);
  border-radius: 18rpx;
  border-left: 4rpx solid #9E2A2B;
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.analysis-seal {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #9E2A2B;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  border-radius: 6rpx;
}

.analysis-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.04em;
}

.analysis-body {
  font-size: 24rpx;
  color: #4A433D;
  line-height: 1.65;
}

/* 生成海报唤起栏 */
.share-trigger-bar {
  margin-top: 24rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #0E0D10;
  border-radius: 42rpx;
  box-shadow: 0 8rpx 24rpx -4rpx rgba(14, 13, 16, 0.3);
  transition: transform 180ms ease;
}

.share-trigger-bar:active {
  transform: scale(0.98);
}

.share-icon {
  color: #D4AF37;
  font-size: 26rpx;
}

.share-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.08em;
}

/* 训练历程足迹 */
.timeline-stream {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-node-card {
  padding: 24rpx 26rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
}

.node-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.node-date-badge {
  display: inline-flex;
  padding: 4rpx 14rpx;
  background: rgba(13, 12, 15, 0.05);
  border-radius: 12rpx;
}

.node-date {
  font-size: 20rpx;
  font-weight: 500;
  color: #6C645E;
}

.node-duration {
  font-size: 20rpx;
  color: #9C9188;
}

.node-course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.node-course-name {
  font-family: "Songti SC", serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #0E0D10;
  letter-spacing: 0.04em;
}

.node-coach-name {
  font-size: 20rpx;
  font-weight: 500;
  color: #9E2A2B;
}

.node-feedback {
  font-size: 23rpx;
  color: #554E48;
  line-height: 1.55;
  font-style: italic;
}

/* 身体便签 */
.feeling-chips-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.feeling-chip {
  padding: 10rpx 22rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(140, 130, 122, 0.2);
  border-radius: 30rpx;
  transition: all 180ms ease;
}

.feeling-chip.chip-active {
  background: #0E0D10;
  border-color: #0E0D10;
}

.chip-text {
  font-size: 22rpx;
  color: #554E48;
  font-weight: 500;
}

.feeling-chip.chip-active .chip-text {
  color: #FFFFFF;
}

.feeling-input-wrap {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.feeling-textarea {
  width: 100%;
  box-sizing: border-box;
  height: 180rpx;
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #1A181E;
  line-height: 1.6;
}

.feeling-placeholder {
  color: #A39991;
  font-size: 23rpx;
}

.feeling-submit-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0E0D10;
  border-radius: 42rpx;
  box-shadow: 0 8rpx 24rpx -4rpx rgba(14, 13, 16, 0.3);
  transition: transform 180ms ease;
}

.feeling-submit-btn:active {
  transform: scale(0.98);
}

.submit-btn-txt {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.08em;
}

.coach-reply-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background: rgba(246, 230, 222, 0.55);
  border-left: 4rpx solid #9E2A2B;
  border-radius: 0 18rpx 18rpx 0;
}

.reply-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.reply-seal {
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  background: #9E2A2B;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  border-radius: 6rpx;
}

.reply-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #0E0D10;
}

.reply-content {
  font-size: 23rpx;
  color: #4A433D;
  line-height: 1.65;
}

/* 底部防遮挡垫片 */
.dock-spacer {
  height: calc(env(safe-area-inset-bottom) + 210rpx);
}
