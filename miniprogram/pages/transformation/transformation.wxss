/* pages/transformation/transformation.wxss
   成长板块 · lululemon 规范
   直角体态照 · #efeae2 底块 · 无序号装饰
   ============================================================ */

page {
  background-color: #f3efe8;
  color: #000000;
  font-family: var(--font-sans);
  min-height: 100vh;
  box-sizing: border-box;
}

.tf-page {
  padding: 0 40rpx;
  box-sizing: border-box;
}

.tf-loading,
.tf-error {
  padding: 80rpx 0;
  text-align: center;
}

.tf-loading-text {
  font-size: 26rpx;
  color: #54555b;
}

.tf-error-text {
  font-size: 26rpx;
  color: #54555b;
}

/* 顶部 */
.tf-hero {
  padding-bottom: 32rpx;
}

.tf-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tf-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
}

.tf-honorific {
  font-size: 28rpx;
  color: #54555b;
}

.tf-days {
  font-size: 26rpx;
  color: #54555b;
}

/* 核心数字 */
.tf-total-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.tf-total-label {
  font-size: 24rpx;
  color: #54555b;
  display: block;
  margin-bottom: 8rpx;
}

.tf-total-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.tf-total-num {
  font-family: var(--font-num);
  font-size: 72rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1;
}

.tf-total-unit {
  font-size: 28rpx;
  color: #000000;
}

.tf-total-note {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

/* 四类课 */
.tf-course-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.tf-course-card {
  padding: 24rpx;
  box-sizing: border-box;
}

.tf-course-name {
  font-size: 26rpx;
  color: #54555b;
  display: block;
  margin-bottom: 8rpx;
}

.tf-course-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.tf-course-num {
  font-family: var(--font-num);
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
}

.tf-course-unit {
  font-size: 24rpx;
  color: #000000;
}

/* 区块通用 */
.tf-section {
  margin-bottom: 56rpx;
}

.tf-section-head {
  margin-bottom: 20rpx;
}

/* 角度切换 Tab */
.tf-angle-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tf-angle-tab {
  font-size: 24rpx;
  color: #54555b;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #efeae2;
}

.tf-angle-tab-active {
  color: #ffffff;
  background: #000000;
  font-weight: 500;
}

/* 体态对比卡片：直角、并排、标签黑底白字小胶囊 */
.tf-compare-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.tf-compare-row {
  display: flex;
  gap: 16rpx;
}

.tf-compare-pane {
  flex: 1;
  position: relative;
  overflow: hidden;
  height: calc((100vw - 112rpx) / 2 * 4 / 3);
  background: #ffffff;
}

.tf-compare-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 0;
}

.tf-compare-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 2;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  height: 36rpx;
}

.tf-compare-date {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.45);
  padding: 4rpx 10rpx;
  z-index: 2;
  text-align: center;
}

.tf-compare-analysis {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #000000;
}

.tf-empty-compare-text {
  font-size: 24rpx;
  color: #54555b;
  line-height: 1.6;
  display: block;
}

/* 小桥的记录 */
.tf-notes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tf-note-card {
  padding: 24rpx;
  box-sizing: border-box;
}

.tf-note-date {
  font-size: 22rpx;
  color: #999999;
  font-family: var(--font-num);
  display: block;
  margin-bottom: 8rpx;
}

.tf-note-content {
  font-size: 26rpx;
  color: #000000;
  line-height: 1.6;
  display: block;
  margin-bottom: 8rpx;
}

.tf-note-tags {
  font-size: 22rpx;
  color: #54555b;
  display: block;
}

.tf-empty {
  padding: 48rpx 24rpx;
}

.tf-empty-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
  margin-bottom: 8rpx;
}

.tf-empty-body {
  font-size: 24rpx;
  color: #54555b;
  line-height: 1.5;
}

/* 跟小桥说句话 */
.tf-reply-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.tf-reply-label {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-bottom: 8rpx;
}

.tf-reply-text {
  font-size: 26rpx;
  color: #000000;
  line-height: 1.6;
  display: block;
}

.tf-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tf-textarea {
  width: 100%;
  height: 180rpx;
  padding: 20rpx;
  border: 1px solid #ece7df;
  border-radius: 4rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  background: #ffffff;
}

.tf-placeholder {
  color: #999999;
}

.tf-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}

.tf-receipt {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #54555b;
  line-height: 1.5;
  text-align: center;
}

.tf-bottom-space {
  height: calc(104rpx + 16rpx + env(safe-area-inset-bottom) + 40rpx);
}
