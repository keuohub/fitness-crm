# 徕舞独立测试环境配置模板（.env.test）
# 复制本文件为 .env.test 并填入您在 Neon 控制台创建的独立测试 Branch 连接串。
# 注意：.env.test 已被 .gitignore 忽略，绝不会被提交到 Git 仓库。

# 1. 独立测试数据库连接串（必须是独立的测试 Branch 或独立实例，严禁指向生产库）
# 示例：postgresql://neondb_owner:***@ep-test-isolated-xxxx.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
TEST_DATABASE_URL=

# 2. 测试环境人工确认开关（必须显式设为 1，表明已人工核验上述连接串为测试库）
TEST_DB_CONFIRMED=1

# 3. 测试端口与配置
TEST_PORT=3002
